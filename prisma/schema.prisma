  scope           String   @default("CLUB")
  source          String
  domain          String // MEMBERS | VENDORS | COA | OPENING_TRIAL_BALANCE | ...
  key             String // e.g. "jonas.members.v1"
  name            String
  description     String?
  version         Int      @default(1)
  status          String   @default("DRAFT")
  isDefault       Boolean  @default(false)
  // mapping is the canonical column → destination field map; transforms is
  // a free-form JSON of column-name normalizations (trim, uppercase, etc.).
  mappingJson     String   @default("{}")
  requiredColumns String   @default("[]") // JSON array
  transformsJson  String   @default("{}")
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

