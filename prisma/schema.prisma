}

// -------------------------------------------------------------------------
// 6G. Workflow engine (sits alongside the AP ApprovalPolicy engine, with a
// broader DAG-style model for multi-step governance flows)
// -------------------------------------------------------------------------
// status: DRAFT | ACTIVE | COMPLETED | CANCELLED
model Workflow {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  key             String // template key
  name            String
  description     String?
  entityType      String? // optional FK-style pointer to the subject entity
  entityId        String?
  status          String    @default("DRAFT")
  currentStepId   String?
  createdByUserId String?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  steps       WorkflowStep[]
  assignments WorkflowAssignment[]
  approvals   WorkflowApproval[]
  comments    WorkflowComment[]
  history     WorkflowHistory[]

  @@index([clubId, entityType, entityId])
  @@index([clubId, status])
}

// kind: APPROVAL | ASSIGNMENT | NOTIFICATION | TASK
// status: PENDING | IN_PROGRESS | COMPLETED | SKIPPED | FAILED
model WorkflowStep {
  id                String    @id @default(cuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id])
  workflowId        String
  workflow          Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  key               String
  name              String
  sortOrder         Int       @default(0)
  kind              String    @default("APPROVAL")
  status            String    @default("PENDING")
  requiredApprovals Int       @default(1)
  approverRoleKey   String?
  approverUserId    String?
  dueAt             DateTime?
  startedAt         DateTime?
  completedAt       DateTime?

  assignments WorkflowAssignment[]
  approvals   WorkflowApproval[]

  @@index([workflowId, sortOrder])
}

// status: PENDING | ACCEPTED | COMPLETED | REASSIGNED
model WorkflowAssignment {
  id              String        @id @default(cuid())
  clubId          String
  club            Club          @relation(fields: [clubId], references: [id])
  workflowId      String
  workflow        Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepId          String?
  step            WorkflowStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)
  assigneeUserId  String?
  assigneeRoleKey String?
  status          String        @default("PENDING")
  dueAt           DateTime?
  acceptedAt      DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([workflowId, status])
}

// decision: APPROVE | REJECT | ABSTAIN
model WorkflowApproval {
  id              String        @id @default(cuid())
  clubId          String
  club            Club          @relation(fields: [clubId], references: [id])
  workflowId      String
  workflow        Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepId          String?
  step            WorkflowStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)
  approverUserId  String
  approverRoleKey String?
  decision        String
  decidedAt       DateTime      @default(now())
  notes           String?

  @@index([workflowId, stepId])
}

model WorkflowComment {
  id           String   @id @default(cuid())
  clubId       String
  club         Club     @relation(fields: [clubId], references: [id])
  workflowId   String
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  authorUserId String?
  body         String
  createdAt    DateTime @default(now())

  @@index([workflowId, createdAt])
}

// action: CREATE | START | STEP_COMPLETE | APPROVE | REJECT | REASSIGN | CANCEL | COMPLETE
model WorkflowHistory {
  id         String   @id @default(cuid())
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id])
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  action     String
  byUserId   String?
  metaJson   String?
  occurredAt DateTime @default(now())

  @@index([workflowId, occurredAt])
}

// -------------------------------------------------------------------------
// 6J. Club settings (granular, key/value, audited)
// -------------------------------------------------------------------------
// Replaces ad-hoc Club table columns for everything that's a "setting" rather
// than identity. Identity (name, slug, region) stays on Club.
model ClubSetting {
  id              String   @id @default(cuid())
  clubId          String
  club            Club     @relation(fields: [clubId], references: [id])
  scope           String // "billing" | "membership" | "documents" | "notifications" | "approval_thresholds" | ...
  key             String
  valueJson       String
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  @@unique([clubId, scope, key])
  @@index([clubId, scope])
}

// -------------------------------------------------------------------------
// 6K. Cross-module insights (rule-engine seam)
// -------------------------------------------------------------------------
// kind: FINANCIAL | OPERATIONAL | MEMBERSHIP | RISK
// severity: INFO | WATCH | WARN | CRITICAL
// status:   OPEN | ACKNOWLEDGED | RESOLVED | DISMISSED
model Insight {
  id                   String       @id @default(cuid())
  clubId               String
  club                 Club         @relation(fields: [clubId], references: [id])
  ruleId               String?
  rule                 InsightRule? @relation(fields: [ruleId], references: [id])
  kind                 String
  severity             String       @default("INFO")
  title                String
  body                 String
  entityType           String?
  entityId             String?
  metaJson             String?
  status               String       @default("OPEN")
  raisedAt             DateTime     @default(now())
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  resolvedAt           DateTime?

  @@index([clubId, status, raisedAt])
  @@index([clubId, kind, severity])
}

model InsightRule {
  id             String   @id @default(cuid())
  clubId         String
  club           Club     @relation(fields: [clubId], references: [id])
  key            String
  name           String
  description    String?
  kind           String
  severity       String   @default("INFO")
  isActive       Boolean  @default(true)
  parametersJson String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  insights Insight[]
  alerts   InsightAlert[]

  @@unique([clubId, key])
  @@index([clubId, isActive])
}

model InsightAlert {
  id            String       @id @default(cuid())
  clubId        String
  club          Club         @relation(fields: [clubId], references: [id])
  ruleId        String?
  rule          InsightRule? @relation(fields: [ruleId], references: [id])
  channel       String       @default("IN_APP")
  notifyRoleKey String?
  notifyUserId  String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@index([clubId, ruleId])
}

// -------------------------------------------------------------------------
// 6I. Search index (denormalized, permission-aware)
// -------------------------------------------------------------------------
model SearchIndexEntry {
  id            String   @id @default(cuid())
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id])
  entityType    String // MEMBER | VENDOR | INVOICE | JOURNAL_ENTRY | REPORT | EVENT | ASSET | INVENTORY | EMPLOYEE | DOCUMENT | PACKAGE
  entityId      String
  title         String
  subtitle      String?
  body          String?
  url           String
  permissionKey String? // permission required to see this entry
  metaJson      String?
  updatedAt     DateTime @updatedAt

  @@unique([clubId, entityType, entityId])
  @@index([clubId, entityType])
  @@index([clubId, title])
}

// =========================================================================
// Phase 7 — Integrations, POS, LLM commentary
// =========================================================================

// -------------------------------------------------------------------------
// 7B-7C-7H. Integration settings (keyed per club).
// scope: EMAIL | SMS | STORAGE | LLM | POS | EXPORT
// Secrets are stored as JSON; the application must never log them.
// -------------------------------------------------------------------------
model IntegrationSetting {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  scope           String
  provider        String // e.g. "ses" | "twilio" | "s3" | "anthropic" | "openai" | "square"
  isActive        Boolean   @default(true)
  configJson      String // non-secret config (region, sender from, bucket name, model name)
  secretsJson     String? // secret material (will not be returned in API responses)
  lastTestedAt    DateTime?
  lastTestStatus  String? // OK | FAIL
  lastTestError   String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  checks IntegrationCheck[]

  @@unique([clubId, scope, provider])
  @@index([clubId, scope])
}

// status: OK | FAIL | SKIPPED
model IntegrationCheck {
  id              String              @id @default(cuid())
  clubId          String
  club            Club                @relation(fields: [clubId], references: [id])
  settingId       String?
  setting         IntegrationSetting? @relation(fields: [settingId], references: [id])
  scope           String
  provider        String
  status          String
  message         String?
  durationMs      Int                 @default(0)
  checkedAt       DateTime            @default(now())
  checkedByUserId String?

  @@index([clubId, scope, checkedAt])
}

// -------------------------------------------------------------------------
// 7D. Document backfill tracking.
// status: DRY_RUN | RUNNING | COMPLETED | FAILED
// -------------------------------------------------------------------------
model DocumentBackfillBatch {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  sourceTable     String
  dryRun          Boolean   @default(true)
  totalCandidates Int       @default(0)
  totalCreated    Int       @default(0)
  totalSkipped    Int       @default(0)
  totalFailed     Int       @default(0)
  status          String    @default("DRY_RUN")
  errorMessage    String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  startedByUserId String?
  reportJson      String? // detailed per-row summary (capped)

  @@index([clubId, sourceTable, startedAt])
}

// -------------------------------------------------------------------------
// 7E. POS module foundation.
// -------------------------------------------------------------------------
model POSLocation {
  id           String      @id @default(cuid())
  clubId       String
  club         Club        @relation(fields: [clubId], references: [id])
  code         String
  name         String
  departmentId String?
  department   Department? @relation("POSLocationDepartment", fields: [departmentId], references: [id])
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  terminals      POSTerminal[]
  sales          POSSale[]
  sessions       POSSession[]
  menuCategories POSMenuCategory[] @relation("POSMenuCategoryLocation")
  checks         POSCheck[]        @relation("POSCheckLocation")

  @@unique([clubId, code])
}

// status: ACTIVE | DISABLED
model POSTerminal {
  id                String                  @id @default(cuid())
  clubId            String
  club              Club                    @relation(fields: [clubId], references: [id])
  locationId        String
  location          POSLocation             @relation(fields: [locationId], references: [id])
  code              String
  name              String
  providerId        String?
  provider          POSIntegrationProvider? @relation(fields: [providerId], references: [id])
  externalReference String?
  status            String                  @default("ACTIVE")
  createdAt         DateTime                @default(now())

  sales    POSSale[]
  sessions POSSession[]
  checks   POSCheck[]   @relation("POSCheckTerminal")

  @@unique([clubId, code])
}

// status: OPEN | CLOSED | RECONCILED
model POSSession {
  id             String       @id @default(cuid())
  clubId         String
  club           Club         @relation(fields: [clubId], references: [id])
  locationId     String
  location       POSLocation  @relation(fields: [locationId], references: [id])
  terminalId     String?
  terminal       POSTerminal? @relation(fields: [terminalId], references: [id])
  openedByUserId String?
  closedByUserId String?
  openedAt       DateTime     @default(now())
  closedAt       DateTime?
  openingFloat   Decimal      @default(0)
  closingFloat   Decimal      @default(0)
  status         String       @default("OPEN")

  sales  POSSale[]
  checks POSCheck[] @relation("POSCheckSession")

  @@index([clubId, status])
}

// status: DRAFT | COMPLETED | VOIDED | REFUNDED
// chargeMode: CASH | CARD | MEMBER_ACCOUNT | GIFT_CARD | OTHER
model POSSale {
  id                   String                  @id @default(cuid())
  clubId               String
  club                 Club                    @relation(fields: [clubId], references: [id])
  saleNumber           String
  locationId           String
  location             POSLocation             @relation(fields: [locationId], references: [id])
  terminalId           String?
  terminal             POSTerminal?            @relation(fields: [terminalId], references: [id])
  sessionId            String?
  session              POSSession?             @relation(fields: [sessionId], references: [id])
  memberId             String?
  member               Member?                 @relation("POSSaleMember", fields: [memberId], references: [id])
  guestName            String?
  departmentId         String?
  department           Department?             @relation("POSSaleDepartment", fields: [departmentId], references: [id])
  chargeMode           String                  @default("MEMBER_ACCOUNT")
  // STAY = dining in (default), TO_GO = takeaway. Kitchens and bars
  // need this on the prep chit so the food is plated for the right
  // service: ceramic plate + cutlery for stay; container + lid + cutlery
  // bag for to-go.
  diningMode           String                  @default("STAY")
  subtotal             Decimal                 @default(0)
  taxTotal             Decimal                 @default(0)
  discountTotal        Decimal                 @default(0)
  gratuityTotal        Decimal                 @default(0)
  grandTotal           Decimal                 @default(0)
  status               String                  @default("DRAFT")
  saleDate             DateTime                @default(now())
  providerId           String?
  provider             POSIntegrationProvider? @relation(fields: [providerId], references: [id])
  externalReference    String?
  arChargeId           String?                 @unique
  arCharge             Charge?                 @relation("POSSaleARCharge", fields: [arChargeId], references: [id])
  postedJournalEntryId String?
  postedJournalEntry   JournalEntry?           @relation("POSSaleJE", fields: [postedJournalEntryId], references: [id])
  refundOfSaleId       String?                 @unique
  refundOfSale         POSSale?                @relation("POSSaleRefund", fields: [refundOfSaleId], references: [id])
  refund               POSSale?                @relation("POSSaleRefund")
  notes                String?
  createdByUserId      String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  lines                        POSSaleLine[]
  payments                     POSPayment[]
  taxLines                     POSTaxLine[]
  discounts                    POSDiscount[]
  // Inverse of POSCheck.posSale. A settled check links here; a sale
  // that didn't come from the new check workflow (e.g. legacy
  // ringUpLoungeSale, pro-shop quick sale) leaves this null.
  fromCheck                    POSCheck?                     @relation("POSCheckSale")
  // PDF receipt snapshot generated at settlement. One row per chit
  // type (SIGNATURE / KITCHEN / BAR / DESSERT) so the GL audit trail
  // carries the exact receipt the JE corresponds to. SIGNATURE is the
  // member-facing receipt; the others are operational snapshots that
  // can be re-rendered on demand.
  chits                        POSSaleChit[]
  // Phase 18B
  hospitalitySurveyInvitations HospitalitySurveyInvitation[] @relation("HospitalitySurveyInvitationSale")
  hospitalitySurveyResponses   HospitalitySurveyResponse[]   @relation("HospitalitySurveyResponseSale")
  // Phase 18C
  reservationLinks             DiningReservationCheckLink[]  @relation("DiningReservationCheckLinkSale")
  // Phase 18E — sale produced by a seat-group settlement.
  settlementGroup              POSSettlementGroup?           @relation("POSSettlementGroupSale")
  // Step 19 — QR-payment row whose confirmation produced this sale.
  qrPayment                    POSQRPayment?                 @relation("POSQRPaymentSale")

  @@unique([clubId, saleNumber])
  @@unique([clubId, providerId, externalReference])
  @@index([clubId, status])
  @@index([clubId, saleDate])
  @@index([memberId])
}

// kind: INVENTORY | SERVICE | LESSON | EVENT | FEE | OTHER
model POSSaleLine {
  id                     String         @id @default(cuid())
  clubId                 String
  club                   Club           @relation(fields: [clubId], references: [id])
  saleId                 String
  sale                   POSSale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  kind                   String         @default("OTHER")
  itemId                 String?
  item                   InventoryItem? @relation("POSSaleLineItem", fields: [itemId], references: [id])
  // POSMenuItem this line came from, when the sale was rung up through
  // a menu-driven surface (e.g. the lounge). Lets us route chits to
  // the kitchen vs. bar by traversing `menuItem.category.chitDestination`,
  // and lets reports like "most-ordered items" join through this link.
  // Null for sales created from inventory SKUs, free-text descriptions,
  // or imported sales from external POS providers.
  menuItemId             String?
  menuItem               POSMenuItem?   @relation("POSSaleLineMenuItem", fields: [menuItemId], references: [id])
  description            String
  quantity               Decimal        @default(1)
  unitPrice              Decimal        @default(0)
  unitCost               Decimal        @default(0)
  lineSubtotal           Decimal        @default(0)
  taxAmount              Decimal        @default(0)
  discountAmount         Decimal        @default(0)
  lineTotal              Decimal        @default(0)
  revenueAccountId       String?
  revenueAccount         Account?       @relation("POSSaleLineRevenue", fields: [revenueAccountId], references: [id])
  inventoryTransactionId String?

  // Applied modifiers (no onions, add bacon, …) snapshotted from the
  // check line at settlement so the dining receipt + audit retain
  // exactly what was ordered, even if the master option list changes
  // later.
  modifiers POSSaleLineModifier[]

  @@index([saleId])
}

// kind: TAX | TIP | FEE
model POSTaxLine {
  id         String  @id @default(cuid())
  clubId     String
  club       Club    @relation(fields: [clubId], references: [id])
  saleId     String
  sale       POSSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  kind       String  @default("TAX")
  label      String
  rate       Decimal @default(0)
  amount     Decimal @default(0)
  taxCodeKey String?

  @@index([saleId])
}

// kind: PERCENT | AMOUNT | COMP
model POSDiscount {
  id     String  @id @default(cuid())
  clubId String
  club   Club    @relation(fields: [clubId], references: [id])
  saleId String
  sale   POSSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  kind   String  @default("AMOUNT")
  label  String
  value  Decimal @default(0)
  amount Decimal @default(0)
  notes  String?

  @@index([saleId])
}

// -------------------------------------------------------------------------
// Menu catalog for sit-down POS surfaces (lounge, dining room).
// Independent of `InventoryItem` because menu items are consumables
// (food/drink) — they're not tracked stock and don't deplete on sale.
// `POSSaleLine.kind = "SERVICE"` is the line kind used when a sale
// references one of these.
// -------------------------------------------------------------------------
model POSMenuCategory {
  id              String       @id @default(cuid())
  clubId          String
  club            Club         @relation(fields: [clubId], references: [id])
  // Optional location-scoping: a category can be specific to one POS
  // location (e.g. lounge-only desserts) or shared across all (null).
  locationId      String?
  location        POSLocation? @relation("POSMenuCategoryLocation", fields: [locationId], references: [id])
  name            String
  sortOrder       Int          @default(0)
  isActive        Boolean      @default(true)
  // Where the prep ticket for items in this category needs to be sent.
  // KITCHEN = food prep (mains, desserts, kids menu); BAR = drinks
  // (cocktails, beer, coffee, after-dinner drinks). The lounge POS
  // splits each chit on completion and prints one ticket per
  // destination. Members always also receive a SIGNATURE chit
  // regardless of destination mix.
  chitDestination String       @default("KITCHEN")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items POSMenuItem[]

  @@unique([clubId, locationId, name])
  @@index([clubId, locationId, isActive, sortOrder])
}

model POSMenuItem {
  id          String          @id @default(cuid())
  clubId      String
  club        Club            @relation(fields: [clubId], references: [id])
  categoryId  String
  category    POSMenuCategory @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  // Stored as Decimal so cart math stays exact — no float drift.
  price       Decimal         @default(0)
  taxable     Boolean         @default(true)
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  saleLines      POSSaleLine[]      @relation("POSSaleLineMenuItem")
  checkLines     POSCheckLine[]     @relation("POSCheckLineMenuItem")
  // Modifier groups attached to this menu item (e.g. "Burger
  // removes", "Burger adds"). Groups dictate which options the
  // server sees in the modifier panel for this item.
  modifierGroups POSModifierGroup[] @relation("POSModifierGroupMenuItem")

  @@unique([clubId, categoryId, name])
  @@index([clubId, categoryId, isActive, sortOrder])
}

// -------------------------------------------------------------------------
// Menu modifiers.
//
// A POSModifierGroup belongs to a single menu item and bundles a set
// of options the server can apply when ringing up that item. Three
// flavours of group cover the realistic operating cases:
//   • REMOVE      — subtractions ("no onions", "no ice")
//   • ADD         — paid extras  ("add bacon", "extra cheese")
//   • SUBSTITUTE  — swap one default for another ("fries → salad")
//
// Allergy notes and free-text notes don't need a master catalog and
// are stored only on the check line modifier rows themselves.
// -------------------------------------------------------------------------
// modifierType: REMOVE | ADD | SUBSTITUTE
model POSModifierGroup {
  id           String      @id @default(cuid())
  clubId       String
  club         Club        @relation(fields: [clubId], references: [id])
  menuItemId   String
  menuItem     POSMenuItem @relation("POSModifierGroupMenuItem", fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierType String
  label        String
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  options POSModifierOption[]

  @@unique([clubId, menuItemId, label])
  @@index([clubId, menuItemId, isActive, sortOrder])
}

model POSModifierOption {
  id         String           @id @default(cuid())
  clubId     String
  club       Club             @relation(fields: [clubId], references: [id])
  groupId    String
  group      POSModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label      String // "No onions" / "Add bacon" / "Fries → salad"
  // Optional shorter form printed on the chit. Falls back to label.
  printLabel String?
  // 0 for free removals; positive for paid additions; negative
  // (rare) when a substitute is cheaper than the default.
  priceDelta Decimal          @default(0)
  sortOrder  Int              @default(0)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([clubId, groupId, isActive, sortOrder])
}

// Modifier applied to a draft / active POSCheckLine. The label /
// priceDelta are snapshotted off the source option so a later edit
// to the master option list doesn't reprice an open check.
// modifierType: REMOVE | ADD | SUBSTITUTE | ALLERGY | NOTE
model POSCheckLineModifier {
  id           String       @id @default(cuid())
  clubId       String
  club         Club         @relation(fields: [clubId], references: [id])
  checkLineId  String
  checkLine    POSCheckLine @relation(fields: [checkLineId], references: [id], onDelete: Cascade)
  // Source option — null for free-text notes and allergy notes.
  optionId     String?
  modifierType String
  label        String
  printLabel   String?
  priceDelta   Decimal      @default(0)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())

  @@index([clubId, checkLineId])
}

// -------------------------------------------------------------------------
// Printer registry — admin-managed list of named printers the lounge
// can route chits to. The current `getChitTransport()` dispatcher
// returns PDF regardless (browser print dialog still routes to the
// OS-selected printer), but the registry powers the "Print to:"
// picker so the operator can flag a configured target. Defaults to
// PDF on first run; admin registers physical printers as they're
// wired up.
// -------------------------------------------------------------------------
// role:    ANY | KITCHEN | BAR | SIGNATURE | RECEIPT
// kind:    PDF | NETWORK | USB | RECEIPT_PRINTER  (informational —
//          a future driver layer would dispatch based on this)
model POSPrinter {
  id         String   @id @default(cuid())
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id])
  name       String
  role       String   @default("ANY")
  kind       String   @default("PDF")
  // Free-text location ("Kitchen counter", "Hostess stand") so the
  // operator can tell two printers with similar names apart.
  location   String?
  // Optional driver / address hint for future integration (e.g.
  // `ipp://192.168.1.50/ipp/print` or a Windows printer share name).
  driverHint String?
  // True when this printer should be pre-selected on its role's
  // print dropdown. Unique per (club, role) — see seed/service.
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([clubId, name])
  @@index([clubId, role, isActive])
}

// -------------------------------------------------------------------------
// PDF receipt snapshotted at settlement.
//
// Every settled POSSale gets a frozen PDF chit row here so the audit
// trail carries the exact receipt the GL journal entry corresponds
// to — regardless of whether the customer paid by phone (QR_PAY) or
// it was charged to their member account. Auditors can always
// retrieve the chit for a given JE by walking
//   JournalEntry → POSSale.postedJournalEntryId
//        → POSSale → POSSaleChit (where type = "SIGNATURE")
// without depending on the chit being re-rendered from current data.
//
// type: SIGNATURE | KITCHEN | BAR | DESSERT
// The SIGNATURE chit is the member-facing receipt. Kitchen/bar chits
// are operational and can be regenerated on demand, but we snapshot
// SIGNATURE at settlement so it can't drift.
model POSSaleChit {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id])
  saleId    String
  sale      POSSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  type      String
  // Raw PDF bytes. Stored in the DB for simplicity; production
  // deployments would offload to S3 (replace `pdfBytes` with
  // `storageKey String`).
  pdfBytes  Bytes
  byteSize  Int
  createdAt DateTime @default(now())

  @@unique([saleId, type])
  @@index([clubId, createdAt])
}

// Modifier snapshotted onto a settled POSSaleLine. Immutable —
// preserves the original order detail on the dining receipt and in
// the audit trail.
model POSSaleLineModifier {
  id           String      @id @default(cuid())
  clubId       String
  club         Club        @relation(fields: [clubId], references: [id])
  saleLineId   String
  saleLine     POSSaleLine @relation(fields: [saleLineId], references: [id], onDelete: Cascade)
  modifierType String
  label        String
  printLabel   String?
  priceDelta   Decimal     @default(0)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())

  @@index([clubId, saleLineId])
}

// method: CASH | CARD | MEMBER_ACCOUNT | GIFT_CARD | QR_PAY | OTHER
// status: AUTHORIZED | CAPTURED | VOIDED | REFUNDED
// External lifecycle states for QR Pay payments:
//   CREATED  — payment row written, QR not yet rendered
//   PENDING  — QR shown, member hasn't paid
//   CONFIRMED — gateway reported success; settlement may post
//   DECLINED — gateway reported failure
//   EXPIRED  — QR window timed out without payment
//   CANCELLED — operator cancelled before payment
// MEMBER_ACCOUNT payments stay at status="CAPTURED" with no
// external lifecycle (the lifecycle is implicit in the AR posting).
model POSPayment {
  id                    String    @id @default(cuid())
  clubId                String
  club                  Club      @relation(fields: [clubId], references: [id])
  saleId                String
  sale                  POSSale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method                String
  amount                Decimal
  tipAmount             Decimal   @default(0)
  status                String    @default("CAPTURED")
  externalReference     String?
  processorToken        String? // tokenized reference; never store PAN
  // QR Pay lifecycle. Null on member-account payments.
  externalPaymentStatus String?
  confirmedAt           DateTime?
  failedAt              DateTime?
  failureReason         String?
  capturedAt            DateTime  @default(now())

  @@index([saleId])
  @@index([clubId, externalPaymentStatus])
}

// -------------------------------------------------------------------------
// Open-check workflow.
//
// A POSCheck is the operational record of an in-progress order. The
// server opens a check, adds POSCheckLines, sends DRAFT lines as
// POSChits to KITCHEN / BAR (transitioning those lines to SENT), and
// eventually SETTLES the check — which delegates to the existing
// `createSale + completeSale` engine to produce the financial POSSale,
// AR Charge, and GL JournalEntry. Until settlement, NOTHING financial
// is posted; sending chits is purely a prep-station operation.
//
// status: OPEN | PARTIALLY_SENT | SENT | READY | PARTIALLY_SETTLED |
//         PAYMENT_PENDING | PAYMENT_FAILED | CLOSED | VOIDED
//
// PAYMENT_PENDING is used while a QR Pay check is awaiting the
// gateway confirmation. PAYMENT_FAILED is the resolved-but-failed
// state (declined / expired) that the server can retry; the check
// stays in the active list so it can't be lost.
model POSCheck {
  id                  String       @id @default(cuid())
  clubId              String
  club                Club         @relation(fields: [clubId], references: [id])
  locationId          String
  location            POSLocation  @relation("POSCheckLocation", fields: [locationId], references: [id])
  terminalId          String?
  terminal            POSTerminal? @relation("POSCheckTerminal", fields: [terminalId], references: [id])
  sessionId           String?
  session             POSSession?  @relation("POSCheckSession", fields: [sessionId], references: [id])
  memberId            String?
  member              Member?      @relation("POSCheckMember", fields: [memberId], references: [id])
  guestName           String?
  tableNumber         String?
  // Server (Spectre user) who opened the check. May differ from the
  // user who eventually settles it.
  openedByUserId      String?
  checkNumber         String
  status              String       @default("OPEN")
  // Dining context (STAY / TO_GO) — drives kitchen/bar plating.
  diningMode          String       @default("STAY")
  // Running cart-level discount %. Applied to line subtotals at
  // settlement (chit overrides line discounts unless line is a Comp).
  chitDiscountPct     Decimal      @default(0)
  // Auto-pace between courses. When set, chits for course N>1 are
  // created with a fireAt of (sendTime + (N-1) * gapMinutes) and the
  // kitchen page auto-promotes them when their time arrives. Null
  // means courses fire manually via fireNextCourse.
  autoFireGapMinutes  Int?
  // Operational notes the server adds to the whole check (table
  // location, allergies, etc.). Not the same as line-level modifiers.
  notes               String?
  // Settlement linkage. Set when the check is closed to a payment
  // method; the POSSale carries the financial detail.
  settledAt           DateTime?
  settledByUserId     String?
  closedAt            DateTime?
  // MEMBER_ACCOUNT | QR_PAY — recorded at settlement so the history
  // page can filter without re-deriving from POSSale.chargeMode.
  settlementMethod    String?
  // Receipt email lifecycle:
  //   SENT | FAILED | SUPPRESSED | SKIPPED_NO_EMAIL | PENDING
  receiptEmailStatus  String?
  receiptEmailAddress String?
  receiptEmailedAt    DateTime?
  receiptEmailFailure String?
  posSaleId           String?      @unique
  posSale             POSSale?     @relation("POSCheckSale", fields: [posSaleId], references: [id])
  // Void linkage. A check can be voided BEFORE settlement; after
  // settlement only the POSSale can be refunded.
  voidedAt            DateTime?
  voidedByUserId      String?
  voidedReason        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  lines                        POSCheckLine[]
  chits                        POSChit[]
  events                       POSCheckEvent[]
  // Phase 18B
  hospitalitySurveyInvitations HospitalitySurveyInvitation[] @relation("HospitalitySurveyInvitationCheck")
  hospitalitySurveyResponses   HospitalitySurveyResponse[]   @relation("HospitalitySurveyResponseCheck")
  // Phase 18C — when a host opens a check from a seated reservation,
  // the reservation id is stamped here so settlement can update the
  // reservation's linked spend without a second join hop.
  reservationId                String?
  reservation                  DiningReservation?            @relation("POSCheckReservation", fields: [reservationId], references: [id])
  reservationLinks             DiningReservationCheckLink[]  @relation("DiningReservationCheckLinkCheck")
  // Phase 18E — server-led self-seating.
  // The waiter clicks a table on the floor map; tableId points back to
  // the DiningTable. partySize is the size the waiter recorded at
  // seating. `serverId` mirrors openedByUserId for the report layer.
  tableId                      String?
  table                        DiningTable?                  @relation("POSCheckTable", fields: [tableId], references: [id])
  partySize                    Int?
  serverId                     String?
  settlementGroups             POSSettlementGroup[]
  // Phase 18F — per-seat member / guest assignments.
  seats                        POSCheckSeat[]                @relation("POSCheckSeats")
  // Step 19 — QR-code payment lifecycle.
  qrPayments                   POSQRPayment[]                @relation("POSQRPaymentCheck")

  @@unique([clubId, checkNumber])
  @@index([clubId, status, openedByUserId])
  @@index([clubId, memberId])
  @@index([clubId, locationId, status])
}

// status: DRAFT | SENT | FIRED | PREPARING | READY | SERVED |
//         VOIDED | COMPED
model POSCheckLine {
  id                String              @id @default(cuid())
  clubId            String
  club              Club                @relation(fields: [clubId], references: [id])
  checkId           String
  check             POSCheck            @relation(fields: [checkId], references: [id], onDelete: Cascade)
  // The menu item that drove this line. Kept as a soft link (nullable)
  // so the line survives a menu item being deactivated; line carries
  // its own snapshot of name/price/note.
  menuItemId        String?
  menuItem          POSMenuItem?        @relation("POSCheckLineMenuItem", fields: [menuItemId], references: [id])
  // Snapshot fields — frozen when the line is added so a later menu
  // price change doesn't retroactively reprice an open check.
  description       String
  quantity          Decimal             @default(1)
  unitPrice         Decimal             @default(0)
  // Per-line percentage discount (0–100). Server-level math at
  // settlement resolves line vs chit discount with the same
  // override rules used today.
  discountPct       Decimal             @default(0)
  taxable           Boolean             @default(true)
  // Routing destination snapshot at the time the line was added. We
  // freeze this so a later menu reorganisation doesn't move an
  // already-sent kitchen line to the bar.
  prepStation       String              @default("KITCHEN")
  // Coursing — 1 = fire with the first round, 2 = next course, etc.
  // Servers set this on the check; sendUnsentItems groups by course
  // (and station) and only course 1 fires immediately.
  course            Int                 @default(1)
  note              String?
  status            String              @default("DRAFT")
  // Whether the line carries an allergy modifier — set when any of
  // its modifiers has modifierType=ALLERGY. Denormalised so kitchen
  // / bar views can flag the whole line without joining modifiers.
  hasAllergy        Boolean             @default(false)
  // Operational timestamps. sentAt set when included in a chit;
  // readyAt set when the chit is marked ready; servedAt set when the
  // server confirms the item has been delivered to the table.
  sentAt            DateTime?
  readyAt           DateTime?
  servedAt          DateTime?
  // Set with servedAt when the line transitions READY → SERVED.
  // Null on lines moved to SERVED via the bulk settleCheck path
  // (those servers are recorded on the check itself).
  servedByUserId    String?
  // Void / comp linkage.
  voidedAt          DateTime?
  voidedByUserId    String?
  voidedReason      String?
  compedByUserId    String?
  // Phase 18E — seat-level ordering.
  // seatNumber is 1-based; null means a table-level line (shared by
  // the table — water for everyone, etc.). tableLevel is the explicit
  // intent flag so chit rendering and split-bill grouping can treat
  // table lines distinctly from "seat not chosen yet".
  // settlementGroupId stamps a line to a POSSettlementGroup once the
  // server has split the check; lines without a group settle in
  // whichever group claims their seat at finalize-time.
  seatNumber        Int?
  tableLevel        Boolean             @default(false)
  settlementGroupId String?
  settlementGroup   POSSettlementGroup? @relation(fields: [settlementGroupId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  chitLines POSChitLine[]
  // Active modifiers applied to this line (no onions, add bacon, etc.).
  // For DRAFT lines these can be freely edited; for SENT and beyond
  // they are frozen by the service layer.
  modifiers POSCheckLineModifier[]

  @@index([checkId, status])
  @@index([clubId, status])
}

// A prep ticket sent to a station. Multiple chits can come off one
// check as items are added in rounds. Chits don't reach the GL — they
// just tell the kitchen / bar what to make next.
//
// station: KITCHEN | BAR | DESSERT
// status:  HELD | QUEUED | PRINTED | ACKNOWLEDGED | READY | CANCELLED
//
// Coursing: chits carry a `course` number (1, 2, 3…). When sendUnsentItems
// runs, course-1 chits go straight to QUEUED with firedAt = sentAt.
// Course-N>1 chits start at HELD with firedAt = null and an optional
// `fireAt` timestamp set when the check has autoFireGapMinutes — the
// kitchen page loader promotes them once `fireAt` is in the past. A
// manual fireNextCourse promotes the lowest held course on a check.
model POSChit {
  id                   String    @id @default(cuid())
  clubId               String
  club                 Club      @relation(fields: [clubId], references: [id])
  checkId              String
  check                POSCheck  @relation(fields: [checkId], references: [id], onDelete: Cascade)
  station              String
  status               String    @default("QUEUED")
  course               Int       @default(1)
  sentByUserId         String?
  sentAt               DateTime  @default(now())
  // Set on the chit when it becomes active in the kitchen / bar view.
  // For course-1 chits this equals sentAt. For held chits this is set
  // at fire time (manual or auto). The prep timer counts from this.
  firedAt              DateTime?
  // Auto-fire schedule. Null = manual fire only. Otherwise the kitchen
  // page loader promotes the chit (HELD -> QUEUED, firedAt = now) once
  // the current time is past fireAt.
  fireAt               DateTime?
  printedAt            DateTime?
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  readyAt              DateTime?
  readyByUserId        String?
  cancelledAt          DateTime?
  cancelledByUserId    String?
  cancelledReason      String?

  lines POSChitLine[]

  @@index([clubId, station, status, sentAt])
  @@index([clubId, station, status, fireAt])
  @@index([checkId])
}

model POSChitLine {
  id                 String       @id @default(cuid())
  clubId             String
  club               Club         @relation(fields: [clubId], references: [id])
  chitId             String
  chit               POSChit      @relation(fields: [chitId], references: [id], onDelete: Cascade)
  checkLineId        String
  checkLine          POSCheckLine @relation(fields: [checkLineId], references: [id], onDelete: Cascade)
  // Snapshot of the line as it was sent to the station. If the server
  // later edits the underlying check line, the chit retains what the
  // kitchen actually got told.
  displayDescription String
  displayQuantity    Decimal      @default(1)
  displayNote        String?
  // Phase 18E — snapshotted at send time so the printed chit shows
  // "Seat 2 — Burger" without rejoining back to the live check line.
  displaySeatNumber  Int?
  displayTableLevel  Boolean      @default(false)
  // Mirror of POSCheckLine.servedAt — set when the server marks the
  // chit line as delivered to the table. Kept on the chit row too so
  // the kitchen/bar view can render a "Served" badge without joining
  // back to the check line.
  servedAt           DateTime?
  servedByUserId     String?

  @@index([chitId])
  @@index([checkLineId])
}

// Append-only timeline for a check. Drives the visual check timeline
// in the UI and serves as an operational audit (separate from the
// financial AuditLog, which only fires at settlement).
//
// type values (free-form, but the UI groups these):
//   OPENED | ITEM_ADDED | ITEM_REMOVED | ITEM_VOIDED | ITEM_COMPED |
//   ITEM_COURSE_CHANGED | AUTO_PACE_CHANGED |
//   CHIT_SENT | CHIT_ACKNOWLEDGED | CHIT_READY | CHIT_CANCELLED |
//   COURSE_FIRED |
//   DISCOUNT_CHANGED | DINING_MODE_CHANGED | SETTLED | VOIDED
model POSCheckEvent {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  checkId     String
  check       POSCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  type        String
  payloadJson String?
  byUserId    String?
  occurredAt  DateTime @default(now())

  @@index([checkId, occurredAt])
  @@index([clubId, type, occurredAt])
}

// status: ACTIVE | DISABLED
model POSIntegrationProvider {
  id            String   @id @default(cuid())
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id])
  key           String // e.g. "square" | "lightspeed" | "internal"
  name          String
  configJson    String?
  secretsJson   String?
  webhookSecret String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  terminals POSTerminal[]
  sales     POSSale[]

  @@unique([clubId, key])
}

// -------------------------------------------------------------------------
// 7H. LLM commentary drafts.
// status: PENDING | GENERATING | READY | ACCEPTED | REJECTED | FAILED
// -------------------------------------------------------------------------
model LLMCommentaryDraft {
  id                String    @id @default(cuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id])
  provider          String // openai | anthropic | mock
  model             String?
  subjectEntityType String? // ReportingPackage | Insight | Budget | ...
  subjectEntityId   String?
  promptTemplate    String?
  promptVariables   String? // JSON
  generatedText     String?
  promptTokens      Int       @default(0)
  completionTokens  Int       @default(0)
  status            String    @default("PENDING")
  errorMessage      String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  notes             String?
  requestedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  commentaries ReportingPackageCommentary[] @relation("CommentaryAIDraft")

  @@index([clubId, status])
  @@index([clubId, subjectEntityType, subjectEntityId])
}

// =========================================================================
// Phase 8 — Production infrastructure: queues, POS webhooks, tee-sheet,
//          hardware, feature flags, rate limiting.
// =========================================================================

// -------------------------------------------------------------------------
// 8A. Background job queue
// -------------------------------------------------------------------------
// kind: EXPORT | NOTIFICATION | LLM_COMMENTARY | DOCUMENT_BACKFILL |
//       POS_WEBHOOK | INVENTORY_SYNC | TEE_SHEET_SYNC | SCHEDULED_REPORT |
//       SCHEDULED_NOTIFICATION
// status: QUEUED | RUNNING | COMPLETED | FAILED | DEAD_LETTER | CANCELLED
model BackgroundJob {
  id              String    @id @default(cuid())
  clubId          String?
  club            Club?     @relation(fields: [clubId], references: [id])
  queue           String // e.g. "exports", "notifications"
  kind            String
  payloadJson     String // JSON arguments
  status          String    @default("QUEUED")
  priority        Int       @default(0)
  attempts        Int       @default(0)
  maxAttempts     Int       @default(5)
  // Idempotency: jobs supply a key so duplicate enqueues are safe. The
  // queue refuses to insert if an active job with this key already exists.
  idempotencyKey  String?
  scheduledFor    DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  lastError       String?
  resultJson      String?
  correlationId   String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  runs     JobRun[]
  failures JobFailure[]

  @@unique([clubId, kind, idempotencyKey])
  @@index([queue, status, scheduledFor])
  @@index([clubId, kind, status])
}

// status: SUCCEEDED | FAILED | RETRYING
model JobRun {
  id            String        @id @default(cuid())
  clubId        String?
  club          Club?         @relation(fields: [clubId], references: [id])
  jobId         String
  job           BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attemptNumber Int
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?
  durationMs    Int           @default(0)
  status        String
  errorMessage  String?
  workerId      String?

  @@index([jobId, attemptNumber])
}

model JobFailure {
  id            String        @id @default(cuid())
  clubId        String?
  club          Club?         @relation(fields: [clubId], references: [id])
  jobId         String
  job           BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attemptNumber Int
  errorMessage  String
  stack         String?
  occurredAt    DateTime      @default(now())

  @@index([jobId])
}

model QueueHealth {
  id              String   @id @default(cuid())
  clubId          String?
  club            Club?    @relation(fields: [clubId], references: [id])
  queue           String
  queueDepth      Int      @default(0)
  inFlight        Int      @default(0)
  failedLastHour  Int      @default(0)
  deadLetterCount Int      @default(0)
  observedAt      DateTime @default(now())

  @@index([queue, observedAt])
}

// -------------------------------------------------------------------------
// 8B. POS webhook events
// -------------------------------------------------------------------------
// status: RECEIVED | VERIFIED | PROCESSING | COMPLETED | FAILED | DUPLICATE
model POSWebhookEvent {
  id                String    @id @default(cuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id])
  providerKey       String
  externalEventId   String
  eventType         String
  receivedAt        DateTime  @default(now())
  signature         String?
  signatureVerified Boolean   @default(false)
  rawPayload        String
  status            String    @default("RECEIVED")
  failureReason     String?
  processedAt       DateTime?
  resultingSaleId   String?
  jobId             String?
  attempts          Int       @default(0)

  @@unique([clubId, providerKey, externalEventId])
  @@index([clubId, status, receivedAt])
}

model POSSyncRun {
  id            String    @id @default(cuid())
  clubId        String
  club          Club      @relation(fields: [clubId], references: [id])
  providerKey   String
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  totalReceived Int       @default(0)
  totalCreated  Int       @default(0)
  totalSkipped  Int       @default(0)
  totalFailed   Int       @default(0)
  status        String    @default("RUNNING")
  errorMessage  String?

  @@index([clubId, providerKey, startedAt])
}

model POSImportError {
  id             String   @id @default(cuid())
  clubId         String
  club           Club     @relation(fields: [clubId], references: [id])
  webhookEventId String?
  providerKey    String
  errorMessage   String
  payloadSnippet String?
  occurredAt     DateTime @default(now())

  @@index([clubId, providerKey, occurredAt])
}

// Maps external POS entity IDs to internal Spectre IDs (members, items,
// locations) so importers can resolve foreign keys without scanning.
// kind: MEMBER | ITEM | LOCATION | TERMINAL | TAX_CODE
model POSMapping {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  providerKey String
  kind        String
  externalId  String
  spectreId   String
  metaJson    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clubId, providerKey, kind, externalId])
  @@index([clubId, providerKey])
}

// Replay protection — public webhook receivers stash the signature/nonce
// here so duplicate deliveries are rejected.
model WebhookReplay {
  id         String   @id @default(cuid())
  clubId     String?
  club       Club?    @relation(fields: [clubId], references: [id])
  scope      String // "POS:square" | "POS:lightspeed" | ...
  nonce      String // signature or unique header from the provider
  receivedAt DateTime @default(now())

  @@unique([scope, nonce])
  @@index([receivedAt])
}

// -------------------------------------------------------------------------
// 8C. Tee-sheet engine
// -------------------------------------------------------------------------
model Course {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  code        String
  name        String
  holes       Int      @default(18)
  parTotal    Int      @default(72)
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())

  courseHoles CourseHole[]
  teeSheets   TeeSheet[]
  tournaments Tournament[] @relation("TournamentCourse")

  @@unique([clubId, code])
}

model CourseHole {
  id         String @id @default(cuid())
  clubId     String
  club       Club   @relation(fields: [clubId], references: [id])
  courseId   String
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  holeNumber Int
  par        Int    @default(4)
  yardage    Int?
  handicap   Int?

  @@unique([courseId, holeNumber])
}

// status: OPEN | CLOSED | LOCKED  — admin can lock a sheet for a day.
model TeeSheet {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id])
  sheetDate       DateTime
  status          String    @default("OPEN")
  bookingOpensAt  DateTime?
  bookingClosesAt DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  times     TeeTime[]
  lotteries TeeLottery[]

  @@unique([clubId, courseId, sheetDate])
  @@index([clubId, sheetDate])
}

// status: AVAILABLE | BOOKED | BLOCKED | LOTTERY_RESERVED
model TeeTime {
  id              String   @id @default(cuid())
  clubId          String
  club            Club     @relation(fields: [clubId], references: [id])
  teeSheetId      String
  teeSheet        TeeSheet @relation(fields: [teeSheetId], references: [id], onDelete: Cascade)
  startTime       DateTime
  intervalMinutes Int      @default(10)
  maxPlayers      Int      @default(4)
  startingTee     Int      @default(1)
  status          String   @default("AVAILABLE")
  notes           String?
  createdAt       DateTime @default(now())

  bookings TeeTimeBooking[]
  players  TeeTimePlayer[]
  pace     PaceOfPlayRecord[]
  carts    CartAssignment[]

  @@unique([teeSheetId, startTime, startingTee])
  @@index([clubId, startTime])
}

// status: CONFIRMED | CANCELLED | WAITLISTED | CHECKED_IN | NO_SHOW
// bookingChannel: MEMBER_PORTAL | ADMIN | LOTTERY | EXTERNAL
model TeeTimeBooking {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  teeTimeId       String
  teeTime         TeeTime   @relation(fields: [teeTimeId], references: [id], onDelete: Cascade)
  primaryMemberId String
  primaryMember   Member    @relation("TeeBookingMember", fields: [primaryMemberId], references: [id])
  guestCount      Int       @default(0)
  cartRequested   Int       @default(0)
  status          String    @default("CONFIRMED")
  bookingChannel  String    @default("MEMBER_PORTAL")
  bookedAt        DateTime  @default(now())
  cancelledAt     DateTime?
  cancelReason    String?
  noShowChargedAt DateTime?
  notes           String?

  players TeeTimePlayer[]
  guests  TeeTimeGuest[]

  @@index([clubId, primaryMemberId, status])
  @@index([teeTimeId])
}

model TeeTimePlayer {
  id          String          @id @default(cuid())
  clubId      String
  club        Club            @relation(fields: [clubId], references: [id])
  teeTimeId   String
  teeTime     TeeTime         @relation(fields: [teeTimeId], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     TeeTimeBooking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  memberId    String?
  member      Member?         @relation("TeeTimePlayerMember", fields: [memberId], references: [id])
  guestId     String?
  guest       TeeTimeGuest?   @relation(fields: [guestId], references: [id])
  playerOrder Int             @default(0)

  @@index([teeTimeId])
}

model TeeTimeGuest {
  id               String         @id @default(cuid())
  clubId           String
  club             Club           @relation(fields: [clubId], references: [id])
  bookingId        String
  booking          TeeTimeBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  email            String?
  guestFeeChargeId String?
  createdAt        DateTime       @default(now())

  players TeeTimePlayer[]

  @@index([bookingId])
}

// status: OPEN | DRAWING | DRAWN | CANCELLED
// strategy: RANDOM | PRIORITY_TENURE
model TeeLottery {
  id         String    @id @default(cuid())
  clubId     String
  club       Club      @relation(fields: [clubId], references: [id])
  teeSheetId String
  teeSheet   TeeSheet  @relation(fields: [teeSheetId], references: [id], onDelete: Cascade)
  name       String
  opensAt    DateTime
  closesAt   DateTime
  drawAt     DateTime
  status     String    @default("OPEN")
  strategy   String    @default("RANDOM")
  drawnAt    DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  entries TeeLotteryEntry[]

  @@index([clubId, status])
}

// status: PENDING | ASSIGNED | DECLINED
model TeeLotteryEntry {
  id                String     @id @default(cuid())
  clubId            String
  club              Club       @relation(fields: [clubId], references: [id])
  lotteryId         String
  lottery           TeeLottery @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  memberId          String
  member            Member     @relation("TeeLotteryEntryMember", fields: [memberId], references: [id])
  priorityScore     Int        @default(0) // higher = drawn first
  preferredWindow   String? // e.g. "08:00-10:00"
  groupSize         Int        @default(1)
  status            String     @default("PENDING")
  assignedTeeTimeId String?
  enteredAt         DateTime   @default(now())

  @@unique([lotteryId, memberId])
  @@index([clubId, lotteryId, status])
}

model PaceOfPlayRecord {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  teeTimeId       String
  teeTime         TeeTime   @relation(fields: [teeTimeId], references: [id])
  startedAt       DateTime
  endedAt         DateTime?
  expectedMinutes Int       @default(240) // 4 hours
  actualMinutes   Int       @default(0)
  notes           String?
  recordedAt      DateTime  @default(now())

  @@index([teeTimeId])
}

// kind: CART | LOCKER | RANGE
model CartAssignment {
  id           String    @id @default(cuid())
  clubId       String
  club         Club      @relation(fields: [clubId], references: [id])
  teeTimeId    String?
  teeTime      TeeTime?  @relation(fields: [teeTimeId], references: [id])
  resourceCode String
  kind         String    @default("CART")
  assignedAt   DateTime  @default(now())
  releasedAt   DateTime?

  @@index([clubId, resourceCode])
}

// -------------------------------------------------------------------------
// 8E. Hardware / IoT
// -------------------------------------------------------------------------
// kind: GPS_BAG_TAG | DOOR_ACCESS | LOCKER | BEVERAGE_CART_RADIO |
//       DRIVING_RANGE_CAMERA | PARKING_GATE | GEOFENCE
// status: ACTIVE | DISABLED | OFFLINE | LOST
model HardwareDevice {
  id              String   @id @default(cuid())
  clubId          String
  club            Club     @relation(fields: [clubId], references: [id])
  serial          String
  kind            String
  label           String?
  vendor          String?
  model           String?
  status          String   @default("ACTIVE")
  metaJson        String?
  firmwareVersion String?
  authTokenHash   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events      DeviceEvent[]
  statuses    DeviceStatus[]
  assignments DeviceAssignment[]

  @@unique([clubId, serial])
  @@index([clubId, kind, status])
}

// kind: HEARTBEAT | EVENT | ERROR
model DeviceEvent {
  id         String         @id @default(cuid())
  clubId     String
  club       Club           @relation(fields: [clubId], references: [id])
  deviceId   String
  device     HardwareDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  kind       String         @default("EVENT")
  eventType  String // e.g. "DOOR_OPEN", "GPS_PING", "RANGE_BUCKET"
  occurredAt DateTime       @default(now())
  metaJson   String?

  @@index([clubId, deviceId, occurredAt])
  @@index([clubId, eventType, occurredAt])
}

model DeviceStatus {
  id             String         @id @default(cuid())
  clubId         String
  club           Club           @relation(fields: [clubId], references: [id])
  deviceId       String
  device         HardwareDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  online         Boolean        @default(true)
  lastHeartbeat  DateTime?
  batteryPercent Int?
  signalStrength Int?
  metaJson       String?
  observedAt     DateTime       @default(now())

  @@index([deviceId, observedAt])
}

// kind: MEMBER | LOCATION | TEE_TIME | EVENT
model DeviceAssignment {
  id          String         @id @default(cuid())
  clubId      String
  club        Club           @relation(fields: [clubId], references: [id])
  deviceId    String
  device      HardwareDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  kind        String
  subjectType String
  subjectId   String
  assignedAt  DateTime       @default(now())
  releasedAt  DateTime?

  @@index([clubId, deviceId])
  @@index([subjectType, subjectId])
}

// -------------------------------------------------------------------------
// 8J. Feature flags (per-club rollout control)
// -------------------------------------------------------------------------
// scope: PHASE | MODULE | EXPERIMENT
model FeatureFlag {
  id             String   @id @default(cuid())
  clubId         String? // null = global default
  club           Club?    @relation(fields: [clubId], references: [id])
  key            String
  name           String
  description    String?
  isEnabled      Boolean  @default(false)
  rolloutPercent Int      @default(0) // 0-100 for gradual rollout
  scope          String   @default("MODULE")
  metaJson       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([clubId, key])
  @@index([key, isEnabled])
}

// -------------------------------------------------------------------------
// 8H. Rate limit buckets (token-bucket persisted state — for clusters where
// in-memory limiter is insufficient).
// -------------------------------------------------------------------------
model RateLimitBucket {
  id         String   @id @default(cuid())
  clubId     String?
  club       Club?    @relation(fields: [clubId], references: [id])
  scope      String // "login" | "webhook:square" | "export" | ...
  identifier String // ip / userId / clubId composite
  tokens     Decimal  @default(0)
  refillAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([scope, identifier])
  @@index([scope, updatedAt])
}

// =========================================================================
// Phase 9 — Hardening: observability, auth, push, tournaments, external API
// =========================================================================

// -------------------------------------------------------------------------
// 9A. Observability events + metric counters.
// -------------------------------------------------------------------------
// kind: TRACE | SPAN | ERROR | EVENT
model ObservabilityEvent {
  id            String   @id @default(cuid())
  clubId        String?
  club          Club?    @relation(fields: [clubId], references: [id])
  kind          String   @default("EVENT")
  name          String
  status        String   @default("OK") // OK | WARN | ERROR
  correlationId String?
  durationMs    Int?
  message       String?
  metaJson      String?
  occurredAt    DateTime @default(now())

  @@index([clubId, kind, occurredAt])
  @@index([correlationId])
}

// Persistent rollups of counter metrics; production wires Prometheus on top.
model MetricCounter {
  id        String   @id @default(cuid())
  clubId    String?
  club      Club?    @relation(fields: [clubId], references: [id])
  name      String
  labels    String   @default("{}") // JSON map of label k/v
  value     Decimal  @default(0)
  updatedAt DateTime @updatedAt

  @@unique([name, labels])
  @@index([clubId, name])
}

// -------------------------------------------------------------------------
// 9C. Auth hardening
// -------------------------------------------------------------------------
// outcome: SUCCESS | INVALID_PASSWORD | UNKNOWN_USER | LOCKED | RATE_LIMITED
model AuthAttempt {
  id         String   @id @default(cuid())
  clubId     String?
  club       Club?    @relation(fields: [clubId], references: [id])
  scope      String // login | password_reset | invite_accept | apply
  emailHash  String // sha256 hash of lowercased email; never raw
  ip         String?
  userAgent  String?
  outcome    String
  occurredAt DateTime @default(now())

  @@index([clubId, scope, occurredAt])
  @@index([emailHash, scope, occurredAt])
}

// status: ACTIVE | RELEASED | EXPIRED
// kind: AUTOMATIC | MANUAL_ADMIN | SUSPICION
model AccountLock {
  id               String    @id @default(cuid())
  clubId           String?
  club             Club?     @relation(fields: [clubId], references: [id])
  userId           String?
  emailHash        String
  kind             String    @default("AUTOMATIC")
  reason           String?
  status           String    @default("ACTIVE")
  lockedAt         DateTime  @default(now())
  expiresAt        DateTime?
  releasedAt       DateTime?
  releasedByUserId String?

  @@index([emailHash, status])
  @@index([clubId, status])
}

// kind: BRUTE_FORCE | UNUSUAL_GEO | UNUSUAL_DEVICE | RATE_LIMITED
model SuspiciousActivityEvent {
  id         String   @id @default(cuid())
  clubId     String?
  club       Club?    @relation(fields: [clubId], references: [id])
  kind       String
  emailHash  String?
  ip         String?
  userAgent  String?
  severity   String   @default("WATCH") // INFO | WATCH | WARN | CRITICAL
  metaJson   String?
  occurredAt DateTime @default(now())

  @@index([clubId, kind, occurredAt])
  @@index([emailHash, occurredAt])
}

// -------------------------------------------------------------------------
// 9D. Web push subscriptions
// -------------------------------------------------------------------------
model WebPushSubscription {
  id           String    @id @default(cuid())
  clubId       String
  club         Club      @relation(fields: [clubId], references: [id])
  userId       String?
  memberId     String?
  member       Member?   @relation("PushSubscriptionMember", fields: [memberId], references: [id])
  endpoint     String
  p256dh       String
  authSecret   String
  userAgent    String?
  isActive     Boolean   @default(true)
  failureCount Int       @default(0)
  lastSentAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([endpoint])
  @@index([clubId, userId, isActive])
  @@index([clubId, memberId, isActive])
}

// -------------------------------------------------------------------------
// 9F. Tournament management
// -------------------------------------------------------------------------
// status: DRAFT | OPEN | LOCKED | IN_PROGRESS | COMPLETED | CANCELLED
// format: STROKE | MATCH | SCRAMBLE | STABLEFORD | LADDER
model Tournament {
  id                   String    @id @default(cuid())
  clubId               String
  club                 Club      @relation(fields: [clubId], references: [id])
  name                 String
  description          String?
  format               String    @default("STROKE")
  status               String    @default("DRAFT")
  startDate            DateTime
  endDate              DateTime
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  entryFee             Decimal   @default(0)
  guestFee             Decimal   @default(0)
  maxParticipants      Int?
  courseId             String?
  course               Course?   @relation("TournamentCourse", fields: [courseId], references: [id])
  revenueAccountId     String?
  revenueAccount       Account?  @relation("TournamentRevenue", fields: [revenueAccountId], references: [id])
  notes                String?
  createdByUserId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  divisions     TournamentDivision[]
  registrations TournamentRegistration[]
  teams         TournamentTeam[]
  rounds        TournamentRound[]
  matches       TournamentMatch[]
  scores        TournamentScore[]
  leaderboards  TournamentLeaderboard[]
  prizes        TournamentPayoutPrize[]
  comms         TournamentCommunication[]

  @@unique([clubId, name])
  @@index([clubId, status])
}

model TournamentDivision {
  id           String     @id @default(cuid())
  clubId       String
  club         Club       @relation(fields: [clubId], references: [id])
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  minHandicap  Int?
  maxHandicap  Int?
  sortOrder    Int        @default(0)

  registrations TournamentRegistration[]

  @@unique([tournamentId, name])
}

// status: REGISTERED | WAITLISTED | CONFIRMED | CANCELLED | NO_SHOW
model TournamentRegistration {
  id             String              @id @default(cuid())
  clubId         String
  club           Club                @relation(fields: [clubId], references: [id])
  tournamentId   String
  tournament     Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  divisionId     String?
  division       TournamentDivision? @relation(fields: [divisionId], references: [id])
  memberId       String?
  member         Member?             @relation("TournamentRegistrationMember", fields: [memberId], references: [id])
  guestFirstName String?
  guestLastName  String?
  guestEmail     String?
  teamId         String?
  team           TournamentTeam?     @relation(fields: [teamId], references: [id])
  handicap       Int?
  status         String              @default("REGISTERED")
  registeredAt   DateTime            @default(now())
  cancelledAt    DateTime?
  cancelReason   String?
  feeChargeId    String? // ar charge id
  notes          String?

  scores   TournamentScore[]
  matchesA TournamentMatch[] @relation("MatchPlayerA")
  matchesB TournamentMatch[] @relation("MatchPlayerB")

  @@unique([tournamentId, memberId])
  @@index([clubId, tournamentId, status])
}

model TournamentTeam {
  id           String     @id @default(cuid())
  clubId       String
  club         Club       @relation(fields: [clubId], references: [id])
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime   @default(now())

  registrations TournamentRegistration[]

  @@unique([tournamentId, name])
}

model TournamentRound {
  id            String     @id @default(cuid())
  clubId        String
  club          Club       @relation(fields: [clubId], references: [id])
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  roundNumber   Int
  scheduledDate DateTime
  status        String     @default("OPEN") // OPEN | IN_PROGRESS | COMPLETED
  notes         String?

  matches TournamentMatch[]
  scores  TournamentScore[]

  @@unique([tournamentId, roundNumber])
}

// status: SCHEDULED | IN_PROGRESS | COMPLETED | WALKOVER | CANCELLED
model TournamentMatch {
  id                    String                  @id @default(cuid())
  clubId                String
  club                  Club                    @relation(fields: [clubId], references: [id])
  tournamentId          String
  tournament            Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  roundId               String
  round                 TournamentRound         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  bracketSlot           Int? // for matchplay bracket
  playerARegistrationId String?
  playerA               TournamentRegistration? @relation("MatchPlayerA", fields: [playerARegistrationId], references: [id])
  playerBRegistrationId String?
  playerB               TournamentRegistration? @relation("MatchPlayerB", fields: [playerBRegistrationId], references: [id])
  winnerRegistrationId  String?
  scoreA                Int?
  scoreB                Int?
  status                String                  @default("SCHEDULED")
  startedAt             DateTime?
  completedAt           DateTime?
  notes                 String?

  @@index([tournamentId, roundId])
}

// One score row per (round, registration, hole). Aggregations live in
// TournamentLeaderboard.
model TournamentScore {
  id               String                 @id @default(cuid())
  clubId           String
  club             Club                   @relation(fields: [clubId], references: [id])
  tournamentId     String
  tournament       Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  roundId          String
  round            TournamentRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  registrationId   String
  registration     TournamentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  memberId         String?
  member           Member?                @relation("TournamentScoreMember", fields: [memberId], references: [id])
  holeNumber       Int
  strokes          Int
  putts            Int?
  recordedAt       DateTime               @default(now())
  recordedByUserId String?

  @@unique([roundId, registrationId, holeNumber])
  @@index([tournamentId, registrationId])
}

model TournamentLeaderboard {
  id             String     @id @default(cuid())
  clubId         String
  club           Club       @relation(fields: [clubId], references: [id])
  tournamentId   String
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  registrationId String
  totalStrokes   Int        @default(0)
  totalPoints    Int        @default(0)
  positionRank   Int        @default(0)
  divisionRank   Int?
  divisionId     String?
  updatedAt      DateTime   @updatedAt

  @@unique([tournamentId, registrationId])
  @@index([tournamentId, positionRank])
}

model TournamentPayoutPrize {
  id                      String     @id @default(cuid())
  clubId                  String
  club                    Club       @relation(fields: [clubId], references: [id])
  tournamentId            String
  tournament              Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  rank                    Int
  divisionId              String?
  label                   String
  amount                  Decimal    @default(0)
  awardedToRegistrationId String?
  awardedAt               DateTime?

  @@index([tournamentId, rank])
}

model TournamentCommunication {
  id           String     @id @default(cuid())
  clubId       String
  club         Club       @relation(fields: [clubId], references: [id])
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  channel      String     @default("EMAIL")
  subject      String
  body         String
  sentAt       DateTime?
  sentByUserId String?
  createdAt    DateTime   @default(now())

  @@index([tournamentId])
}

// -------------------------------------------------------------------------
// 9H. External API: keys, audit logs, webhook subscriptions
// -------------------------------------------------------------------------
// status: ACTIVE | REVOKED | EXPIRED
model ApiKey {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  name            String
  // keyPrefix is the first 8 chars of the key — shown in lists for
  // identification (raw key shown only at creation). keyHash stores the
  // sha256 of the raw key.
  keyPrefix       String    @unique
  keyHash         String
  status          String    @default("ACTIVE")
  ipAllowlist     String? // CSV
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  createdByUserId String?
  revokedByUserId String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  permissions ApiKeyPermission[]
  requestLogs ApiRequestLog[]

  @@index([clubId, status])
}

// Scoped permission per API key — e.g. "members:read", "pos:read".
model ApiKeyPermission {
  id         String @id @default(cuid())
  clubId     String
  club       Club   @relation(fields: [clubId], references: [id])
  apiKeyId   String
  apiKey     ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  permission String

  @@unique([apiKeyId, permission])
}

// status: SUCCESS | DENIED | RATE_LIMITED | ERROR
model ApiRequestLog {
  id           String   @id @default(cuid())
  clubId       String
  club         Club     @relation(fields: [clubId], references: [id])
  apiKeyId     String?
  apiKey       ApiKey?  @relation(fields: [apiKeyId], references: [id])
  method       String
  path         String
  status       String
  responseCode Int      @default(0)
  durationMs   Int      @default(0)
  ip           String?
  userAgent    String?
  errorMessage String?
  occurredAt   DateTime @default(now())

  @@index([clubId, occurredAt])
  @@index([apiKeyId, occurredAt])
}

// status: ACTIVE | DISABLED | REVOKED
model WebhookSubscription {
  id             String    @id @default(cuid())
  clubId         String
  club           Club      @relation(fields: [clubId], references: [id])
  apiKeyId       String?
  name           String
  url            String
  secret         String // hashed
  events         String // CSV of event keys, e.g. "member.created,charge.posted"
  status         String    @default("ACTIVE")
  failureCount   Int       @default(0)
  lastDeliveryAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deliveries           WebhookDelivery[]
  WebhookSecretVersion WebhookSecretVersion[]

  @@index([clubId, status])
}

// status: PENDING | DELIVERED | FAILED
model WebhookDelivery {
  id             String              @id @default(cuid())
  clubId         String
  club           Club                @relation(fields: [clubId], references: [id])
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventType      String
  payloadJson    String
  status         String              @default("PENDING")
  attempts       Int                 @default(0)
  responseCode   Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())

  @@index([subscriptionId, status])
  @@index([clubId, eventType, createdAt])
}

// -------------------------------------------------------------------------
// 9I. Pilot readiness checklist items
// -------------------------------------------------------------------------
// status: PENDING | IN_PROGRESS | COMPLETE | NOT_APPLICABLE
// kind:   RUNTIME (auto-checked) | MANUAL (admin marks done)
model PilotReadinessItem {
  id                String    @id @default(cuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id])
  category          String // INFRA | SECURITY | INTEGRATIONS | DATA | TRAINING | GO_LIVE
  key               String // e.g. "redis_configured", "ses_configured"
  label             String
  description       String?
  kind              String    @default("MANUAL")
  status            String    @default("PENDING")
  details           String?
  completedAt       DateTime?
  completedByUserId String?
  updatedAt         DateTime  @updatedAt

  @@unique([clubId, key])
  @@index([clubId, category, status])
}

// =========================================================================
// Phase 10 — Commercial / production readiness
// =========================================================================

// -------------------------------------------------------------------------
// 10A. Push delivery monitoring
// -------------------------------------------------------------------------
// status: SENT | EXPIRED | FAILED | RETRIED
model PushDeliveryAttempt {
  id                String        @id @default(cuid())
  clubId            String
  club              Club          @relation(fields: [clubId], references: [id])
  subscriptionId    String?
  campaignId        String?
  campaign          PushCampaign? @relation(fields: [campaignId], references: [id])
  attemptNumber     Int           @default(1)
  status            String
  providerMessageId String?
  failureReason     String?
  durationMs        Int           @default(0)
  attemptedAt       DateTime      @default(now())

  @@index([clubId, status, attemptedAt])
  @@index([subscriptionId])
}

// status: DRAFT | SCHEDULED | RUNNING | COMPLETED | CANCELLED
model PushCampaign {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  name            String
  title           String
  body            String
  url             String?
  audienceJson    String? // criteria — e.g. {"memberStatus":"ACTIVE"}
  scheduledFor    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  status          String    @default("DRAFT")
  totalQueued     Int       @default(0)
  totalSent       Int       @default(0)
  totalFailed     Int       @default(0)
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  attempts PushDeliveryAttempt[]

  @@index([clubId, status])
}

// -------------------------------------------------------------------------
// 10E. Tournament pairings (tee-time-bound groupings)
// -------------------------------------------------------------------------
model TournamentPairing {
  id                String   @id @default(cuid())
  clubId            String
  club              Club     @relation(fields: [clubId], references: [id])
  tournamentId      String
  roundId           String
  teeTimeId         String? // booked tee time once pairings advance to scheduling
  groupNumber       Int      @default(1)
  registrationsJson String // JSON array of TournamentRegistration ids in the group
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tournamentId, roundId])
}

// -------------------------------------------------------------------------
// 10I. Commercial SaaS readiness
// -------------------------------------------------------------------------
// tier: PILOT | STARTER | PROFESSIONAL | ENTERPRISE | UNLIMITED
model SubscriptionPlan {
  id               String   @id @default(cuid())
  key              String   @unique
  name             String
  tier             String
  description      String?
  monthlyPrice     Decimal  @default(0)
  annualPrice      Decimal  @default(0)
  featuresJson     String   @default("[]") // canonical feature keys included
  seatLimit        Int?
  storageGb        Int?
  apiCallsPerMonth Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  clubs ClubSubscription[]
}

// status: PILOT | ACTIVE | TRIAL | PAUSED | CANCELLED
model ClubSubscription {
  id           String            @id @default(cuid())
  clubId       String            @unique
  club         Club              @relation(fields: [clubId], references: [id])
  planId       String?
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id])
  status       String            @default("PILOT")
  seatCount    Int               @default(0)
  trialEndsAt  DateTime?
  activatedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  notesJson    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status])
}

// kind: API_CALLS | STORAGE_GB | PUSH_DELIVERIES | EXPORTS_GENERATED | WEBHOOK_DELIVERIES
model UsageMetric {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  periodLabel String // monthly bucket, "2026-08"
  kind        String
  value       Decimal  @default(0)
  recordedAt  DateTime @default(now())

  @@unique([clubId, periodLabel, kind])
  @@index([clubId, kind, periodLabel])
}

model BillingCycle {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  periodLabel String
  startDate   DateTime
  endDate     DateTime
  totalDue    Decimal  @default(0)
  totalPaid   Decimal  @default(0)
  status      String   @default("OPEN") // OPEN | INVOICED | PAID | VOIDED
  invoiceJson String? // placeholder — full invoice flow lives in Phase 11
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clubId, periodLabel])
  @@index([clubId, status])
}

// =========================================================================
// Phase 11 — Launch readiness
// =========================================================================

// -------------------------------------------------------------------------
// 11B. Webhook secret rotation
// -------------------------------------------------------------------------
// state: ACTIVE | PENDING | EXPIRED | REVOKED
// Each subscription can have multiple versions; the rotation flow maintains
// at most ONE ACTIVE and at most ONE PENDING; expired versions linger so
// receivers can verify during the grace window.
model WebhookSecretVersion {
  id              String              @id @default(cuid())
  clubId          String
  club            Club                @relation(fields: [clubId], references: [id])
  subscriptionId  String
  subscription    WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  versionNumber   Int
  state           String              @default("ACTIVE")
  secret          String // cleartext; only the rotation flow ever displays it
  activatedAt     DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime            @default(now())

  @@unique([subscriptionId, versionNumber])
  @@index([subscriptionId, state])
}

// action: CREATED | ACTIVATED | GRACE_STARTED | EXPIRED | REVOKED | ROLLED_BACK
model WebhookSecretRotation {
  id             String   @id @default(cuid())
  clubId         String
  club           Club     @relation(fields: [clubId], references: [id])
  subscriptionId String
  versionId      String?
  action         String
  byUserId       String?
  reason         String?
  occurredAt     DateTime @default(now())

  @@index([subscriptionId, occurredAt])
}

// -------------------------------------------------------------------------
// 11C. POS mapping change history (audit trail for the mapping editor)
// -------------------------------------------------------------------------
// action: CREATE | UPDATE | DELETE | IGNORE | RESTORE
model POSMappingHistory {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  providerKey String
  kind        String
  externalId  String
  beforeJson  String?
  afterJson   String?
  action      String
  byUserId    String?
  occurredAt  DateTime @default(now())

  @@index([clubId, providerKey, occurredAt])
}

// -------------------------------------------------------------------------
// 11E. Tournament score drafts + corrections
// -------------------------------------------------------------------------
// status: DRAFT | SUBMITTED | ACCEPTED | REJECTED
model TournamentScoreDraft {
  id                String    @id @default(cuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id])
  tournamentId      String
  roundId           String
  registrationId    String
  // Stored as JSON: { "1": 4, "2": 5, ... }
  scoresJson        String    @default("{}")
  status            String    @default("DRAFT")
  // Phase 12C — optimistic concurrency: bumps on every save. Clients send
  // the version they read; mismatched versions raise a conflict.
  version           Int       @default(1)
  // Last device/client to write — surfaces in the reconciliation UI.
  lastEditorUserId  String?
  lastEditorLabel   String?
  submittedAt       DateTime?
  submittedByUserId String?
  acceptedAt        DateTime?
  acceptedByUserId  String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  conflicts TournamentScoreConflict[]

  @@unique([roundId, registrationId])
  @@index([clubId, tournamentId, status])
}

// Phase 12C — Conflict events for the reconciliation UI + audit trail.
// resolution: PENDING | KEPT_SERVER | KEPT_CLIENT | MERGED | DISMISSED
model TournamentScoreConflict {
  id               String               @id @default(cuid())
  clubId           String
  club             Club                 @relation(fields: [clubId], references: [id])
  draftId          String
  draft            TournamentScoreDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  clientVersion    Int
  serverVersion    Int
  clientScoresJson String
  serverScoresJson String
  resolution       String               @default("PENDING")
  resolvedAt       DateTime?
  resolvedByUserId String?
  detectedAt       DateTime             @default(now())

  @@index([clubId, draftId, resolution])
}

// kind: ADD | UPDATE | REMOVE
model TournamentScoreCorrection {
  id             String   @id @default(cuid())
  clubId         String
  club           Club     @relation(fields: [clubId], references: [id])
  tournamentId   String
  roundId        String
  registrationId String
  holeNumber     Int
  beforeStrokes  Int?
  afterStrokes   Int?
  reason         String
  byUserId       String?
  occurredAt     DateTime @default(now())

  @@index([tournamentId, registrationId])
}

// -------------------------------------------------------------------------
// 11F. SaaS billing — Stripe-backed (provider-agnostic schema)
// -------------------------------------------------------------------------
model BillingCustomer {
  id                   String   @id @default(cuid())
  clubId               String   @unique
  club                 Club     @relation(fields: [clubId], references: [id])
  provider             String   @default("stripe")
  externalId           String // provider customer id
  email                String?
  defaultPaymentMethod String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions   BillingSubscription[]
  invoices        BillingInvoice[]
  paymentAttempts BillingPaymentAttempt[]
}

// status: ACTIVE | TRIALING | PAST_DUE | CANCELLED | PAUSED
model BillingSubscription {
  id                 String          @id @default(cuid())
  clubId             String
  club               Club            @relation(fields: [clubId], references: [id])
  customerId         String
  customer           BillingCustomer @relation(fields: [customerId], references: [id])
  provider           String          @default("stripe")
  externalId         String // provider subscription id
  planId             String? // FK to SubscriptionPlan
  status             String          @default("ACTIVE")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAt           DateTime?
  cancelledAt        DateTime?
  metaJson           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([provider, externalId])
  @@index([clubId, status])
}

// status: DRAFT | OPEN | PAID | UNCOLLECTIBLE | VOID
model BillingInvoice {
  id          String          @id @default(cuid())
  clubId      String
  club        Club            @relation(fields: [clubId], references: [id])
  customerId  String
  customer    BillingCustomer @relation(fields: [customerId], references: [id])
  provider    String          @default("stripe")
  externalId  String
  number      String?
  amountDue   Decimal         @default(0)
  amountPaid  Decimal         @default(0)
  currency    String          @default("usd")
  status      String          @default("DRAFT")
  hostedUrl   String?
  pdfUrl      String?
  dueDate     DateTime?
  paidAt      DateTime?
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  paymentAttempts BillingPaymentAttempt[]

  @@unique([provider, externalId])
  @@index([clubId, status])
}

// status: SUCCEEDED | FAILED | PENDING
model BillingPaymentAttempt {
  id             String          @id @default(cuid())
  clubId         String
  club           Club            @relation(fields: [clubId], references: [id])
  customerId     String
  customer       BillingCustomer @relation(fields: [customerId], references: [id])
  invoiceId      String?
  invoice        BillingInvoice? @relation(fields: [invoiceId], references: [id])
  provider       String          @default("stripe")
  externalId     String
  amount         Decimal         @default(0)
  status         String
  failureMessage String?
  occurredAt     DateTime        @default(now())

  @@unique([provider, externalId])
  @@index([clubId, status, occurredAt])
}

// status: RECEIVED | VERIFIED | PROCESSING | COMPLETED | FAILED | DUPLICATE
model BillingWebhookEvent {
  id                String    @id @default(cuid())
  clubId            String? // nullable until we know the club from payload
  club              Club?     @relation(fields: [clubId], references: [id])
  provider          String    @default("stripe")
  externalEventId   String
  eventType         String
  signature         String?
  signatureVerified Boolean   @default(false)
  status            String    @default("RECEIVED")
  failureReason     String?
  processedAt       DateTime?
  rawPayload        String
  receivedAt        DateTime  @default(now())

  @@unique([provider, externalEventId])
  @@index([provider, status, receivedAt])
}

// -------------------------------------------------------------------------
// 11G. MFA + SSO
// -------------------------------------------------------------------------
// kind: TOTP | WEBAUTHN | SMS (future)
// status: PENDING | ACTIVE | DISABLED
model MfaFactor {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String    @default("TOTP")
  label      String?
  secret     String // base32 TOTP secret; recovery codes are separate
  status     String    @default("PENDING")
  lastUsedAt DateTime?
  enrolledAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, kind])
}

// One row per recovery code; each is single-use.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String // sha256 of the raw code
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Remember-this-device support — value here is a cookie token sha256 hash.
model TrustedDevice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  label     String?
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

// kind: OIDC | SAML
// status: ACTIVE | DISABLED
model SsoProvider {
  id             String   @id @default(cuid())
  clubId         String
  club           Club     @relation(fields: [clubId], references: [id])
  kind           String
  name           String
  issuer         String? // OIDC issuer URL
  clientId       String?
  clientSecret   String? // store via secrets manager in production
  acsUrl         String? // SAML
  entityId       String? // SAML
  certificate    String? // SAML signing cert (PEM)
  emailDomain    String? // optional: only accept logins from this email domain
  defaultRoleKey String   @default("STAFF")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  loginAttempts SsoLoginAttempt[]

  @@unique([clubId, kind])
}

// status: SUCCESS | DENIED | ERROR
model SsoLoginAttempt {
  id            String       @id @default(cuid())
  clubId        String
  club          Club         @relation(fields: [clubId], references: [id])
  providerId    String?
  provider      SsoProvider? @relation(fields: [providerId], references: [id])
  email         String?
  status        String
  failureReason String?
  ip            String?
  userAgent     String?
  occurredAt    DateTime     @default(now())

  @@index([clubId, occurredAt])
}

// =========================================================================
// Phase 12 — Enterprise-scale + compliance
// =========================================================================

// -------------------------------------------------------------------------
// 12A. KMS-backed secret encryption
// -------------------------------------------------------------------------
// action: ENCRYPT | DECRYPT | ROTATE | DELETE
// scope:  WEBHOOK | BILLING | POS | SSO | PUSH | API | SMTP
model SecretAccessLog {
  id              String   @id @default(cuid())
  clubId          String?
  club            Club?    @relation(fields: [clubId], references: [id])
  scope           String
  secretReference String // logical name (not the secret value)
  action          String
  actorUserId     String?
  actorApp        String? // for service-to-service callers
  provider        String? // aws-kms | gcp-kms | azure | local
  keyId           String?
  durationMs      Int      @default(0)
  status          String   @default("OK") // OK | FAIL
  errorMessage    String?
  occurredAt      DateTime @default(now())

  @@index([clubId, scope, occurredAt])
  @@index([occurredAt])
}

// kind: SCHEDULED | MANUAL | AUTOMATIC | EMERGENCY
// status: PENDING | COMPLETED | FAILED | CANCELLED
model KeyRotationEvent {
  id              String    @id @default(cuid())
  clubId          String?
  club            Club?     @relation(fields: [clubId], references: [id])
  scope           String
  secretReference String
  kind            String    @default("MANUAL")
  status          String    @default("PENDING")
  oldKeyId        String?
  newKeyId        String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  startedByUserId String?
  errorMessage    String?

  @@index([clubId, scope, startedAt])
}

// Metadata only — never store the encrypted blob here. The encrypted value
// lives in the original secret-bearing table (e.g. WebhookSecretVersion.secret)
// with an "enc:" prefix that this row's metadata describes.
model EncryptedSecretMetadata {
  id              String    @id @default(cuid())
  clubId          String?
  club            Club?     @relation(fields: [clubId], references: [id])
  scope           String
  secretReference String // logical name
  provider        String // aws-kms | local | etc.
  keyId           String
  algorithm       String    @default("AES-256-GCM")
  encryptedAt     DateTime  @default(now())
  rotatedAt       DateTime?
  lastDecryptedAt DateTime?

  @@unique([scope, secretReference])
  @@index([clubId, scope])
}

// -------------------------------------------------------------------------
// 12F. Marketplace ecosystem foundations
// -------------------------------------------------------------------------
// status: DRAFT | LISTED | UNLISTED | DEPRECATED
// kind:   FIRST_PARTY | THIRD_PARTY
model MarketplaceApp {
  id                String   @id @default(cuid())
  publisherUserId   String?
  key               String   @unique
  name              String
  description       String?
  iconUrl           String?
  homepageUrl       String?
  kind              String   @default("THIRD_PARTY")
  status            String   @default("DRAFT")
  defaultScopesJson String   @default("[]")
  clientId          String   @unique
  clientSecretHash  String // sha256; raw shown once at creation
  redirectUris      String // CSV
  webhookUrl        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  installs InstalledApp[]
  grants   OAuthGrant[]

  @@index([status])
}

// status: ACTIVE | DISABLED | REVOKED
model InstalledApp {
  id                String         @id @default(cuid())
  clubId            String
  club              Club           @relation(fields: [clubId], references: [id])
  appId             String
  app               MarketplaceApp @relation(fields: [appId], references: [id])
  installedByUserId String?
  installedAt       DateTime       @default(now())
  status            String         @default("ACTIVE")
  scopesJson        String         @default("[]")
  notes             String?
  revokedAt         DateTime?
  revokedByUserId   String?

  permissions          AppPermission[]
  webhookSubscriptions AppWebhookSubscription[]
  grants               OAuthGrant[]

  @@unique([clubId, appId])
  @@index([clubId, status])
}

model AppPermission {
  id             String       @id @default(cuid())
  clubId         String
  club           Club         @relation(fields: [clubId], references: [id])
  installedAppId String
  installedApp   InstalledApp @relation(fields: [installedAppId], references: [id], onDelete: Cascade)
  permission     String
  grantedAt      DateTime     @default(now())
  revokedAt      DateTime?

  @@unique([installedAppId, permission])
  @@index([clubId, permission])
}

// status: ACTIVE | EXPIRED | REVOKED
model OAuthGrant {
  id               String         @id @default(cuid())
  clubId           String
  club             Club           @relation(fields: [clubId], references: [id])
  appId            String
  app              MarketplaceApp @relation(fields: [appId], references: [id])
  installedAppId   String?
  installedApp     InstalledApp?  @relation(fields: [installedAppId], references: [id])
  accessTokenHash  String         @unique
  refreshTokenHash String?
  scopesJson       String         @default("[]")
  expiresAt        DateTime
  issuedAt         DateTime       @default(now())
  revokedAt        DateTime?
  status           String         @default("ACTIVE")

  @@index([clubId, status])
  @@index([appId, status])
}

model AppWebhookSubscription {
  id             String       @id @default(cuid())
  clubId         String
  club           Club         @relation(fields: [clubId], references: [id])
  installedAppId String
  installedApp   InstalledApp @relation(fields: [installedAppId], references: [id], onDelete: Cascade)
  events         String
  url            String
  secret         String
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())

  @@index([clubId, installedAppId])
}

// -------------------------------------------------------------------------
// 12G. Compliance + access review
// -------------------------------------------------------------------------
// status: PENDING | IN_PROGRESS | COMPLETED | CANCELLED
// scope:  USERS | ROLES | API_KEYS | INSTALLED_APPS | SSO_PROVIDERS
model AccessReview {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  scope           String
  status          String    @default("PENDING")
  title           String
  startedAt       DateTime  @default(now())
  dueDate         DateTime?
  completedAt     DateTime?
  createdByUserId String?

  items AccessReviewItem[]

  @@index([clubId, status])
}

// decision: PENDING | APPROVED | REVOKED
model AccessReviewItem {
  id              String       @id @default(cuid())
  clubId          String
  club            Club         @relation(fields: [clubId], references: [id])
  reviewId        String
  review          AccessReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  subjectType     String
  subjectId       String
  subjectLabel    String?
  currentJson     String?
  decision        String       @default("PENDING")
  decidedAt       DateTime?
  decidedByUserId String?
  notes           String?

  @@index([reviewId, decision])
}

// kind: AUDIT_LOG | AUTH_ATTEMPT | ACCESS_REVIEW | WEBHOOK_DELIVERY | EXPORT
// status: GENERATED | DELIVERED | ARCHIVED
model ComplianceEvidence {
  id                String    @id @default(cuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id])
  kind              String
  label             String
  periodStart       DateTime?
  periodEnd         DateTime?
  rowCount          Int       @default(0)
  documentId        String?
  storageKey        String?
  status            String    @default("GENERATED")
  generatedByUserId String?
  generatedAt       DateTime  @default(now())

  @@index([clubId, kind, generatedAt])
}

// status: PENDING | ACKNOWLEDGED | DECLINED
model PolicyAcknowledgement {
  id             String    @id @default(cuid())
  clubId         String
  club           Club      @relation(fields: [clubId], references: [id])
  userId         String
  policyKey      String
  policyVersion  String
  status         String    @default("PENDING")
  acknowledgedAt DateTime?
  declinedAt     DateTime?
  ip             String?
  userAgent      String?

  @@unique([userId, policyKey, policyVersion])
  @@index([clubId, status])
}

// -------------------------------------------------------------------------
// 12I. Platform resilience — circuit breaker state.
// state: CLOSED | OPEN | HALF_OPEN
// -------------------------------------------------------------------------
model CircuitBreakerState {
  id            String    @id @default(cuid())
  clubId        String?
  club          Club?     @relation(fields: [clubId], references: [id])
  resourceKey   String    @unique
  state         String    @default("CLOSED")
  failureCount  Int       @default(0)
  successCount  Int       @default(0)
  lastFailureAt DateTime?
  openedAt      DateTime?
  resetAt       DateTime?
  thresholdHint Int       @default(5)
  updatedAt     DateTime  @updatedAt

  @@index([clubId, state])
}

// =========================================================================
// PHASE 13 — Pilot readiness, imports, training, support, incidents
// =========================================================================

// -------------------------------------------------------------------------
// 13A. Pilot onboarding wizard
// -------------------------------------------------------------------------
// status: DRAFT | IN_PROGRESS | READY | GO_LIVE | POST_LAUNCH | CANCELLED
model PilotOnboardingProject {
  id                     String    @id @default(cuid())
  clubId                 String
  club                   Club      @relation(fields: [clubId], references: [id])
  name                   String
  status                 String    @default("DRAFT")
  targetGoLiveAt         DateTime?
  ownerUserId            String?
  createdByUserId        String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  completedAt            DateTime?
  goLiveApprovedAt       DateTime?
  goLiveApprovedByUserId String?

  steps    PilotOnboardingStep[]
  tasks    PilotOnboardingTask[]
  notes    PilotOnboardingNote[]
  blockers PilotOnboardingBlocker[]
  signoffs PilotGoLiveSignoff[]

  @@unique([clubId, name])
  @@index([status])
}

// status: PENDING | IN_PROGRESS | COMPLETED | BLOCKED | SKIPPED
model PilotOnboardingStep {
  id                String                 @id @default(cuid())
  clubId            String
  club              Club                   @relation(fields: [clubId], references: [id])
  projectId         String
  project           PilotOnboardingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepKey           String // "club_profile", "branding", ...
  label             String
  ordering          Int
  status            String                 @default("PENDING")
  dataJson          String? // step-specific payload (form values)
  completedAt       DateTime?
  completedByUserId String?
  updatedAt         DateTime               @updatedAt

  @@unique([projectId, stepKey])
  @@index([clubId, status])
}

// status: PENDING | IN_PROGRESS | DONE | BLOCKED
model PilotOnboardingTask {
  id          String                 @id @default(cuid())
  clubId      String
  club        Club                   @relation(fields: [clubId], references: [id])
  projectId   String
  project     PilotOnboardingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepKey     String?
  title       String
  description String?
  ownerUserId String?
  status      String                 @default("PENDING")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime               @default(now())

  @@index([projectId, status])
  @@index([clubId, status])
}

model PilotOnboardingNote {
  id        String                 @id @default(cuid())
  clubId    String
  club      Club                   @relation(fields: [clubId], references: [id])
  projectId String
  project   PilotOnboardingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body      String
  byUserId  String?
  createdAt DateTime               @default(now())

  @@index([projectId, createdAt])
}

// severity: LOW | MEDIUM | HIGH | CRITICAL
// status:   OPEN | RESOLVED | WONT_FIX
model PilotOnboardingBlocker {
  id               String                 @id @default(cuid())
  clubId           String
  club             Club                   @relation(fields: [clubId], references: [id])
  projectId        String
  project          PilotOnboardingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  severity         String                 @default("MEDIUM")
  title            String
  description      String?
  status           String                 @default("OPEN")
  openedAt         DateTime               @default(now())
  resolvedAt       DateTime?
  openedByUserId   String?
  resolvedByUserId String?

  @@index([projectId, status])
  @@index([clubId, status])
}

// status: PENDING | SIGNED | REJECTED
model PilotGoLiveSignoff {
  id             String                 @id @default(cuid())
  clubId         String
  club           Club                   @relation(fields: [clubId], references: [id])
  projectId      String
  project        PilotOnboardingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category       String // "FINANCE" | "OPS" | "MEMBERSHIP" | "SECURITY" | "EXECUTIVE"
  status         String                 @default("PENDING")
  signedAt       DateTime?
  signedByUserId String?
  notes          String?

  @@unique([projectId, category])
}

// -------------------------------------------------------------------------
// 13B. Data migration / imports
// -------------------------------------------------------------------------
// domain: MEMBERS | VENDORS | COA | OPENING_TRIAL_BALANCE | INVENTORY | EMPLOYEES | EVENTS | AR_HISTORY
// source: JONAS | CSV | XLSX | MANUAL
// status: DRAFT | VALIDATING | VALIDATED | COMMITTING | COMMITTED | FAILED | ROLLED_BACK
model ImportBatch {
  id                  String    @id @default(cuid())
  clubId              String
  club                Club      @relation(fields: [clubId], references: [id])
  domain              String
  source              String    @default("CSV")
  status              String    @default("DRAFT")
  fileName            String?
  totalRows           Int       @default(0)
  validRows           Int       @default(0)
  errorRows           Int       @default(0)
  committedRows       Int       @default(0)
  mappingJson         String? // { "Member #": "memberNumber", ... }
  optionsJson         String? // { "treatBlankAsZero": true, ... }
  dryRunAt            DateTime?
  committedAt         DateTime?
  rolledBackAt        DateTime?
  // Founder rule 2026-06-30 v14.5 — Trial Balance batch lifecycle.
  // When a newer TB batch commits, the prior LIVE batch becomes
  // SUPERSEDED: `supersededAt` stamps the moment and
  // `supersededByBatchId` points to the newer batch. The
  // superseded batch's ledger impact is reversed at the same time
  // so only the live batch's balances remain in the report.
  supersededAt        DateTime?
  supersededByBatchId String?
  // VOIDED is the "undo a committed import" path. `voidedAt`,
  // `voidedByUserId`, and `voidReason` are populated for both
  // manual voids AND for the auto-supersede path (the superseded
  // batch is not voided, but a manually-voided batch is). See
  // voidCommittedBatch() in src/lib/imports/index.ts.
  voidedAt            DateTime?
  voidedByUserId      String?
  voidReason          String?
  createdByUserId     String?
  committedByUserId   String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  rows   ImportRow[]
  errors ImportError[]

  @@index([clubId, domain, status])
  @@index([clubId, createdAt])
}

// status: PENDING | VALID | INVALID | IMPORTED | SKIPPED
model ImportRow {
  id                String      @id @default(cuid())
  clubId            String
  club              Club        @relation(fields: [clubId], references: [id])
  batchId           String
  batch             ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber         Int
  rawJson           String
  normalizedJson    String?
  status            String      @default("PENDING")
  errorMessage      String?
  createdEntityType String?
  createdEntityId   String?

  @@index([batchId, status])
  @@index([clubId, batchId])
}

model ImportError {
  id         String      @id @default(cuid())
  clubId     String
  club       Club        @relation(fields: [clubId], references: [id])
  batchId    String
  batch      ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber  Int
  code       String
  message    String
  columnName String?
  // Founder rule 2026-06-29 v12 — severity gate for duplicate
  // detection. ERROR blocks commit; WARNING surfaces in the UI
  // but doesn't fail validation. Defaults to ERROR so every
  // existing call site stays correct without edit.
  severity   String      @default("ERROR")
  createdAt  DateTime    @default(now())

  @@index([batchId])
}

// -------------------------------------------------------------------------
// 13C. Opening balances
