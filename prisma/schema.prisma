// ---------------------------------------------------------------------
// ClubProfile — per-tenant structured settings (1:1 with Club).
//
// Storage shape: a single row per club holding identity, address,
// contact, tax, fiscal, and accounting-default configuration. This is
// distinct from the legacy ClubSetting key/value table (used for ad-hoc
// scoped JSON blobs); ClubProfile is the canonical home for the
// structured fields the Admin → Club Settings form exposes.
//
// Tenant isolation:
//   - Unique on clubId enforces 1:1.
//   - All reads/writes flow through src/lib/clubs/profile.ts which calls
//     assertTenantOwned() before returning or mutating a row.
//   - The seven default-account ID fields are validated server-side to
//     ensure each chosen Account belongs to the same clubId (see
//     assertAccountsBelongToClub() in the service).
// ---------------------------------------------------------------------
model ClubProfile {
  id     String @id @default(cuid())
  clubId String @unique
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  // --- Identity ---------------------------------------------------------
  legalName          String?
  operatingName      String?
  yearFounded        Int?
  businessNumber     String?
  gstNumber          String?
  // Fiscal year end as month (1..12) + day-of-month (1..31). Stored as
  // two ints rather than a Date so the value is calendar-anchored and
  // doesn't drift across years.
  fiscalYearEndMonth Int?
  fiscalYearEndDay   Int?

  // --- Address & contact ------------------------------------------------
  mailingAddress      String?
  physicalAddress     String?
  // City + province/state stored as discrete fields (rather than parsed
  // from mailingAddress) so the cover-page identity line
  // ("CALGARY, ALBERTA · EST. 1974") can render reliably across clubs.
  city                String?
  provinceState       String?
  mainPhone           String?
  generalEmail        String?
  websiteUrl          String?
  primaryContactName  String?
  primaryContactTitle String?
  primaryContactEmail String?
  primaryContactPhone String?

  // --- Tax registration -------------------------------------------------
  // REGISTERED | NOT_REGISTERED | SMALL_SUPPLIER
  gstStatus          String?
  // MONTHLY | QUARTERLY | ANNUAL
  gstFilingFrequency String?
  // Percentage, e.g. 5.00 for 5% GST. SQLite stores Decimal via @db.Text
  // upstream; we use Decimal at the Prisma layer so service code keeps
  // exact arithmetic and Postgres migration carries the type through.
  defaultGstRatePct  Decimal?

  // --- Reporting --------------------------------------------------------
  // ISO 4217 (CAD, USD, ...).
  defaultCurrency String?

  // --- Reporting benchmarks --------------------------------------------
  // Equity stewardship CAGR benchmarks for the long-horizon Equity Value
  // Over Time chart (Chair's Dashboard, Section II). Stored in basis
  // points so the value is integer-safe (e.g. 600 = 6.00 %). NULL means
  // "use the platform default" inside the reporting service.
  //   - bestInClass : the upper benchmark line (peer top-quartile growth)
  //   - minRequired : the floor line (inflation parity + reserve maintenance)
  // Both lines are PROJECTIONS from the first historical year's actual
  // equity base, not free-standing data — see
  // src/lib/reporting/equity-history.ts.
  equityBenchmarkBestCagrBps Int?
  equityBenchmarkMinCagrBps  Int?

  // --- Accounting default accounts --------------------------------------
  // Stored as the Account.id string. Foreign-key relations are
  // intentionally NOT declared so this profile remains stable when an
  // Account is renumbered/replaced; the service layer enforces the
  // "must belong to current club" rule on every write.
  defaultArAccountId                  String?
  defaultApAccountId                  String?
  defaultRetainedEarningsAccountId    String?
  defaultCurrentYearEarningsAccountId String?
  defaultOperatingBankAccountId       String?
  defaultReserveBankAccountId         String?
  defaultMemberReceivablesAccountId   String?
  defaultSalesTaxPayableAccountId     String?

  // --- Metadata ---------------------------------------------------------
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([clubId])
}

// -------------------------------------------------------------------
// 2. User (auth principal)
// -------------------------------------------------------------------
// Auth model. Production hardening:
//   - status: ACTIVE | INVITED | LOCKED | DISABLED
//   - failedLoginCount / lockedUntil / lastLoginAt: brute-force defense + audit
//   - mfaEnabled / mfaSecret: MFA-ready (TOTP). Secret stored only when enabled.
//   - emailVerifiedAt: email-verification scaffold for invite + reset flows.
//
// Role assignment moved to UserClubRole (one user can have roles at multiple
// clubs). User.clubId is kept as a deprecated "primary club" convenience pointer
// — DO NOT use for authorization checks. Use UserClubRole + hasPermission()
// helpers in src/lib/rbac.ts.
model User {
  id               String    @id @default(cuid())
  clubId           String? // DEPRECATED — convenience pointer only. Use UserClubRole.
  club             Club?     @relation(fields: [clubId], references: [id])
  name             String
  email            String    @unique
  role             String // DEPRECATED — convenience. Use UserClubRole.roleKey.
  passwordHash     String
  status           String    @default("ACTIVE")
  emailVerifiedAt  DateTime?
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  memberId         String?   @unique
  member           Member?   @relation(fields: [memberId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  clubRoles                UserClubRole[]
  auditLogs                AuditLog[]
  reviewingApplicants      Applicant[]               @relation("ApplicantReviewer")
  postedCharges            Charge[]                  @relation("ChargePostedBy")
  voidedCharges            Charge[]                  @relation("ChargeVoidedBy")
  postedPayments           Payment[]                 @relation("PaymentPostedBy")
  voidedPayments           Payment[]                 @relation("PaymentVoidedBy")
  postedAdjustments        AccountAdjustment[]       @relation("AdjustmentPostedBy")
  voidedAdjustments        AccountAdjustment[]       @relation("AdjustmentVoidedBy")
  authoredAccountNotes     AccountNote[]
  // Phase 5
  golfProfessional         GolfProfessional?
  employee                 Employee?
  // Phase 11
  mfaFactors               MfaFactor[]
  recoveryCodes            RecoveryCode[]
  trustedDevices           TrustedDevice[]
  // Monthly Reporting Package archive — generator / publisher /
  // sender / recipient back-relations.
  generatedMonthlyPackages MonthlyPackage[]          @relation("MonthlyPackageGeneratedBy")
  publishedMonthlyPackages MonthlyPackage[]          @relation("MonthlyPackagePublishedBy")
  sentMonthlyPackages      MonthlyPackage[]          @relation("MonthlyPackageSentBy")
  monthlyPackageReceipts   MonthlyPackageRecipient[] @relation("MonthlyPackageRecipientUser")

  // Sprint 2 — Outlook / Work Intake reverse relations.
  ownedWorkIntakeItems      WorkIntakeItem[]          @relation("WorkIntakeOwner")
  resolvedWorkIntakeItems   WorkIntakeItem[]          @relation("WorkIntakeResolvedBy")
  overriddenClassifications WorkIntakeItem[]          @relation("WorkIntakeClassOverride")
  workIntakeActivity        WorkIntakeActivity[]      @relation("WorkIntakeActivityActor")
  apReviewOverrides         ApReviewOverride[]        @relation("ApReviewOverrideActor")
  workIntakeReads           WorkIntakeItemRead[]      @relation("WorkIntakeItemReadUser")
  mailboxConnections        MailboxConnection[]
  mailboxDisconnections     MailboxConnection[]       @relation("MailboxDisconnectedBy")
  mailboxAccesses           MailboxAccess[]           @relation("MailboxAccessUser")
  mailboxAccessGrants       MailboxAccess[]           @relation("MailboxAccessGrantedBy")
  mailboxAccessRevocations  MailboxAccess[]           @relation("MailboxAccessRevokedBy")
  mailboxOAuthTransactions  MailboxOAuthTransaction[] @relation("MailboxTransactionUser")

  // HR-1 (2026-08-16) — back-relations for User-actor pointers on
  // HR canonical tables. Every named relation has a matching
  // @relation() on the child side.
  createdEmployees            Employee[]                          @relation("EmployeeCreatedBy")
  authoredCompensationChanges EmployeeCompensation[]              @relation("EmployeeCompensationActor")
  uploadedEmployeeDocuments   EmployeeDocument[]                  @relation("EmployeeDocUploadedBy")
  issuedOnboardingInvitations EmployeeOnboardingInvitation[]      @relation("InvitationIssuedBy")
  initiatedOnboardingSessions EmployeeOnboardingSession[]         @relation("OnboardingInitiatedBy")
  approvedOnboardingSessions  EmployeeOnboardingSession[]         @relation("OnboardingApprovedBy")
  onboardingStateTransitions  EmployeeOnboardingStateTransition[] @relation("OnboardingTransitionActor")
}

// -------------------------------------------------------------------
// 2a. Role / Permission / RolePermission / UserClubRole
// -------------------------------------------------------------------
// Authoritative RBAC tables. Roles and permissions are data, not enums,
// so they can evolve without code changes (and so SUPER_ADMIN can configure
// permission packs per club in the future).
//
// Permission key format: "<domain>:<action>"  e.g. "members:write", "ap:approve".

model Role {
  key         String   @id // e.g. CLUB_ADMIN
  name        String
  description String?
  isSystem    Boolean  @default(true) // system roles cannot be deleted
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  userRoles   UserClubRole[]
}

model Permission {
  key         String   @id // e.g. "members:write"
  name        String
  description String?
  category    String // e.g. "MEMBER_MANAGEMENT"
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleKey       String
  permissionKey String
  role          Role       @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleKey, permissionKey])
  @@index([roleKey])
  @@index([permissionKey])
}

// One user can hold roles at multiple clubs. SUPER_ADMIN is represented with
// a row where clubId is null (the global SUPER_ADMIN club role) — checked
// specially by hasPermission.
model UserClubRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId    String? // null = global (SUPER_ADMIN)
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  roleKey   String
  role      Role     @relation(fields: [roleKey], references: [key])
  createdAt DateTime @default(now())

  @@unique([userId, clubId, roleKey])
  @@index([userId])
  @@index([clubId])
  @@index([roleKey])
}

// -------------------------------------------------------------------
// 2b. AuditLog
// -------------------------------------------------------------------
// Append-only audit trail. Code never updates or deletes these rows; we
// rely on DB-level safeguards in production (no UPDATE/DELETE grants on
// this table for the application role).
model AuditLog {
  id         String   @id @default(cuid())
  clubId     String? // null = global / Spectre admin actions
  club       Club?    @relation(fields: [clubId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. "application.approve"
  entityType String // e.g. "Applicant"
  entityId   String?
  beforeJson String? // serialized JSON snapshot
  afterJson  String?
  metaJson   String? // additional structured metadata
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([clubId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
}

// -------------------------------------------------------------------
// 3. Applicant
// -------------------------------------------------------------------
// applicationStatus: DRAFT | SUBMITTED | UNDER_REVIEW | PENDING_INFORMATION
//                  | APPROVED | DENIED | WAITLISTED | WITHDRAWN
// Transitions enforced by src/lib/services/application-state.ts.
model Applicant {
  id                 String  @id @default(cuid())
  clubId             String
  club               Club    @relation(fields: [clubId], references: [id])
  firstName          String
  lastName           String
  email              String
  phone              String?
  sponsorName        String?
  membershipCategory String?
  employmentInfo     String?

  // Phase 2A — extended profile data captured by multi-step apply
  address1       String?
  address2       String?
  city           String?
  provinceState  String?
  postalCode     String?
  country        String?
  dateOfBirth    DateTime?
  referralSource String?

  consentCreditCheck     Boolean @default(false)
  consentBackgroundCheck Boolean @default(false)
  applicationStatus      String  @default("DRAFT")
  creditScoreBand        String? // FUTURE: integrate real credit-check API
  internalNotes          String?
  denialReason           String?
  pendingInfoNote        String? // shown to applicant when status = PENDING_INFORMATION

  // Application fee handling — placeholder; payment processor adapter will
  // be wired in Phase 7.
  applicationFeeAmount Float?
  applicationFeePaidAt DateTime?
  applicationFeeRef    String? // external receipt / processor reference

  // Reviewer assignment & waitlist priority
  reviewerId       String?
  reviewer         User?   @relation("ApplicantReviewer", fields: [reviewerId], references: [id])
  waitlistPriority Int? // lower number = higher priority

  // Submission integrity / audit
  submittedAt        DateTime?
  signedSubmissionIp String?
  signedSubmissionUa String?
  lastReviewedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member      Member?
  household   ApplicationHouseholdMember[]
  documents   ApplicationDocument[]
  draftTokens ApplicationDraftToken[]
}

// Household composition captured during multi-step apply.
model ApplicationHouseholdMember {
  id           String    @id @default(cuid())
  clubId       String
  club         Club      @relation(fields: [clubId], references: [id])
  applicantId  String
  applicant    Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  relationship String // SPOUSE | PARTNER | CHILD | OTHER
  email        String?
  phone        String?
  dateOfBirth  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())

  @@index([applicantId])
}

// File metadata only. We never store the blob itself in this DB.
// `storageKey` is an opaque pointer to an S3-compatible object — the storage
// adapter is wired in Phase 7. `accessTokenSecret` is a per-document random
// value mixed into download URLs so a leaked id alone isn't enough.
model ApplicationDocument {
  id                String    @id @default(cuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id])
  applicantId       String
  applicant         Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  name              String
  storageKey        String // opaque storage pointer (S3 key placeholder)
  mimeType          String
  sizeBytes         Int
  uploadedAt        DateTime  @default(now())
  uploadedByUserId  String? // null when uploaded by the public applicant
  accessTokenSecret String // mixed into download URLs

  @@index([applicantId])
}

// Secure resume tokens for DRAFT applications. Token value is HMAC-derived
// (see src/lib/services/applications.ts) and stored hashed.
model ApplicationDraftToken {
  id          String    @id @default(cuid())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id])
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  email       String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([applicantId])
  @@index([email])
}

// -------------------------------------------------------------------
// 4. Member
// -------------------------------------------------------------------
// status: ONBOARDING | ACTIVE | SUSPENDED | INACTIVE | WAITLIST
// paymentMethodStatus: NONE | PRIMARY_ON_FILE | PRIMARY_AND_BACKUP
// accessStatus: FULL_ACCESS | CHARGE_ACCOUNT_SUSPENDED | TEE_SHEET_SUSPENDED | FULL_SUSPENSION
model Member {
  id                    String     @id @default(cuid())
  clubId                String
  club                  Club       @relation(fields: [clubId], references: [id])
  applicantId           String?    @unique
  applicant             Applicant? @relation(fields: [applicantId], references: [id])
  memberNumber          String
  firstName             String
  lastName              String
  email                 String
  phone                 String?
  // Phase 18 — admin-editable contact / personal info on the primary member.
  // Address is single-line free text fields rather than a normalized table:
  // members usually have one mailing address, and the data shape mirrors
  // what we already accept on Applicant intake and household members.
  dateOfBirth           DateTime?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  postalCode            String?
  country               String?
  // Phase 20 (Member Database, 2026-08-15) — extended demographic
  // fields for the admin Member Profile so a founder can render a
  // Tucker-Hersam-style record without a second table. All optional
  // so no existing tenant is invalidated by the migration.
  middleName            String?
  nickname              String?
  salutation            String?
  gender                String?
  homePhone             String?
  profileImageUrl       String?
  status                String     @default("ONBOARDING")
  joinDate              DateTime?
  membershipCategory    String?
  paymentMethodStatus   String     @default("NONE")
  accessStatus          String     @default("FULL_ACCESS")
  // Phase 2B — onboarding lifecycle
  onboardingStartedAt   DateTime?
  onboardingCompletedAt DateTime?
  createdAt             DateTime   @default(now())

  user                         User?
  account                      MemberAccount?
  charges                      Charge[]
  payments                     Payment[]
  paymentMethods               PaymentMethod[]
  financingAgreements          FinancingAgreement[]
  collectionNotices            CollectionNotice[]
  preferences                  MemberPreference?
  widgets                      DashboardWidget[]
  registrations                EventRegistration[]
  household                    MemberHouseholdMember[]
  documents                    MemberDocument[]
  checklistItems               OnboardingChecklistItem[]
  incentiveCredits             IncentiveCredit[]
  adjustments                  AccountAdjustment[]
  accountNotes                 AccountNote[]
  paymentPromises              PaymentPromise[]
  disputes                     Dispute[]
  statements                   Statement[]
  // Phase 5
  lessonBookings               LessonBooking[]               @relation("LessonBookingMember")
  privateEventBookings         PrivateEventBooking[]         @relation("PrivateEventMember")
  // Phase 7
  posSales                     POSSale[]                     @relation("POSSaleMember")
  posChecks                    POSCheck[]                    @relation("POSCheckMember")
  // Phase 8
  teeBookings                  TeeTimeBooking[]              @relation("TeeBookingMember")
  teeLotteryEntries            TeeLotteryEntry[]             @relation("TeeLotteryEntryMember")
  teeTimePlayers               TeeTimePlayer[]               @relation("TeeTimePlayerMember")
  // Phase 9
  tournamentRegistrations      TournamentRegistration[]      @relation("TournamentRegistrationMember")
  tournamentScores             TournamentScore[]             @relation("TournamentScoreMember")
  webPushSubscriptions         WebPushSubscription[]         @relation("PushSubscriptionMember")
  // Phase 18B
  hospitalitySurveyInvitations HospitalitySurveyInvitation[] @relation("HospitalitySurveyInvitationMember")
  hospitalitySurveyResponses   HospitalitySurveyResponse[]   @relation("HospitalitySurveyResponseMember")
  // Phase 18C
  diningReservations           DiningReservation[]           @relation("DiningReservationMember")
  // Phase 18E
  posSettlementGroups          POSSettlementGroup[]          @relation("POSSettlementGroupMember")
  // Phase 18F
  posCheckSeats                POSCheckSeat[]                @relation("POSCheckSeatMember")
  // Step 19 — QR-code payment lifecycle.
  posQRPayments                POSQRPayment[]                @relation("POSQRPaymentMember")
  // Governance — Board & Committees roster (person-specific,
  // term-specific records; one Member can hold multiple historical
  // BoardRoles and currently active committee memberships).
  boardRoles                   BoardRole[]                   @relation("BoardRoleMember")
  // HR-1 — optional employee link when a member is also an employee.
  // 1:1 via Employee.memberId (unique). Same-tenant invariant is
  // service-enforced.
  employee                     Employee?                     @relation("MemberAsEmployee")
  // Phase 20 (Member Database, 2026-08-15) — many-to-many segmentation
  // groups + a per-club extensible custom-field payload.
  groupAssignments             MemberGroupAssignment[]
  customFieldValues            MemberCustomFieldValue[]

  // Step 16 — member numbers are unique INSIDE a club. Two different
  // clubs can both have memberNumber "1432"; tenant-scoped lookup
  // resolves them independently. Prior schema had no constraint at
  // all, which allowed silent duplicates inside one club too.
  @@unique([clubId, memberNumber])
  // Phase 13I — pilot-scale search/list pages routinely filter on clubId+status
  // and on lastName/email when an implementation team is cleaning up imports.
  @@index([clubId, status])
  @@index([clubId, lastName])
  @@index([clubId, email])
  @@index([clubId, membershipCategory])
}

// -------------------------------------------------------------------
// 5. MemberAccount
// -------------------------------------------------------------------
// Denormalized cache of the member's ledger. ALL writes go through
// src/lib/services/ar.ts > recomputeAccount(). UI must never compute these.
// `oneTwentyDayBalance` added in Phase 2D (spec requires 120+ bucket).
model MemberAccount {
  id                  String    @id @default(cuid())
  clubId              String
  club                Club      @relation(fields: [clubId], references: [id])
  memberId            String    @unique
  member              Member    @relation(fields: [memberId], references: [id])
  currentBalance      Float     @default(0)
  thirtyDayBalance    Float     @default(0)
  sixtyDayBalance     Float     @default(0)
  ninetyDayBalance    Float     @default(0)
  oneTwentyDayBalance Float     @default(0)
  creditBalance       Float     @default(0)
  lastPaymentDate     DateTime?
  lastRecomputedAt    DateTime?
  createdAt           DateTime  @default(now())

  charges     Charge[]
  payments    Payment[]
  adjustments AccountAdjustment[]
}

// -------------------------------------------------------------------
// 6. Charge
// -------------------------------------------------------------------
// category: DUES | PRO_SHOP | FOOD_BEVERAGE | EVENT | FINANCING |
//           INITIATION_FEE | CAPITAL_ASSESSMENT | ADJUSTMENT | OTHER
// status:   POSTED | VOIDED | REVERSED
//
// VOIDED  = posted then immediately voided (e.g. data-entry error caught same day).
// REVERSED = a contra-Charge was posted that offsets this one. The contra row
//            has reversesId pointing back here.
// Voids/reversals are NEVER deletes; both the original and the contra remain.
model Charge {
  id              String        @id @default(cuid())
  clubId          String
  club            Club          @relation(fields: [clubId], references: [id])
  memberId        String
  member          Member        @relation(fields: [memberId], references: [id])
  accountId       String
  account         MemberAccount @relation(fields: [accountId], references: [id])
  description     String
  category        String
  amount          Float
  transactionDate DateTime      @default(now())
  dueDate         DateTime? // for aging — defaults to transactionDate at post time
  status          String        @default("POSTED")

  postedByUserId String?
  postedBy       User?          @relation("ChargePostedBy", fields: [postedByUserId], references: [id])
  voidedAt       DateTime?
  voidedByUserId String?
  voidedBy       User?          @relation("ChargeVoidedBy", fields: [voidedByUserId], references: [id])
  voidReason     String?
  reversesId     String?        @unique
  reverses       Charge?        @relation("ChargeReversal", fields: [reversesId], references: [id])
  reversedBy     Charge?        @relation("ChargeReversal")
  // Phase 5 — lesson back-relation (the Charge produced by a lesson completion)
  lessonBooking  LessonBooking? @relation("LessonMemberCharge")
  // Phase 7 — POS-back-link (the Charge produced by a POS sale charged to member)
  posSale        POSSale?       @relation("POSSaleARCharge")

  @@index([memberId, transactionDate])
  @@index([clubId, status])
}

// -------------------------------------------------------------------
// 7. Payment
// -------------------------------------------------------------------
// method: CREDIT_CARD | EFT | CHEQUE | CASH | OTHER
// status: SUCCESS | FAILED | PENDING | VOIDED | REVERSED | REFUNDED
//
// FAILED       = processor declined (card declined, NSF, etc).
// VOIDED       = posted then voided same day (data-entry error).
// REVERSED     = contra-Payment was posted (e.g. chargeback). Original remains.
// REFUNDED     = refunded via AccountAdjustment + Payment (paymentMethod refund flow).
model Payment {
  id              String         @id @default(cuid())
  clubId          String
  club            Club           @relation(fields: [clubId], references: [id])
  memberId        String
  member          Member         @relation(fields: [memberId], references: [id])
  accountId       String
  account         MemberAccount  @relation(fields: [accountId], references: [id])
  amount          Float
  paymentDate     DateTime       @default(now())
  method          String
  status          String         @default("SUCCESS")
  failureReason   String?
  // Processor metadata — tokens only, never PAN/bank data.
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  processorRef    String? // gateway transaction id placeholder
  retryOfId       String?        @unique
  retryOf         Payment?       @relation("PaymentRetry", fields: [retryOfId], references: [id])
  retriedBy       Payment?       @relation("PaymentRetry")
  reversesId      String?        @unique
  reverses        Payment?       @relation("PaymentReversal", fields: [reversesId], references: [id])
  reversedBy      Payment?       @relation("PaymentReversal")

  postedByUserId String?
  postedBy       User?     @relation("PaymentPostedBy", fields: [postedByUserId], references: [id])
  voidedAt       DateTime?
  voidedByUserId String?
  voidedBy       User?     @relation("PaymentVoidedBy", fields: [voidedByUserId], references: [id])
  voidReason     String?

  @@index([memberId, paymentDate])
  @@index([clubId, status])
}

// -------------------------------------------------------------------
// 8. PaymentMethod
// -------------------------------------------------------------------
// type: CREDIT_CARD | EFT
// status: ACTIVE | EXPIRED | FAILED | REMOVED
//
// NOTE: We only store tokenized metadata. The processor adapter (Stripe / Moneris
// / Payfirma — Phase 7) returns a `processorToken` after card collection on its
// hosted page; that token alone is meaningless outside the processor. Last four,
// expiry hint, and brand are display-only and never sensitive.
model PaymentMethod {
  id             String    @id @default(cuid())
  clubId         String
  club           Club      @relation(fields: [clubId], references: [id])
  memberId       String
  member         Member    @relation(fields: [memberId], references: [id])
  type           String
  brand          String? // VISA | MASTERCARD | AMEX | ... (display only)
  nickname       String?
  lastFour       String?
  expiryMonth    Int? // 1-12
  expiryYear     Int? // 4-digit
  processorToken String? // opaque vault id — NEVER a real PAN
  isPrimary      Boolean   @default(false)
  isBackup       Boolean   @default(false)
  status         String    @default("ACTIVE")
  lastFailedAt   DateTime?
  failedCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payments Payment[]
}

// -------------------------------------------------------------------
// 9. FinancingAgreement
// -------------------------------------------------------------------
// status: DRAFT | ACTIVE | PAID_OFF | DEFAULTED
// status: DRAFT | ACTIVE | PAID_OFF | DEFAULTED | CANCELLED
model FinancingAgreement {
  id                String             @id @default(cuid())
  clubId            String
  club              Club               @relation(fields: [clubId], references: [id])
  memberId          String
  member            Member             @relation(fields: [memberId], references: [id])
  agreementNumber   String? // e.g. SS-FIN-2024-0007 (assigned at activation)
  principalAmount   Float
  interestRate      Float // annual decimal e.g. 0.065
  termMonths        Int
  paymentFrequency  String             @default("MONTHLY")
  monthlyPayment    Float
  totalInterest     Float
  startDate         DateTime
  status            String             @default("DRAFT")
  prepaymentAllowed Boolean            @default(true)
  paidOffAt         DateTime?
  defaultedAt       DateTime?
  signedAt          DateTime?
  signatureName     String?
  signedIp          String?
  signedUa          String?
  // Pointer to the active promissory-note revision rendered for the member.
  currentDocumentId String?            @unique
  currentDocument   FinancingDocument? @relation("FinancingActiveDocument", fields: [currentDocumentId], references: [id])

  schedule  FinancingPaymentSchedule[]
  documents FinancingDocument[]        @relation("FinancingAllDocuments")
  payments  FinancingPayment[]
}

// Versioned promissory-note documents. The bytes themselves live in object
// storage (Phase 7); we keep a hash + version + signed snapshot here so the
// audit trail proves what the member actually accepted.
model FinancingDocument {
  id            String              @id @default(cuid())
  clubId        String
  club          Club                @relation(fields: [clubId], references: [id])
  agreementId   String
  agreement     FinancingAgreement  @relation("FinancingAllDocuments", fields: [agreementId], references: [id], onDelete: Cascade)
  version       Int
  storageKey    String? // S3-style key; null until generated by adapter
  contentHash   String? // hex SHA-256 of the rendered document
  renderedJson  String // rendered template + values, audit-friendly
  signedAt      DateTime?
  signatureName String?
  createdAt     DateTime            @default(now())
  activeFor     FinancingAgreement? @relation("FinancingActiveDocument")

  @@unique([agreementId, version])
  @@index([clubId, agreementId])
}

// Allocations of an inbound payment to one or more scheduled installments.
// Lets us support partial / over / prepayment cleanly.
model FinancingPayment {
  id               String                   @id @default(cuid())
  clubId           String
  club             Club                     @relation(fields: [clubId], references: [id])
  agreementId      String
  agreement        FinancingAgreement       @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  scheduleId       String
  schedule         FinancingPaymentSchedule @relation(fields: [scheduleId], references: [id])
  amountApplied    Float
  principalApplied Float
  interestApplied  Float
  paymentDate      DateTime                 @default(now())
  source           String // MEMBER_AR | DIRECT | PROCESSOR
  createdAt        DateTime                 @default(now())

  @@index([agreementId])
}

// -------------------------------------------------------------------
// 10. FinancingPaymentSchedule
// -------------------------------------------------------------------
// status: SCHEDULED | PAID | PARTIAL | MISSED | WAIVED
model FinancingPaymentSchedule {
  id                   String             @id @default(cuid())
  clubId               String
  club                 Club               @relation(fields: [clubId], references: [id])
  financingAgreementId String
  agreement            FinancingAgreement @relation(fields: [financingAgreementId], references: [id])
  paymentNumber        Int
  dueDate              DateTime
  paymentAmount        Float
  principalAmount      Float
  interestAmount       Float
  remainingBalance     Float
  amountPaid           Float              @default(0)
  status               String             @default("SCHEDULED")

  payments FinancingPayment[]

  @@index([financingAgreementId, paymentNumber])
}

// -------------------------------------------------------------------
// 11. CollectionNotice
// -------------------------------------------------------------------
// noticeType: CARD_DECLINED | PAP_FAILED | OVER_30 | OVER_60 | OVER_90
//           | OVER_120 | SUSPENSION_WARNING | FINAL_NOTICE | FRIENDLY_REMINDER
// status:   DRAFT | SENT | ACKNOWLEDGED | RESOLVED
model CollectionNotice {
  id         String                    @id @default(cuid())
  clubId     String
  club       Club                      @relation(fields: [clubId], references: [id])
  memberId   String
  member     Member                    @relation(fields: [memberId], references: [id])
  noticeType String
  message    String
  status     String                    @default("DRAFT")
  sentAt     DateTime?
  createdAt  DateTime                  @default(now())
  // Phase 2D — link to template + collection stage
  templateId String?
  template   CollectionNoticeTemplate? @relation(fields: [templateId], references: [id])
  stageKey   String? // e.g. STAGE_30, STAGE_60, STAGE_FINAL

  @@index([memberId, createdAt])
  @@index([clubId, status])
}

// Editable per-club notice templates. Body is rendered against a small
// handlebars-style variable set (member.firstName, member.balance, etc.) —
// see src/lib/services/collections.ts > renderTemplate().
model CollectionNoticeTemplate {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  key         String // FRIENDLY_REMINDER | OVER_30 | OVER_60 | ...
  name        String
  subject     String
  body        String
  isSystem    Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  notices CollectionNotice[]

  @@unique([clubId, key])
}

// Configurable collection stages. The default-seeded stages match the typical
// dunning ladder; admins can edit thresholds and notice templates per club.
model CollectionStage {
  id                       String   @id @default(cuid())
  clubId                   String
  club                     Club     @relation(fields: [clubId], references: [id])
  key                      String // STAGE_30 | STAGE_60 | STAGE_90 | STAGE_120 | STAGE_FINAL
  name                     String
  description              String?
  triggerAgeDays           Int // e.g. 30 — member with any unpaid charge older than this is eligible
  defaultTemplateKey       String?
  // Optional auto-actions:
  autoSuspendChargeAccount Boolean  @default(false)
  autoSuspendTeeSheet      Boolean  @default(false)
  sortOrder                Int      @default(0)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  actions CollectionAction[]

  @@unique([clubId, key])
}

// Audit-friendly record of a collections action that was taken.
model CollectionAction {
  id        String           @id @default(cuid())
  clubId    String
  club      Club             @relation(fields: [clubId], references: [id])
  memberId  String
  stageId   String?
  stage     CollectionStage? @relation(fields: [stageId], references: [id])
  action    String // NOTICE_SENT | SUSPENDED_CHARGE | SUSPENDED_TEE | RESTORED | PROMISE_RECORDED | PROMISE_BROKEN
  meta      String? // JSON blob
  createdAt DateTime         @default(now())

  @@index([memberId, createdAt])
  @@index([clubId, createdAt])
}

// -------------------------------------------------------------------
// 12. ClubMilestone
// -------------------------------------------------------------------
model ClubMilestone {
  id          String  @id @default(cuid())
  clubId      String
  club        Club    @relation(fields: [clubId], references: [id])
  year        Int
  title       String
  description String
  mediaUrl    String?
  sortOrder   Int     @default(0)
}

// -------------------------------------------------------------------
// 13. MemberPreference
// -------------------------------------------------------------------
model MemberPreference {
  id                           String   @id @default(cuid())
  clubId                       String
  club                         Club     @relation(fields: [clubId], references: [id])
  memberId                     String   @unique
  member                       Member   @relation(fields: [memberId], references: [id])
  interestedGolf               Boolean  @default(false)
  interestedDining             Boolean  @default(false)
  interestedEvents             Boolean  @default(false)
  interestedLeagues            Boolean  @default(false)
  interestedPracticeFacilities Boolean  @default(false)
  wantsProShopOffers           Boolean  @default(false)
  wantsTeeTimeAlerts           Boolean  @default(false)
  // Phase 2C — communication / notification preferences
  emailStatements              Boolean  @default(true)
  emailAccountAlerts           Boolean  @default(true)
  emailEventAnnouncements      Boolean  @default(true)
  emailGeneralAnnouncements    Boolean  @default(true)
  smsPaymentAlerts             Boolean  @default(false)
  smsTeeTimeAlerts             Boolean  @default(false)
  updatedAt                    DateTime @updatedAt
}

// -------------------------------------------------------------------
// 14. DashboardWidget
// -------------------------------------------------------------------
model DashboardWidget {
  id         String  @id @default(cuid())
  clubId     String
  club       Club    @relation(fields: [clubId], references: [id])
  memberId   String
  member     Member  @relation(fields: [memberId], references: [id])
  widgetType String
  enabled    Boolean @default(true)
  sortOrder  Int     @default(0)
  // COMPACT (half-height tile, minimum info) |
  // DETAILED (full-height tile, fuller info).
  // Members can toggle each widget's size from the hover toolbar.
  size       String  @default("DETAILED")
}

// -------------------------------------------------------------------
// 15. ClubEvent
// -------------------------------------------------------------------
// status: DRAFT | PUBLISHED | CANCELLED | CLOSED
model ClubEvent {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  title       String
  description String
  eventDate   DateTime
  capacity    Int      @default(0)
  price       Float    @default(0)
  status      String   @default("PUBLISHED")

  registrations EventRegistration[]
}

// -------------------------------------------------------------------
// 16. EventRegistration
// -------------------------------------------------------------------
// status: REGISTERED | WAITLIST | CANCELLED
model EventRegistration {
  id             String    @id @default(cuid())
  clubId         String
  club           Club      @relation(fields: [clubId], references: [id])
  eventId        String
  event          ClubEvent @relation(fields: [eventId], references: [id])
  memberId       String
  member         Member    @relation(fields: [memberId], references: [id])
  status         String    @default("REGISTERED")
  numberOfGuests Int       @default(0)
  amountCharged  Float     @default(0)
  createdAt      DateTime  @default(now())
}

// -------------------------------------------------------------------
// PHASE 2B — Onboarding
// -------------------------------------------------------------------

// Per-member onboarding checklist. Items are seeded from a club's
// default template (Phase 2B service) when a member is created.
// itemKey: WELCOME | TIMELINE | ORIENTATION | PAYMENT_METHOD | PREFERENCES
//        | DASHBOARD | INCENTIVES | COMPLETED
model OnboardingChecklistItem {
  id          String    @id @default(cuid())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id])
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  itemKey     String
  title       String
  description String?
  required    Boolean   @default(true)
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([memberId, itemKey])
  @@index([memberId])
}

// Joining incentive credits (initiation discount, referral credit, etc.)
// applied as a Charge category=ADJUSTMENT credit or used to reduce a
// FinancingAgreement principal — depending on `appliedTo`.
// appliedTo: AR_ACCOUNT | FINANCING | NONE_YET
// status:    PENDING | APPLIED | EXPIRED | CANCELLED
model IncentiveCredit {
  id        String    @id @default(cuid())
  clubId    String
  club      Club      @relation(fields: [clubId], references: [id])
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id])
  reason    String // e.g. "Founders' incentive 2024", "Sponsor referral credit"
  amount    Float
  appliedTo String    @default("NONE_YET")
  appliedAt DateTime?
  expiresAt DateTime?
  status    String    @default("PENDING")
  createdAt DateTime  @default(now())
}

// -------------------------------------------------------------------
// PHASE 2C — Member Hub additions
// -------------------------------------------------------------------

// Club-level widget enable/disable. Source of truth for which widgets a
// club exposes; per-member ordering still lives in DashboardWidget.
model ClubWidgetConfig {
  id         String  @id @default(cuid())
  clubId     String
  club       Club    @relation(fields: [clubId], references: [id])
  widgetType String
  enabled    Boolean @default(true)
  sortOrder  Int     @default(0)

  @@unique([clubId, widgetType])
}

// Member-side household members (kept separate from ApplicationHouseholdMember
// because households evolve post-join).
// relationship: SPOUSE | PARTNER | CHILD | OTHER
model MemberHouseholdMember {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  memberId        String
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  relationship    String
  email           String?
  phone           String?
  dateOfBirth     DateTime?
  // Phase 20 (Member Database, 2026-08-15) — same optional demographic
  // fields as Member so the admin Member Profile person-switcher renders
  // one Basic Details grid for every person on the membership.
  middleName      String?
  nickname        String?
  salutation      String?
  gender          String?
  homePhone       String?
  profileImageUrl String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([memberId])
}

// ---------------------------------------------------------------------------
// Phase 20 — Member Database + Member Profile (2026-08-15)
// ---------------------------------------------------------------------------
// Segmentation groups (Sailing Approved, Tennis, Wednesday Night Racing…).
// Per-club, unique by name inside a club. The many-to-many junction is
// `MemberGroupAssignment` — kept as an explicit model rather than an
// implicit `@relation` so we can carry auditing fields (assignedAt +
// assignedByUserId) without another schema change later.
model MemberGroup {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id])
  name      String
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments MemberGroupAssignment[]

  @@unique([clubId, name])
  @@index([clubId, sortOrder])
}

model MemberGroupAssignment {
  id               String      @id @default(cuid())
  clubId           String
  club             Club        @relation(fields: [clubId], references: [id])
  memberId         String
  member           Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  groupId          String
  group            MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignedAt       DateTime    @default(now())
  assignedByUserId String?

  @@unique([memberId, groupId])
  @@index([clubId, groupId])
  @@index([memberId])
}

// Extensible custom-fields per club (Resignation, Interested in RC?, …).
// Modelled as `Definition` + sparse `Value` — a single member row does
// not carry a nullable column for every conceivable field, and adding a
// new club-defined field is a data write rather than a migration.
//
// `kind` is a UI-hint discriminator: TEXT | LONG_TEXT | BOOLEAN | DATE |
// NUMBER | SELECT. All values are stored as a single `valueText` string
// so the schema stays portable across SQLite (staging + dev) and
// Postgres (production); typed parsing is a client concern.
model MemberCustomFieldDefinition {
  id          String    @id @default(cuid())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id])
  key         String // stable snake_case identifier
  label       String // founder-facing label
  kind        String    @default("TEXT")
  helpText    String?
  optionsJson String? // JSON list for SELECT
  sortOrder   Int       @default(100)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  values MemberCustomFieldValue[]

  @@unique([clubId, key])
  @@index([clubId, sortOrder])
}

model MemberCustomFieldValue {
  id              String                      @id @default(cuid())
  clubId          String
  club            Club                        @relation(fields: [clubId], references: [id])
  memberId        String
  member          Member                      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  definitionId    String
  definition      MemberCustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  valueText       String?
  updatedAt       DateTime                    @updatedAt
  updatedByUserId String?

  @@unique([memberId, definitionId])
  @@index([clubId, definitionId])
}

// Member-facing documents (statements, forms, signed agreements).
// kind: STATEMENT | SIGNED_AGREEMENT | FORM | OTHER
model MemberDocument {
  id              String   @id @default(cuid())
  clubId          String
  club            Club     @relation(fields: [clubId], references: [id])
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind            String
  name            String
  storageKey      String? // S3-style key, null when document is a DB-only artifact (e.g. computed statement)
  mimeType        String?
  sizeBytes       Int?
  metaJson        String?
  visibleToMember Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([memberId, kind])
}

// Club-wide announcements visible in the member hub.
// audience: ALL_MEMBERS | ACTIVE_ONLY | SPECIFIC_CATEGORY (Phase 3+)
// HR-2C Fore! Announcements (2026-08-27) — extended for tenant-
// authored announcements shown on the Employee Portal Fore! card.
// Also usable by a future Member Portal surface (audience MEMBER
// or BOTH) — this is the canonical announcement model; no
// parallel EmployeeAnnouncement architecture.
//
// Every write goes through `src/lib/announcements.ts` (permission
// + posting-guard + audit). Read paths filter on: `isPublished`
// + `publishedAt <= now` + (`expiresAt IS NULL OR expiresAt > now`)
// + audience.
model ClubAnnouncement {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  title           String
  body            String
  // "EMPLOYEE" | "MEMBER" | "BOTH". Legacy default "ALL_MEMBERS"
  // preserved so any historical rows survive the migration; the
  // service normalises unknown values to "EMPLOYEE".
  audience        String    @default("EMPLOYEE")
  // Draft/published lifecycle. `isPublished=false` = draft (admin-
  // only). `publishedAt` gates when a published row becomes visible.
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  expiresAt       DateTime?
  isPinned        Boolean   @default(false)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdByUserId String?
  updatedByUserId String?

  @@index([clubId, publishedAt])
  @@index([clubId, isPublished])
  @@index([clubId, audience])
  @@index([clubId, expiresAt])
}

// -------------------------------------------------------------------
// PHASE 2D — AR engine adjuncts
// -------------------------------------------------------------------

// Non-payment movements on a member's account: credits issued, write-offs,
// transfers, refunds. Adjustments are immutable; mistakes are voided and
// re-posted, never edited.
// type:   CREDIT | DEBIT | WRITE_OFF | REFUND | TRANSFER
// status: POSTED | VOIDED
model AccountAdjustment {
  id              String        @id @default(cuid())
  clubId          String
  club            Club          @relation(fields: [clubId], references: [id])
  memberId        String
  member          Member        @relation(fields: [memberId], references: [id])
  accountId       String
  account         MemberAccount @relation(fields: [accountId], references: [id])
  type            String
  amount          Float // positive number; sign is implied by type
  description     String
  category        String? // optional GL hint (e.g. WRITE_OFF, INCENTIVE_CREDIT)
  transactionDate DateTime      @default(now())
  status          String        @default("POSTED")
  postedByUserId  String?
  postedBy        User?         @relation("AdjustmentPostedBy", fields: [postedByUserId], references: [id])
  voidedAt        DateTime?
  voidedByUserId  String?
  voidedBy        User?         @relation("AdjustmentVoidedBy", fields: [voidedByUserId], references: [id])
  voidReason      String?

  @@index([memberId, transactionDate])
  @@index([clubId, status])
}

// Notes admins add to a member's account. Visible in the admin Member 360.
model AccountNote {
  id           String   @id @default(cuid())
  clubId       String
  club         Club     @relation(fields: [clubId], references: [id])
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  authorUserId String?
  author       User?    @relation(fields: [authorUserId], references: [id])
  body         String
  pinned       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([memberId, createdAt])
}

// Member promise-to-pay tracking.
// status: ACTIVE | KEPT | BROKEN | CANCELLED
model PaymentPromise {
  id               String    @id @default(cuid())
  clubId           String
  club             Club      @relation(fields: [clubId], references: [id])
  memberId         String
  member           Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  promisedAmount   Float
  promisedDate     DateTime
  notes            String?
  status           String    @default("ACTIVE")
  recordedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([memberId, status])
}

// Billing disputes raised by a member.
// status: OPEN | UNDER_REVIEW | RESOLVED_IN_FAVOR_OF_MEMBER | RESOLVED_IN_FAVOR_OF_CLUB | CANCELLED
model Dispute {
  id          String    @id @default(cuid())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id])
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  chargeId    String? // optional link to the disputed charge
  amount      Float
  description String
  status      String    @default("OPEN")
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([memberId, status])
}

// Snapshot of a generated statement. The lines are denormalized into linesJson
// so a statement remains stable even if charges are later voided/reversed.
// status: DRAFT | ISSUED | VOIDED
model Statement {
  id               String   @id @default(cuid())
  clubId           String
  club             Club     @relation(fields: [clubId], references: [id])
  memberId         String
  member           Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  periodStart      DateTime
  periodEnd        DateTime
  openingBalance   Float
  closingBalance   Float
  totalCharges     Float
  totalPayments    Float
  totalAdjustments Float
  agingCurrent     Float
  aging30          Float
  aging60          Float
  aging90          Float
  aging120         Float
  linesJson        String // [{date, type, description, amount, runningBalance}]
  messageBody      String?
  status           String   @default("ISSUED")
  issuedAt         DateTime @default(now())
  issuedByUserId   String?

  @@unique([memberId, periodStart, periodEnd])
  @@index([clubId, issuedAt])
}

// =========================================================================
// PHASE 3 — ACCOUNTING CORE
// =========================================================================
// Design rules:
//   - Every model is tenant-scoped via clubId.
//   - All monetary fields are Decimal. Use src/lib/accounting/decimal.ts
//     helpers to convert at the AR<->GL boundary and to format for display.
//   - Posted-state rows are immutable. Mistakes are corrected via void
//     (pre-post only) or reverse (contra entry; original transitions to
//     REVERSED but stays in place).
//   - Period locks are enforced by src/lib/accounting/periods.ts and consulted
//     by the posting engine; the schema does not encode the constraint.

// -------------------------------------------------------------------------
// Departments & Cost Centers
// -------------------------------------------------------------------------
// Cost-allocation dimensions on JournalEntryLine. Optional — a JE line may
// have neither, a department only, or a department + cost center.
model Department {
  id                 String       @id @default(cuid())
  clubId             String
  club               Club         @relation(fields: [clubId], references: [id])
  code               String
  name               String
  description        String?
  isActive           Boolean      @default(true)
  sortOrder          Int          @default(0)
  parentDepartmentId String?
  parent             Department?  @relation("DepartmentTree", fields: [parentDepartmentId], references: [id])
  children           Department[] @relation("DepartmentTree")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  costCenters        CostCenter[]
  journalLines       JournalEntryLine[]
  accountDefaults    Account[]
  accountDepartments AccountDepartment[]
  vendorDefaults     Vendor[]            @relation("VendorDefaultDepartment")
  apInvoices         APInvoice[]         @relation("APInvoiceDepartment")
  apInvoiceLines     APInvoiceLine[]     @relation("APLineDepartment")
  // Phase 5
  invLocations       InventoryLocation[] @relation("InvLocationDepartment")
  employees          Employee[]          @relation("EmployeeDepartment")
  positions          EmployeePosition[]  @relation("PositionDepartment")
  payrollTimeApprovals PayrollDepartmentTimeApproval[] @relation("DepartmentPayrollTimeApprovals")
  timesheetEntries   TimesheetEntry[]    @relation("TimesheetEntryDepartment")
  payrollLines       PayrollLine[]       @relation("PayrollLineDepartment")
  labourBudgets      LabourBudget[]      @relation("LabourBudgetDepartment")
  capitalAssets      CapitalAsset[]      @relation("CapitalAssetDepartment")
  budgetLines        BudgetLine[]        @relation("BudgetLineDepartment")
  forecastLines      ForecastLine[]      @relation("ForecastLineDepartment")
  // Phase 7
  posLocations       POSLocation[]       @relation("POSLocationDepartment")
  posSales           POSSale[]           @relation("POSSaleDepartment")

  @@unique([clubId, code])
  @@index([clubId, isActive])
}

model CostCenter {
  id           String      @id @default(cuid())
  clubId       String
  club         Club        @relation(fields: [clubId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  code         String
  name         String
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  journalLines   JournalEntryLine[]
  apInvoiceLines APInvoiceLine[]    @relation("APLineCostCenter")

  @@unique([clubId, code])
  @@index([clubId, isActive])
}

// -------------------------------------------------------------------------
// Financial-statement grouping tree.
// -------------------------------------------------------------------------
// Accounts roll up to a FinancialStatementGroup, which roll up to parent
// groups. The report engine uses this tree to render the BS/IS hierarchies
// without hardcoding account-number ranges.
// statement: BALANCE_SHEET | INCOME_STATEMENT | CASH_FLOW
model FinancialStatementGroup {
  id              String                    @id @default(cuid())
  clubId          String
  club            Club                      @relation(fields: [clubId], references: [id])
  key             String // e.g. CURRENT_ASSETS, COGS, OPERATING_REVENUE
  name            String
  statement       String
  // OPERATING | INVESTING | FINANCING for CASH_FLOW; null otherwise.
  cashFlowSection String?
  sortOrder       Int                       @default(0)
  parentGroupId   String?
  parent          FinancialStatementGroup?  @relation("FSGroupTree", fields: [parentGroupId], references: [id])
  children        FinancialStatementGroup[] @relation("FSGroupTree")
  accounts        Account[]

  @@unique([clubId, key])
  @@index([clubId, statement])
}

// -------------------------------------------------------------------------
// Chart of Accounts.
// -------------------------------------------------------------------------
// type: ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
// normalBalance: DEBIT | CREDIT  (derived from type at creation time)
// isHeader: aggregating account; cannot be posted directly.
// allowManualPosting: false for control accounts written only by adapters
//                     (e.g. Member AR control account).
model AccountCategory {
  id        String @id @default(cuid())
  clubId    String
  club      Club   @relation(fields: [clubId], references: [id])
  key       String // CURRENT_ASSETS, LONG_TERM_LIABILITIES, ...
  name      String
  type      String
  sortOrder Int    @default(0)

  accounts Account[]

  @@unique([clubId, key])
  @@index([clubId, type])
}

model Account {
  id                  String                   @id @default(cuid())
  clubId              String
  club                Club                     @relation(fields: [clubId], references: [id])
  accountNumber       String
  name                String
  description         String?
  type                String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  normalBalance       String // DEBIT | CREDIT
  categoryId          String?
  category            AccountCategory?         @relation(fields: [categoryId], references: [id])
  parentAccountId     String?
  parent              Account?                 @relation("AccountTree", fields: [parentAccountId], references: [id])
  children            Account[]                @relation("AccountTree")
  isHeader            Boolean                  @default(false)
  allowManualPosting  Boolean                  @default(true)
  isActive            Boolean                  @default(true)
  isTaxRelevant       Boolean                  @default(false)
  isBankAccount       Boolean                  @default(false)
  isControlAccount    Boolean                  @default(false)
  isCashAccount       Boolean                  @default(false) // tagged for cash-flow grouping
  /// Sprint 3 · Post-16H Phase 2.1 (2026-08-06) — durable account
  /// role. Values: STANDARD | CONTRA_ASSET | CONTRA_REVENUE |
  /// CONTRA_LIABILITY | CONTROL | CLEARING | BANK | CASH.
  /// See prisma-postgres/schema.prisma for full documentation.
  accountRole         String                   @default("STANDARD")
  fsGroupId           String?
  fsGroup             FinancialStatementGroup? @relation(fields: [fsGroupId], references: [id])
  /// Founder rule 2026-07-02 v15.0 — Fund Applicability.
  /// A comma-separated list of canonical fund keys (e.g.
  /// "OPERATING", "CAPITAL", "OPERATING,CAPITAL") indicating
  /// which reporting fund(s) this P&L account belongs to. This
  /// is the SINGLE SOURCE OF TRUTH for capital-vs-operating
  /// classification — reporting engines never infer fund from
  /// the account name or number. Nullable so BS-side accounts
  /// (ASSET/LIABILITY/EQUITY) can leave it unset and the
  /// migration backfill for legacy rows is idempotent. See
  /// `src/lib/accounting/fund-applicability.ts` for canonical
  /// tokens, parse/serialise helpers, and FS Group defaults.
  fundApplicability   String?
  defaultDepartmentId String?
  defaultDepartment   Department?              @relation(fields: [defaultDepartmentId], references: [id])
  /// Many-to-many department assignments. An account like
  /// "Repairs and Maintenance" can apply to ADMIN + GOLF + GROUNDS +
  /// F&B + Pro Shop at once; `defaultDepartmentId` is kept as the
  /// "primary" pointer (first assignment) for back-compat with
  /// callers that expect a single department.
  departments         AccountDepartment[]
  sortOrder           Int                      @default(0)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  archivedAt          DateTime?

  lines                JournalEntryLine[]
  vendorDefaultExpense Vendor[]              @relation("VendorDefaultExpense")
  apInvoiceLines       APInvoiceLine[]       @relation("APLineExpense")
  taxRecoverableFor    TaxCode[]             @relation("TaxRecoverable")
  taxPayableFor        TaxCode[]             @relation("TaxPayable")
  paymentBatchBank     PaymentBatch[]        @relation("PaymentBatchBank")
  // Phase 5
  invCatInventory      InventoryCategory[]   @relation("InvCategoryInventory")
  invCatCogs           InventoryCategory[]   @relation("InvCategoryCogs")
  invCatRevenue        InventoryCategory[]   @relation("InvCategoryRevenue")
  invCatAdjustment     InventoryCategory[]   @relation("InvCategoryAdjustment")
  invItemInventory     InventoryItem[]       @relation("InvItemInventory")
  invItemCogs          InventoryItem[]       @relation("InvItemCogs")
  invItemRevenue       InventoryItem[]       @relation("InvItemRevenue")
  eventCatRevenue      EventCategory[]       @relation("EventCatRevenue")
  privateEventRevenue  PrivateEventBooking[] @relation("PrivateEventRevenue")
  privateEventDeferred PrivateEventBooking[] @relation("PrivateEventDeferredRevenue")
  lessonTypeRevenue    LessonType[]          @relation("LessonTypeRevenue")
  lessonTypeExpense    LessonType[]          @relation("LessonTypeExpense")
  assetCatAsset        AssetCategory[]       @relation("AssetCatAsset")
  assetCatAccumDepr    AssetCategory[]       @relation("AssetCatAccumDepr")
  assetCatDeprExpense  AssetCategory[]       @relation("AssetCatDeprExpense")
  budgetLines          BudgetLine[]          @relation("BudgetLineAccount")
  forecastLines        ForecastLine[]        @relation("ForecastLineAccount")
  // Phase 7
  posSaleLines         POSSaleLine[]         @relation("POSSaleLineRevenue")
  // Phase 9
  tournamentRevenue    Tournament[]          @relation("TournamentRevenue")

  @@unique([clubId, accountNumber])
  @@index([clubId, isActive])
  @@index([clubId, type])
}

// -------------------------------------------------------------------------
// Account ↔ Department many-to-many join.
// -------------------------------------------------------------------------
// An account can apply to one or more departments simultaneously
// (e.g. "Repairs and Maintenance" → ADMIN + GOLF + GROUNDS + F&B +
// Pro Shop). The COA import workflow writes one row here per
// (account, department) pair the operator selects.
//
// `Account.defaultDepartmentId` is preserved as a convenience FK
// to the "primary" department for callers that only need one
// (departmental reports default to the primary; the join table
// is the authoritative many-to-many record).
model AccountDepartment {
  id           String     @id @default(cuid())
  clubId       String
  club         Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([accountId, departmentId])
  @@index([clubId])
  @@index([departmentId])
}

// -------------------------------------------------------------------------
// Fiscal year & period.
// -------------------------------------------------------------------------
// status: OPEN | CLOSED | LOCKED
model FiscalYear {
  id            String   @id @default(cuid())
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id])
  label         String // e.g. "FY2025"
  startDate     DateTime
  endDate       DateTime
  status        String   @default("OPEN")
  // Closed-year equity snapshot — set on close (FY status transition to
  // CLOSED) by the closing-engine, or seeded for historical years that
  // pre-date the system's go-live. The reporting service reads this for
  // closed years; for the OPEN fiscal year it computes equity live from
  // the balance sheet so unposted activity is reflected.
  closingEquity Decimal?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  periods   FiscalPeriod[]
  budgets   Budget[]       @relation("BudgetFY")
  forecasts Forecast[]     @relation("ForecastFY")

  @@unique([clubId, label])
  @@index([clubId, status])
}

// status: OPEN | SOFT_LOCKED | HARD_LOCKED | CLOSED
// SOFT_LOCKED: blocks manual postings, but adapters (AR→GL, etc.) can still write.
// HARD_LOCKED: blocks all postings except a SUPER_ADMIN unlock+repost.
// CLOSED: hard locked + closing entries booked.
model FiscalPeriod {
  id             String     @id @default(cuid())
  clubId         String
  club           Club       @relation(fields: [clubId], references: [id])
  fiscalYearId   String
  fiscalYear     FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  label          String // e.g. "FY2025-M01"
  startDate      DateTime
  endDate        DateTime
  sequence       Int // 1..12
  status         String     @default("OPEN")
  closedAt       DateTime?
  closedByUserId String?
  closingNote    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Closed-month operating snapshots — set on period close by the
  // closing-engine, or seeded for historical months that pre-date
  // system go-live. The reporting service reads these for the
  // Operating Results card so 12-month NOI / revenue / budget
  // trend can come from the accounting record instead of inline
  // demo arrays in the React tree. Parallel to
  // FiscalYear.closingEquity. All Decimal in DOLLARS (not cents).
  closingNoi     Decimal?
  closingRevenue Decimal?
  budgetNoi      Decimal?

  journals JournalEntry[]

  @@unique([clubId, label])
  @@index([clubId, startDate, endDate])
  @@index([clubId, status])
}

// -------------------------------------------------------------------------
// Journal Batch
// -------------------------------------------------------------------------
// Optional grouping for multi-entry posting (e.g. dues run for the month).
model JournalBatch {
  id             String    @id @default(cuid())
  clubId         String
  club           Club      @relation(fields: [clubId], references: [id])
  batchNumber    String
  description    String
  source         String // MANUAL | AR | AP | PAYROLL | RECURRING | SYSTEM
  status         String    @default("DRAFT") // DRAFT | POSTED
  postedAt       DateTime?
  postedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  entries JournalEntry[]

  @@unique([clubId, batchNumber])
  @@index([clubId, status])
}

// -------------------------------------------------------------------------
// Journal Entry
// -------------------------------------------------------------------------
// status: DRAFT | APPROVED | POSTED | VOIDED | REVERSED
// VOIDED  = aborted before it became POSTED. No GL impact.
// REVERSED = a contra-JournalEntry was posted that nets this one. Both
//            entries remain; running balances reflect the sum.
//
// source identifies what produced the JE so the adapter can re-derive or
// look up the source record (sourceEntityType + sourceEntityId).
model JournalEntry {
  id               String        @id @default(cuid())
  clubId           String
  club             Club          @relation(fields: [clubId], references: [id])
  entryNumber      String
  batchId          String?
  batch            JournalBatch? @relation(fields: [batchId], references: [id])
  entryDate        DateTime
  periodId         String
  period           FiscalPeriod  @relation(fields: [periodId], references: [id])
  description      String
  memo             String?
  source           String        @default("MANUAL")
  sourceEntityType String?
  sourceEntityId   String?
  status           String        @default("DRAFT")
  approvedAt       DateTime?
  approvedByUserId String?
  postedAt         DateTime?
  postedByUserId   String?
  voidedAt         DateTime?
  voidedByUserId   String?
  voidReason       String?
  reversesId       String?       @unique
  reverses         JournalEntry? @relation("JournalReversal", fields: [reversesId], references: [id])
  reversedBy       JournalEntry? @relation("JournalReversal")
  isAutoReversing  Boolean       @default(false)
  reverseOnDate    DateTime?
  totalDebits      Decimal       @default(0)
  totalCredits     Decimal       @default(0)
  createdByUserId  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  lines                  JournalEntryLine[]
  attachments            JournalAttachment[]
  apInvoicePosted        APInvoice[]              @relation("APInvoicePostedJE")
  apInvoiceReversing     APInvoice[]              @relation("APInvoiceReversingJE")
  vendorPaymentPosted    VendorPayment[]          @relation("VendorPaymentPostedJE")
  // Phase 5
  invTxJournals          InventoryTransaction[]   @relation("InvTxJournal")
  invReceivingJournals   InventoryReceiving[]     @relation("InvReceivingJournal")
  privateEventDepositsJE PrivateEventDeposit[]    @relation("PrivateEventDepositJE")
  privateEventFinalJE    PrivateEventBooking[]    @relation("PrivateEventFinalJE")
  lessonAccrualJE        LessonBooking[]          @relation("LessonAccrualJE")
  payrollRunJE           PayrollRun[]             @relation("PayrollRunJE")
  assetAcquisitionJE     CapitalAsset[]           @relation("AssetAcquisitionJE")
  assetDeprJE            AssetDepreciationEntry[] @relation("AssetDeprJE")
  assetDisposalJE        AssetDisposal[]          @relation("AssetDisposalJE")
  // Phase 7
  posSaleJE              POSSale[]                @relation("POSSaleJE")

  @@unique([clubId, entryNumber])
  @@index([clubId, status])
  @@index([clubId, entryDate])
  @@index([periodId])
  @@index([sourceEntityType, sourceEntityId])
}

// One side of a balanced entry. Exactly one of `debit` / `credit` is non-zero.
model JournalEntryLine {
  id             String       @id @default(cuid())
  clubId         String
  club           Club         @relation(fields: [clubId], references: [id])
  journalEntryId String
  entry          JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  lineNumber     Int
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  costCenterId   String?
  costCenter     CostCenter?  @relation(fields: [costCenterId], references: [id])
  debit          Decimal      @default(0)
  credit         Decimal      @default(0)
  description    String?
  // Cross-references for drilldown (sparse — set when the JE came from an adapter).
  memberId       String?
  // Future: vendorId, eventId, assetId, agreementId. Keep schema lean for now.

  @@index([accountId])
  @@index([journalEntryId])
  @@index([memberId])
}

// Optional templates for recurring/auto-reversing journals. The runner is Phase 7.
// frequency: MONTHLY | QUARTERLY | ANNUAL | CUSTOM
model RecurringJournal {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  name            String
  description     String?
  frequency       String
  nextRunDate     DateTime?
  templateJson    String // serialized JournalEntry + lines template
  isActive        Boolean   @default(true)
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clubId, isActive, nextRunDate])
}

model JournalAttachment {
  id               String       @id @default(cuid())
  clubId           String
  club             Club         @relation(fields: [clubId], references: [id])
  journalEntryId   String
  entry            JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  name             String
  storageKey       String?
  mimeType         String?
  sizeBytes        Int?
  uploadedAt       DateTime     @default(now())
  uploadedByUserId String?

  @@index([journalEntryId])
}

// =========================================================================
// PHASE 4 — ACCOUNTS PAYABLE
// =========================================================================
// Design rules:
//   - Every model is tenant-scoped via clubId.
//   - Banking data: only tokenized metadata (last-4 + processor token).
//   - Posting goes through src/lib/accounting/journal.ts createPostedFromAdapter.
//   - Approvals run through the reusable ApprovalPolicy/Request/Decision engine.
//   - Decimal for money. No raw banking. No destructive deletes for posted rows.

// -------------------------------------------------------------------------
// Vendor master + contacts + banking + documents + risk flags
// -------------------------------------------------------------------------
// status: DRAFT | PENDING_APPROVAL | ACTIVE | INACTIVE | BLOCKED
model Vendor {
  id                      String      @id @default(cuid())
  clubId                  String
  club                    Club        @relation(fields: [clubId], references: [id])
  vendorNumber            String
  legalName               String
  operatingName           String?
  status                  String      @default("DRAFT")
  taxRegistrationNumber   String?
  taxRegion               String?
  defaultExpenseAccountId String?
  defaultExpenseAccount   Account?    @relation("VendorDefaultExpense", fields: [defaultExpenseAccountId], references: [id])
  defaultDepartmentId     String?
  defaultDepartment       Department? @relation("VendorDefaultDepartment", fields: [defaultDepartmentId], references: [id])
  defaultTaxCodeKey       String?
  paymentTermsDays        Int         @default(30)
  paymentMethod           String      @default("CHEQUE") // EFT | CHEQUE | CC | OTHER
  email                   String?
  phone                   String?
  website                 String?
  address1                String?
  address2                String?
  city                    String?
  provinceState           String?
  postalCode              String?
  country                 String?
  notes                   String?
  blockedReason           String?
  approvedAt              DateTime?
  approvedByUserId        String?
  createdByUserId         String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  contacts                 VendorContact[]
  bankingProfiles          VendorBankingProfile[]
  documents                VendorDocument[]
  riskFlags                VendorRiskFlag[]
  invoices                 APInvoice[]
  payments                 VendorPayment[]
  pennyTests               PennyTest[]
  // Phase 5
  inventoryItems           InventoryItem[]                 @relation("InvItemPreferredVendor")
  inventoryReceivings      InventoryReceiving[]            @relation("InvReceivingVendor")
  golfProfessionals        GolfProfessional[]              @relation("ProPayoutVendor")
  // Sprint 3 Checkpoint 15F — vendor intelligence back-relations.
  aliases                  VendorAlias[]                   @relation("VendorCanonicalAlias")
  mergesWon                VendorMergeRecord[]             @relation("VendorMergeWinner")
  mergesLost               VendorMergeRecord[]             @relation("VendorMergeLoser")
  // Sprint 3 Checkpoint 15G — statement reconciliation back-relation.
  statementReconciliations VendorStatementReconciliation[] @relation("VendorStatementReconciliationVendor")

  @@unique([clubId, vendorNumber])
  @@unique([clubId, legalName])
  @@index([clubId, status])
}

model VendorContact {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id])
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([vendorId])
}

// Tokenized banking profile. NEVER store raw account numbers.
//   - accountLastFour kept for display
//   - processorToken: opaque pointer into the banking adapter's vault (Phase 7)
//   - status: DRAFT | PENDING_APPROVAL | VERIFIED | REJECTED | INACTIVE
// Banking changes always create a new profile in DRAFT; the existing one stays
// VERIFIED until the new one is approved + activated.
model VendorBankingProfile {
  id                String    @id @default(cuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id])
  vendorId          String
  vendor            Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type              String    @default("EFT") // EFT | WIRE | CHEQUE
  bankName          String?
  institutionNumber String? // masked OK
  transitNumber     String? // masked OK
  accountLastFour   String?
  processorToken    String? // opaque vault id — NEVER raw account number
  status            String    @default("DRAFT")
  approvedAt        DateTime?
  approvedByUserId  String?
  rejectedReason    String?
  isActive          Boolean   @default(false)
  approvalRequestId String?
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  pennyTests PennyTest[]

  @@index([vendorId])
  @@index([clubId, status])
}

model PennyTest {
  id                String               @id @default(cuid())
  clubId            String
  club              Club                 @relation(fields: [clubId], references: [id])
  vendorId          String
  vendor            Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bankingProfileId  String
  bankingProfile    VendorBankingProfile @relation(fields: [bankingProfileId], references: [id], onDelete: Cascade)
  amount            Decimal
  sentAt            DateTime             @default(now())
  confirmedAt       DateTime?
  confirmedAmount   Decimal?
  initiatedByUserId String?
  status            String               @default("SENT") // SENT | CONFIRMED | FAILED | CANCELLED
  notes             String?

  @@index([vendorId])
  @@index([clubId, status])
}

model VendorDocument {
  id               String   @id @default(cuid())
  clubId           String
  club             Club     @relation(fields: [clubId], references: [id])
  vendorId         String
  vendor           Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  kind             String // CONTRACT | W9 | INSURANCE | VOID_CHEQUE | OTHER
  name             String
  storageKey       String?
  mimeType         String?
  sizeBytes        Int?
  uploadedAt       DateTime @default(now())
  uploadedByUserId String?

  @@index([vendorId])
}

// Risk / compliance flags attached to vendors.
model VendorRiskFlag {
  id               String    @id @default(cuid())
  clubId           String
  club             Club      @relation(fields: [clubId], references: [id])
  vendorId         String
  vendor           Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  kind             String
  severity         String    @default("MEDIUM")
  description      String
  resolvedAt       DateTime?
  resolvedByUserId String?
  createdAt        DateTime  @default(now())

  @@index([vendorId, resolvedAt])
}

// -------------------------------------------------------------------------
// Tax codes
// -------------------------------------------------------------------------
model TaxCode {
  id                   String   @id @default(cuid())
  clubId               String
  club                 Club     @relation(fields: [clubId], references: [id])
  key                  String // GST_5 | HST_13 | EXEMPT | ZERO_RATED | ...
  name                 String
  region               String?
  ratePct              Decimal  @default(0)
  recoverableAccountId String?
  recoverableAccount   Account? @relation("TaxRecoverable", fields: [recoverableAccountId], references: [id])
  payableAccountId     String?
  payableAccount       Account? @relation("TaxPayable", fields: [payableAccountId], references: [id])
  isRecoverable        Boolean  @default(true)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  invoiceLines APInvoiceLine[]

  @@unique([clubId, key])
  @@index([clubId, isActive])
}

// -------------------------------------------------------------------------
// Reusable approval engine
// -------------------------------------------------------------------------
// entityType: AP_INVOICE | VENDOR | VENDOR_BANKING | PAYMENT_BATCH
// policy.rulesJson: [ { maxAmount: number|null, requiredApprovals: int,
//                       eligibleRoleKeys: string[] }, ... ]
model ApprovalPolicy {
  id         String   @id @default(cuid())
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id])
  entityType String
  name       String
  rulesJson  String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  requests ApprovalRequest[]

  @@unique([clubId, entityType])
}

model ApprovalRequest {
  id                String          @id @default(cuid())
  clubId            String
  club              Club            @relation(fields: [clubId], references: [id])
  policyId          String?
  policy            ApprovalPolicy? @relation(fields: [policyId], references: [id])
  entityType        String
  entityId          String
  amount            Decimal         @default(0)
  requiredApprovals Int             @default(1)
  eligibleRoleKeys  String // CSV of role keys eligible to approve
  status            String          @default("PENDING")
  requestedByUserId String?
  resolvedAt        DateTime?
  resolutionNote    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  decisions ApprovalDecision[]

  @@index([clubId, status])
  @@index([entityType, entityId])
}

model ApprovalDecision {
  id        String          @id @default(cuid())
  clubId    String
  club      Club            @relation(fields: [clubId], references: [id])
  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  decision  String // APPROVE | REJECT | REQUEST_INFO
  comment   String?
  decidedAt DateTime        @default(now())

  @@unique([requestId, userId])
  @@index([clubId])
}

// -------------------------------------------------------------------------
// AP Invoice
// -------------------------------------------------------------------------
// status: DRAFT | PENDING_APPROVAL | APPROVED | POSTED | PARTIALLY_PAID
//       | PAID | VOIDED | DISPUTED
model APInvoice {
  id                      String          @id @default(cuid())
  clubId                  String
  club                    Club            @relation(fields: [clubId], references: [id])
  invoiceNumber           String // Spectre-side: APINV-2025-000123
  vendorReference         String? // vendor's invoice number (for dup detection)
  vendorId                String
  vendor                  Vendor          @relation(fields: [vendorId], references: [id])
  invoiceDate             DateTime
  dueDate                 DateTime?
  terms                   String?
  description             String?
  departmentId            String?
  department              Department?     @relation("APInvoiceDepartment", fields: [departmentId], references: [id])
  subtotal                Decimal         @default(0)
  taxTotal                Decimal         @default(0)
  total                   Decimal         @default(0)
  amountPaid              Decimal         @default(0)
  currency                String          @default("CAD")
  status                  String          @default("DRAFT")
  approvalRequestId       String?
  postedAt                DateTime?
  postedByUserId          String?
  postedJournalEntryId    String?
  postedJournalEntry      JournalEntry?   @relation("APInvoicePostedJE", fields: [postedJournalEntryId], references: [id])
  voidedAt                DateTime?
  voidedByUserId          String?
  voidReason              String?
  reversingJournalEntryId String?
  reversingJournalEntry   JournalEntry?   @relation("APInvoiceReversingJE", fields: [reversingJournalEntryId], references: [id])
  captureId               String?         @unique
  capture                 ReceiptCapture? @relation("CaptureConvertedInvoice", fields: [captureId], references: [id])
  notes                   String?
  createdByUserId         String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  lines                APInvoiceLine[]
  attachments          APInvoiceAttachment[]
  payments             VendorPayment[]
  batchItems           PaymentBatchItem[]
  // Phase 5
  invReceivingsMatched InventoryReceiving[]     @relation("InvReceivingMatchedAP")
  capitalAssetsSource  CapitalAsset[]           @relation("AssetSourceAP")
  assetMaintenance     AssetMaintenanceRecord[] @relation("AssetMaintenanceAP")
  lessonPayablesPaid   LessonPayable[]          @relation("LessonPayableAP")
  payrollRemittances   PayrollRemittance[]      @relation("PayrollRemittanceAP")

  @@unique([clubId, invoiceNumber])
  @@unique([clubId, vendorId, vendorReference])
  @@index([clubId, status])
  @@index([clubId, dueDate])
  @@index([vendorId])
}

model APInvoiceLine {
  id               String      @id @default(cuid())
  clubId           String
  club             Club        @relation(fields: [clubId], references: [id])
  invoiceId        String
  invoice          APInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNumber       Int
  expenseAccountId String
  expenseAccount   Account     @relation("APLineExpense", fields: [expenseAccountId], references: [id])
  departmentId     String?
  department       Department? @relation("APLineDepartment", fields: [departmentId], references: [id])
  costCenterId     String?
  costCenter       CostCenter? @relation("APLineCostCenter", fields: [costCenterId], references: [id])
  description      String?
  quantity         Decimal?    @default(1)
  unitCost         Decimal?
  amount           Decimal
  taxCodeId        String?
  taxCode          TaxCode?    @relation(fields: [taxCodeId], references: [id])
  taxAmount        Decimal     @default(0)
  isCapital        Boolean     @default(false)
  isInventory      Boolean     @default(false)

  @@index([invoiceId])
}

model APInvoiceAttachment {
  id               String    @id @default(cuid())
  clubId           String
  club             Club      @relation(fields: [clubId], references: [id])
  invoiceId        String
  invoice          APInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name             String
  storageKey       String?
  mimeType         String?
  sizeBytes        Int?
  uploadedAt       DateTime  @default(now())
  uploadedByUserId String?

  @@index([invoiceId])
}

// -------------------------------------------------------------------------
// Receipt / invoice capture inbox
// -------------------------------------------------------------------------
// status: NEW | NEEDS_REVIEW | CONVERTED | REJECTED | DUPLICATE
model ReceiptCapture {
  id                   String    @id @default(cuid())
  clubId               String
  club                 Club      @relation(fields: [clubId], references: [id])
  name                 String
  storageKey           String?
  mimeType             String?
  sizeBytes            Int?
  status               String    @default("NEW")
  extractedJson        String?
  suggestionJson       String?
  confidence           Decimal   @default(0)
  duplicateOfInvoiceId String?
  convertedAt          DateTime?
  uploadedAt           DateTime  @default(now())
  uploadedByUserId     String?

  convertedInvoice APInvoice? @relation("CaptureConvertedInvoice")

  @@index([clubId, status])
}

// -------------------------------------------------------------------------
// Payment batches + vendor payments
// -------------------------------------------------------------------------
// PaymentBatch.status: DRAFT | PENDING_APPROVAL | APPROVED | PROCESSING |
//                      PROCESSED | VOIDED
model PaymentBatch {
  id                String    @id @default(cuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id])
  batchNumber       String
  description       String
  paymentDate       DateTime
  currency          String    @default("CAD")
  bankAccountId     String?
  bankAccount       Account?  @relation("PaymentBatchBank", fields: [bankAccountId], references: [id])
  paymentMethod     String    @default("EFT")
  status            String    @default("DRAFT")
  approvalRequestId String?
  totalAmount       Decimal   @default(0)
  processedAt       DateTime?
  processedByUserId String?
  exportedAt        DateTime?
  exportFileRef     String?
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  items    PaymentBatchItem[]
  payments VendorPayment[]

  @@unique([clubId, batchNumber])
  @@index([clubId, status])
}

model PaymentBatchItem {
  id        String         @id @default(cuid())
  clubId    String
  club      Club           @relation(fields: [clubId], references: [id])
  batchId   String
  batch     PaymentBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   APInvoice      @relation(fields: [invoiceId], references: [id])
  amount    Decimal
  status    String         @default("PENDING") // PENDING | PROCESSED | FAILED | EXCLUDED
  notes     String?
  paymentId String?        @unique
  payment   VendorPayment? @relation(fields: [paymentId], references: [id])

  @@index([batchId])
}

// VendorPayment.status: PENDING | PROCESSED | FAILED | VOIDED
model VendorPayment {
  id                   String        @id @default(cuid())
  clubId               String
  club                 Club          @relation(fields: [clubId], references: [id])
  vendorId             String
  vendor               Vendor        @relation(fields: [vendorId], references: [id])
  invoiceId            String?
  invoice              APInvoice?    @relation(fields: [invoiceId], references: [id])
  batchId              String?
  batch                PaymentBatch? @relation(fields: [batchId], references: [id])
  paymentNumber        String
  paymentDate          DateTime
  method               String        @default("EFT")
  amount               Decimal
  processorRef         String?
  status               String        @default("PENDING")
  postedJournalEntryId String?
  postedJournalEntry   JournalEntry? @relation("VendorPaymentPostedJE", fields: [postedJournalEntryId], references: [id])
  voidedAt             DateTime?
  voidedByUserId       String?
  voidReason           String?
  createdByUserId      String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  batchItem PaymentBatchItem?

  @@unique([clubId, paymentNumber])
  @@index([clubId, status])
  @@index([vendorId])
  @@index([invoiceId])
}

// -------------------------------------------------------------------------
// AP exceptions
// -------------------------------------------------------------------------
model APException {
  id               String    @id @default(cuid())
  clubId           String
  club             Club      @relation(fields: [clubId], references: [id])
  invoiceId        String?
  vendorId         String?
  captureId        String?
  kind             String
  severity         String    @default("MEDIUM")
  description      String
  status           String    @default("OPEN") // OPEN | RESOLVED | OVERRIDDEN
  resolutionNote   String?
  overrideByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([clubId, status])
  @@index([invoiceId])
  @@index([vendorId])
}

// =========================================================================
// PHASE 5 — OPERATIONAL CORE
// =========================================================================
// Design rules (carry forward):
//   - Every model is tenant-scoped via clubId.
//   - All operational accounting goes through createPostedFromAdapter.
//   - Decimal for money. No raw PII. No destructive deletes for posted rows.

// -------------------------------------------------------------------------
// 5A. Inventory + Pro Shop
// -------------------------------------------------------------------------
model InventoryCategory {
  id                         String   @id @default(cuid())
  clubId                     String
  club                       Club     @relation(fields: [clubId], references: [id])
  key                        String
  name                       String
  description                String?
  inventoryAccountId         String?
  inventoryAccount           Account? @relation("InvCategoryInventory", fields: [inventoryAccountId], references: [id])
  cogsAccountId              String?
  cogsAccount                Account? @relation("InvCategoryCogs", fields: [cogsAccountId], references: [id])
  revenueAccountId           String?
  revenueAccount             Account? @relation("InvCategoryRevenue", fields: [revenueAccountId], references: [id])
  adjustmentExpenseAccountId String?
  adjustmentExpenseAccount   Account? @relation("InvCategoryAdjustment", fields: [adjustmentExpenseAccountId], references: [id])
  defaultTaxCodeKey          String?
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  items InventoryItem[]

  @@unique([clubId, key])
  @@index([clubId, isActive])
}

model InventoryLocation {
  id           String      @id @default(cuid())
  clubId       String
  club         Club        @relation(fields: [clubId], references: [id])
  code         String
  name         String
  departmentId String?
  department   Department? @relation("InvLocationDepartment", fields: [departmentId], references: [id])
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  items         InventoryItem[]        @relation("InvItemDefaultLocation")
  transactions  InventoryTransaction[]
  counts        InventoryCount[]
  receivings    InventoryReceiving[]
  transfersFrom InventoryTransfer[]    @relation("InvTransferFrom")
  transfersTo   InventoryTransfer[]    @relation("InvTransferTo")

  @@unique([clubId, code])
  @@index([clubId, isActive])
}

// kind: STANDARD | SERVICE  (services don't track on-hand qty)
model InventoryItem {
  id                 String             @id @default(cuid())
  clubId             String
  club               Club               @relation(fields: [clubId], references: [id])
  sku                String
  upc                String?
  name               String
  description        String?
  brand              String?
  kind               String             @default("STANDARD")
  categoryId         String?
  category           InventoryCategory? @relation(fields: [categoryId], references: [id])
  preferredVendorId  String?
  preferredVendor    Vendor?            @relation("InvItemPreferredVendor", fields: [preferredVendorId], references: [id])
  defaultLocationId  String?
  defaultLocation    InventoryLocation? @relation("InvItemDefaultLocation", fields: [defaultLocationId], references: [id])
  unitOfMeasure      String             @default("EA")
  defaultCost        Decimal            @default(0)
  retailPrice        Decimal            @default(0)
  averageCost        Decimal            @default(0)
  quantityOnHand     Decimal            @default(0)
  quantityCommitted  Decimal            @default(0)
  reorderPoint       Decimal            @default(0)
  reorderQty         Decimal            @default(0)
  taxCodeKey         String?
  isActive           Boolean            @default(true)
  isEcommerce        Boolean            @default(false)
  imageStorageKey    String?
  inventoryAccountId String?
  inventoryAccount   Account?           @relation("InvItemInventory", fields: [inventoryAccountId], references: [id])
  cogsAccountId      String?
  cogsAccount        Account?           @relation("InvItemCogs", fields: [cogsAccountId], references: [id])
  revenueAccountId   String?
  revenueAccount     Account?           @relation("InvItemRevenue", fields: [revenueAccountId], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  transactions   InventoryTransaction[]
  receivingLines InventoryReceivingLine[]
  countLines     InventoryCountLine[]
  transferLines  InventoryTransferLine[]
  adjustments    InventoryAdjustment[]
  // Phase 7
  posSaleLines   POSSaleLine[]            @relation("POSSaleLineItem")

  @@unique([clubId, sku])
  @@index([clubId, isActive])
}

// kind: RECEIPT | ISSUE | ADJUSTMENT | TRANSFER_OUT | TRANSFER_IN | SALE | RETURN | COUNT_VARIANCE
model InventoryTransaction {
  id                   String             @id @default(cuid())
  clubId               String
  club                 Club               @relation(fields: [clubId], references: [id])
  itemId               String
  item                 InventoryItem      @relation(fields: [itemId], references: [id])
  locationId           String?
  location             InventoryLocation? @relation(fields: [locationId], references: [id])
  kind                 String
  quantity             Decimal // signed: + for inflows, - for outflows
  unitCost             Decimal            @default(0)
  totalCost            Decimal            @default(0)
  averageCostAfter     Decimal            @default(0)
  quantityAfter        Decimal            @default(0)
  transactionDate      DateTime           @default(now())
  sourceType           String?
  sourceId             String?
  postedJournalEntryId String?
  postedJournalEntry   JournalEntry?      @relation("InvTxJournal", fields: [postedJournalEntryId], references: [id])
  notes                String?
  createdByUserId      String?
  createdAt            DateTime           @default(now())

  @@index([clubId, itemId, transactionDate])
  @@index([sourceType, sourceId])
}

model InventoryAdjustment {
  id             String        @id @default(cuid())
  clubId         String
  club           Club          @relation(fields: [clubId], references: [id])
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id])
  locationId     String?
  quantityChange Decimal
  unitCost       Decimal       @default(0)
  reasonCode     String // SHRINKAGE | DAMAGE | RECOUNT | WRITE_OFF | OTHER
  notes          String?
  status         String        @default("POSTED")
  postedAt       DateTime      @default(now())
  postedByUserId String?

  @@index([clubId, status])
  @@index([itemId])
}

model InventoryCount {
  id              String             @id @default(cuid())
  clubId          String
  club            Club               @relation(fields: [clubId], references: [id])
  countNumber     String
  locationId      String?
  location        InventoryLocation? @relation(fields: [locationId], references: [id])
  description     String?
  countDate       DateTime           @default(now())
  status          String             @default("DRAFT")
  postedAt        DateTime?
  postedByUserId  String?
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  lines InventoryCountLine[]

  @@unique([clubId, countNumber])
  @@index([clubId, status])
}

model InventoryCountLine {
  id           String         @id @default(cuid())
  clubId       String
  club         Club           @relation(fields: [clubId], references: [id])
  countId      String
  count        InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventoryItem  @relation(fields: [itemId], references: [id])
  systemQty    Decimal
  countedQty   Decimal?
  varianceQty  Decimal        @default(0)
  varianceCost Decimal        @default(0)
  notes        String?

  @@index([countId])
}

model InventoryReceiving {
  id                   String             @id @default(cuid())
  clubId               String
  club                 Club               @relation(fields: [clubId], references: [id])
  receivingNumber      String
  vendorId             String?
  vendor               Vendor?            @relation("InvReceivingVendor", fields: [vendorId], references: [id])
  locationId           String?
  location             InventoryLocation? @relation(fields: [locationId], references: [id])
  receivedDate         DateTime           @default(now())
  status               String             @default("DRAFT")
  totalReceivedCost    Decimal            @default(0)
  matchedApInvoiceId   String?
  matchedApInvoice     APInvoice?         @relation("InvReceivingMatchedAP", fields: [matchedApInvoiceId], references: [id])
  postedAt             DateTime?
  postedByUserId       String?
  postedJournalEntryId String?
  postedJournalEntry   JournalEntry?      @relation("InvReceivingJournal", fields: [postedJournalEntryId], references: [id])
  createdByUserId      String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  lines InventoryReceivingLine[]

  @@unique([clubId, receivingNumber])
  @@index([clubId, status])
}

model InventoryReceivingLine {
  id          String             @id @default(cuid())
  clubId      String
  club        Club               @relation(fields: [clubId], references: [id])
  receivingId String
  receiving   InventoryReceiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem      @relation(fields: [itemId], references: [id])
  quantity    Decimal
  unitCost    Decimal
  totalCost   Decimal
  notes       String?

  @@index([receivingId])
}

model InventoryTransfer {
  id             String            @id @default(cuid())
  clubId         String
  club           Club              @relation(fields: [clubId], references: [id])
  transferNumber String
  fromLocationId String
  fromLocation   InventoryLocation @relation("InvTransferFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     InventoryLocation @relation("InvTransferTo", fields: [toLocationId], references: [id])
  transferDate   DateTime          @default(now())
  status         String            @default("DRAFT")
  notes          String?
  postedAt       DateTime?
  postedByUserId String?
  createdAt      DateTime          @default(now())

  lines InventoryTransferLine[]

  @@unique([clubId, transferNumber])
  @@index([clubId, status])
}

model InventoryTransferLine {
  id         String            @id @default(cuid())
  clubId     String
  club       Club              @relation(fields: [clubId], references: [id])
  transferId String
  transfer   InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem     @relation(fields: [itemId], references: [id])
  quantity   Decimal
  unitCost   Decimal

  @@index([transferId])
}

// -------------------------------------------------------------------------
// 5B. Events extensions + Private events
// -------------------------------------------------------------------------
model EventCategory {
  id                      String   @id @default(cuid())
  clubId                  String
  club                    Club     @relation(fields: [clubId], references: [id])
  key                     String
  name                    String
  defaultRevenueAccountId String?
  defaultRevenueAccount   Account? @relation("EventCatRevenue", fields: [defaultRevenueAccountId], references: [id])
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())

  @@unique([clubId, key])
}

// status: NEW | REVIEWED | BOOKED | DECLINED
model PrivateEventInquiry {
  id               String    @id @default(cuid())
  clubId           String
  club             Club      @relation(fields: [clubId], references: [id])
  inquirerName     String
  inquirerEmail    String?
  inquirerPhone    String?
  preferredDate    DateTime?
  headCount        Int?
  message          String?
  status           String    @default("NEW")
  reviewedAt       DateTime?
  reviewedByUserId String?
  createdAt        DateTime  @default(now())

  bookings PrivateEventBooking[]

  @@index([clubId, status])
}

// status: DRAFT | CONFIRMED | IN_PROGRESS | COMPLETED | CANCELLED
model PrivateEventBooking {
  id                        String               @id @default(cuid())
  clubId                    String
  club                      Club                 @relation(fields: [clubId], references: [id])
  bookingNumber             String
  inquiryId                 String?
  inquiry                   PrivateEventInquiry? @relation(fields: [inquiryId], references: [id])
  memberId                  String?
  member                    Member?              @relation("PrivateEventMember", fields: [memberId], references: [id])
  customerName              String
  customerEmail             String?
  customerPhone             String?
  eventName                 String
  eventStart                DateTime
  eventEnd                  DateTime
  headCount                 Int                  @default(0)
  status                    String               @default("DRAFT")
  depositAmount             Decimal              @default(0)
  depositPaidAmount         Decimal              @default(0)
  totalAmount               Decimal              @default(0)
  notes                     String?
  revenueAccountId          String?
  revenueAccount            Account?             @relation("PrivateEventRevenue", fields: [revenueAccountId], references: [id])
  deferredRevenueAccountId  String?
  deferredRevenueAccount    Account?             @relation("PrivateEventDeferredRevenue", fields: [deferredRevenueAccountId], references: [id])
  finalPostedJournalEntryId String?
  finalPostedJournalEntry   JournalEntry?        @relation("PrivateEventFinalJE", fields: [finalPostedJournalEntryId], references: [id])
  createdByUserId           String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  deposits       PrivateEventDeposit[]
  menuSelections PrivateEventMenuSelection[]
  barSelections  PrivateEventBarSelection[]
  addOns         PrivateEventAddOn[]

  @@unique([clubId, bookingNumber])
  @@index([clubId, status])
}

// status: PENDING | RECEIVED | REFUNDED | FORFEITED
model PrivateEventDeposit {
  id                   String              @id @default(cuid())
  clubId               String
  club                 Club                @relation(fields: [clubId], references: [id])
  bookingId            String
  booking              PrivateEventBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount               Decimal
  receivedDate         DateTime?
  method               String              @default("EFT")
  status               String              @default("PENDING")
  postedJournalEntryId String?
  postedJournalEntry   JournalEntry?       @relation("PrivateEventDepositJE", fields: [postedJournalEntryId], references: [id])
  createdByUserId      String?
  createdAt            DateTime            @default(now())

  @@index([clubId, status])
  @@index([bookingId])
}

model PrivateEventMenuSelection {
  id           String              @id @default(cuid())
  clubId       String
  club         Club                @relation(fields: [clubId], references: [id])
  bookingId    String
  booking      PrivateEventBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  course       String
  description  String
  pricePerHead Decimal             @default(0)
  totalPrice   Decimal             @default(0)
  notes        String?

  @@index([bookingId])
}

model PrivateEventBarSelection {
  id           String              @id @default(cuid())
  clubId       String
  club         Club                @relation(fields: [clubId], references: [id])
  bookingId    String
  booking      PrivateEventBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  description  String
  pricePerHead Decimal             @default(0)
  totalPrice   Decimal             @default(0)
  notes        String?

  @@index([bookingId])
}

model PrivateEventAddOn {
  id          String              @id @default(cuid())
  clubId      String
  club        Club                @relation(fields: [clubId], references: [id])
  bookingId   String
  booking     PrivateEventBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal             @default(1)
  unitPrice   Decimal             @default(0)
  totalPrice  Decimal             @default(0)

  @@index([bookingId])
}

// -------------------------------------------------------------------------
// 5C. Lessons + Pro payables
// -------------------------------------------------------------------------
model GolfProfessional {
  id             String   @id @default(cuid())
  clubId         String
  club           Club     @relation(fields: [clubId], references: [id])
  firstName      String
  lastName       String
  email          String?
  phone          String?
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id])
  payoutVendorId String?
  payoutVendor   Vendor?  @relation("ProPayoutVendor", fields: [payoutVendorId], references: [id])
  isHeadPro      Boolean  @default(false)
  isActive       Boolean  @default(true)
  hourlyRate     Decimal  @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings       LessonBooking[]
  lessonPayables LessonPayable[]

  @@index([clubId, isActive])
}

model LessonType {
  id                         String   @id @default(cuid())
  clubId                     String
  club                       Club     @relation(fields: [clubId], references: [id])
  key                        String
  name                       String
  durationMinutes            Int      @default(60)
  memberPrice                Decimal  @default(0)
  instructorPayPerLesson     Decimal  @default(0)
  revenueAccountId           String?
  revenueAccount             Account? @relation("LessonTypeRevenue", fields: [revenueAccountId], references: [id])
  instructorExpenseAccountId String?
  instructorExpenseAccount   Account? @relation("LessonTypeExpense", fields: [instructorExpenseAccountId], references: [id])
  isGroup                    Boolean  @default(false)
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())

  bookings LessonBooking[]

  @@unique([clubId, key])
  @@index([clubId, isActive])
}

// status: SCHEDULED | INSTRUCTOR_CONFIRMED | COMPLETED | CANCELLED | NO_SHOW
model LessonBooking {
  id                      String           @id @default(cuid())
  clubId                  String
  club                    Club             @relation(fields: [clubId], references: [id])
  bookingNumber           String
  memberId                String
  member                  Member           @relation("LessonBookingMember", fields: [memberId], references: [id])
  lessonTypeId            String
  lessonType              LessonType       @relation(fields: [lessonTypeId], references: [id])
  instructorId            String
  instructor              GolfProfessional @relation(fields: [instructorId], references: [id])
  scheduledAt             DateTime
  durationMinutes         Int              @default(60)
  status                  String           @default("SCHEDULED")
  instructorConfirmedAt   DateTime?
  completedAt             DateTime?
  headProApprovedAt       DateTime?
  headProApprovedByUserId String?
  cancellationReason      String?
  memberChargeId          String?          @unique
  memberCharge            Charge?          @relation("LessonMemberCharge", fields: [memberChargeId], references: [id])
  accrualJournalEntryId   String?
  accrualJournalEntry     JournalEntry?    @relation("LessonAccrualJE", fields: [accrualJournalEntryId], references: [id])
  notes                   String?
  createdByUserId         String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  lessonPayables LessonPayable[]

  @@unique([clubId, bookingNumber])
  @@index([clubId, status])
  @@index([instructorId])
  @@index([memberId])
}

// status: ACCRUED | INCLUDED_IN_AP | PAID | VOIDED
model LessonPayable {
  id              String           @id @default(cuid())
  clubId          String
  club            Club             @relation(fields: [clubId], references: [id])
  bookingId       String
  booking         LessonBooking    @relation(fields: [bookingId], references: [id])
  instructorId    String
  instructor      GolfProfessional @relation(fields: [instructorId], references: [id])
  amount          Decimal
  accruedAt       DateTime         @default(now())
  paidApInvoiceId String?
  paidApInvoice   APInvoice?       @relation("LessonPayableAP", fields: [paidApInvoiceId], references: [id])
  status          String           @default("ACCRUED")
  notes           String?
  createdByUserId String?
  createdAt       DateTime         @default(now())

  @@index([clubId, status])
  @@index([instructorId])
}

// -------------------------------------------------------------------------
// 5D. Payroll + Timekeeper
// -------------------------------------------------------------------------
model EmployeePosition {
  id             String      @id @default(cuid())
  clubId         String
  club           Club        @relation(fields: [clubId], references: [id])
  code           String
  name           String
  // HR-2B.3.6 (2026-08-19) — Position now belongs to a Department.
  departmentId   String?
  department     Department? @relation("PositionDepartment", fields: [departmentId], references: [id])
  defaultPayRate Decimal     @default(0)
  isExempt       Boolean     @default(false)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  employees Employee[]

  @@unique([clubId, code])
  @@index([clubId, departmentId, isActive])
}

// status: ACTIVE | LEAVE | TERMINATED
// compensationType: SALARY | HOURLY
model Employee {
  id                     String            @id @default(cuid())
  clubId                 String
  club                   Club              @relation(fields: [clubId], references: [id])
  employeeNumber         String
  firstName              String
  lastName               String
  // HR-1 (2026-08-16) — Canonical people extension.
  middleName             String?
  preferredName          String?
  email                  String? // work email
  personalEmail          String? // employee-owned; used for onboarding invitations
  phone                  String? // work phone (deprecated; superseded by mobilePhone)
  mobilePhone            String? // employee-owned mobile
  // HR-2C Portal Refinement (2026-08-24) — home / mailing address.
  // Employee-editable via the Employee Portal; club-side services also
  // read these (payroll province seam, T4 mailing). All columns are
  // nullable and additive — no backfill required.
  homeAddressLine1       String?
  homeAddressLine2       String?
  homeCity               String?
  homeProvince           String? // 2-char CA province / US state code
  homePostalCode         String?
  homeCountry            String? // ISO-3166-1 alpha-2; null = unspecified
  userId                 String?           @unique
  user                   User?             @relation(fields: [userId], references: [id])
  departmentId           String?
  department             Department?       @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  positionId             String?
  position               EmployeePosition? @relation(fields: [positionId], references: [id])
  hireDate               DateTime?
  // HR-1 — pre-hire lifecycle.
  expectedStartDate      DateTime?
  activatedAt            DateTime?
  terminationDate        DateTime?
  status                 String            @default("ACTIVE")
  // HR-1 lifecycle enums (validated in service layer, not DB).
  //   employmentType   : FULL_TIME | PART_TIME | SEASONAL | CONTRACT
  //   employeeLifecycle: PRE_HIRE | ACTIVE | LEAVE | TERMINATED
  //   onboardingState  : DRAFT | INVITED | IN_PROGRESS | SUBMITTED | APPROVED | REJECTED | REVOKED
  //   payrollReadiness : NOT_READY | READY | ACTIVE
  employmentType         String?
  employeeLifecycle      String            @default("PRE_HIRE")
  onboardingState        String            @default("DRAFT")
  payrollReadiness       String            @default("NOT_READY")
  compensationType       String            @default("HOURLY")
  // LEGACY (HR-1): canonical source is EmployeeCompensation. HR
  // compensation writes shadow the currently-active rate here in the
  // same transaction to preserve existing PayrollLine.grossPay
  // consumers. Do NOT read for authoritative history.
  payRate                Decimal           @default(0)
  payrollIdExternal      String?
  // HR-1 — who created the Employee record (staff). Same-tenant
  // invariant enforced in service layer.
  createdByUserId        String?
  createdBy              User?             @relation("EmployeeCreatedBy", fields: [createdByUserId], references: [id])
  // HR-1 — optional linkage to a Member record (employee is also a
  // club member). Cross-tenant-nullable at the FK level; the
  // same-tenant invariant (Member.clubId == Employee.clubId) is
  // service-enforced and covered by a cross-tenant rejection test.
  memberId               String?           @unique
  member                 Member?           @relation("MemberAsEmployee", fields: [memberId], references: [id])
  // HR-1 — profile photo + resume live in EmployeeDocument so they
  // inherit the categorised / sensitivity-tagged document controls.
  profilePhotoDocumentId String?
  profilePhoto           EmployeeDocument? @relation("EmployeeProfilePhoto", fields: [profilePhotoDocumentId], references: [id])
  resumeDocumentId       String?
  resume                 EmployeeDocument? @relation("EmployeeResume", fields: [resumeDocumentId], references: [id])
  // HR-1 — self-referential reporting line.
  managerEmployeeId      String?
  manager                Employee?         @relation("EmployeeReports", fields: [managerEmployeeId], references: [id])
  reports                Employee[]        @relation("EmployeeReports")
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  timesheets   Timesheet[]
  timeEvents   TimeClockEvent[]
  payrollLines PayrollLine[]

  // HR-1 canonical relations.
  employmentPeriods          EmploymentPeriod[]
  compensationHistory        EmployeeCompensation[]
  payrollProfile             PayrollProfile?
  sensitiveIdentity          EmployeeSensitiveIdentity?
  bankAccounts               EmployeeBankAccount[]
  taxProfiles                EmployeeTaxProfile[]
  documents                  EmployeeDocument[]                  @relation("EmployeeDocuments")
  credentials                EmployeeCredential[]
  emergencyContacts          EmployeeEmergencyContact[]
  onboardingInvitations      EmployeeOnboardingInvitation[]
  onboardingSessions         EmployeeOnboardingSession[]
  onboardingTransitions      EmployeeOnboardingStateTransition[]
  onboardingCorrections      EmployeeOnboardingCorrection[]
  onboardingAcknowledgements EmployeeOnboardingAcknowledgement[]
  portalCredential           EmployeePortalCredential?
  portalPasswordResets       EmployeePortalPasswordReset[]
  portalTourCompletedAt      DateTime?
  trainingAssignments        TrainingAssignment[]
  trainingProgress           TrainingProgress[]
  trainingAttempts           TrainingAttempt[]
  trainingCompletions        TrainingCompletion[]
  availabilityWeeks          EmployeeAvailabilityWeek[]
  homeNotificationDismissals EmployeeHomeNotificationDismissal[]
  // HR-2C Employment (2026-08-24) — multi-role assignments + allowances.
  employmentAssignments      EmployeeEmploymentAssignment[]
  allowances                 EmployeeAllowance[]
  // Payroll-3A (2026-08-28) — canonical payroll foundation.
  payrollBatchEmployees      PayrollBatchEmployee[]
  payrollBatchEarnings       PayrollBatchEarning[]
  payrollBatchDeductions     PayrollBatchDeduction[]
  payrollBatchAllowanceSnapshots PayrollBatchAllowanceSnapshot[]
  payrollApprovedTimeEntries PayrollApprovedTimeEntry[]
  payrollPayGroupMemberships PayrollPayGroupMember[]

  @@unique([clubId, employeeNumber])
  @@index([clubId, status])
  @@index([clubId, employeeLifecycle])
  @@index([clubId, managerEmployeeId])
}

// HR-2C Employment (2026-08-24) — Effective-dated role assignment.
//
// Multi-role model. An employee may hold zero or one PRIMARY
// assignment AND any number of ADDITIONAL assignments concurrently.
// Ended assignments (effectiveTo <= now) remain as historical rows
// and never mutate.
//
// EmploymentPeriod (existing) records lifecycle transitions (HIRE /
// TRANSFER / PROMOTION / TERMINATION) at the Employee level and
// remains authoritative for those. EmployeeEmploymentAssignment is
// the ROLE registry — Payroll and future Scheduling reference an
// assignment id when they need role-specific rate/department/manager.
//
// Invariants (service-enforced):
//   - one active PRIMARY per (employeeId, active-window);
//   - ADDITIONAL rows may overlap freely;
//   - historical rows never mutate — a "change" closes the current
//     row and opens a new one.
model EmployeeEmploymentAssignment {
  id                String    @id @default(cuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id])
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id])
  // PRIMARY | ADDITIONAL — service enforces the single-active-primary
  // invariant. Additional roles may overlap.
  role              String
  departmentId      String?
  positionId        String?
  managerEmployeeId String?
  // FULL_TIME | PART_TIME | SEASONAL | CONTRACT — per-assignment so
  // a salaried primary + hourly seasonal secondary are both expressible.
  employmentType    String
  // Half-open interval [effectiveFrom, effectiveTo). NULL effectiveTo
  // = still open. The row is CURRENT at time `t` when
  //   effectiveFrom <= t AND (effectiveTo IS NULL OR effectiveTo > t).
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  notes             String?
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Role-specific compensation opts into this assignment via
  // EmployeeCompensation.assignmentId. Cascade left to service so a
  // deleted assignment does not silently orphan history.
  compensations     EmployeeCompensation[]  @relation("AssignmentCompensations")
  allowances        EmployeeAllowance[]
  // Payroll-3A (2026-08-28) — role-specific earnings + time entries
  // preserve assignment context so multi-role compensation resolves
  // correctly when payroll runs. See §14 of the Payroll-3A brief.
  payrollBatchEarnings PayrollBatchEarning[]
  payrollApprovedTimeEntries PayrollApprovedTimeEntry[]

  @@index([clubId, employeeId, effectiveFrom])
  @@index([employeeId, role])
}

// HR-2C Employment (2026-08-24) — Recurring employee allowance.
//
// Effective-dated. Frequency PER_PAY_PERIOD | MONTHLY | ANNUAL.
// `assignmentId` is optional — an allowance MAY be tied to a specific
// role (e.g. Vehicle allowance only for the Grounds Superintendent
// role) or MAY be employee-wide (e.g. Cell Phone allowance regardless
// of which role they're working).
//
// `allowanceType` uses the canonical suggested catalogue
// (CELL_PHONE / UNIFORM / VEHICLE / PROFESSIONAL_DUES / OTHER) but is
// stored as a free-form string so a Club may extend it. `taxable`
// is the payroll-consumption seam — the classification is admin-
// controlled and stored, never inferred.
model EmployeeAllowance {
  id            String    @id @default(cuid())
  clubId        String
  club          Club      @relation(fields: [clubId], references: [id])
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  assignmentId  String?
  assignment    EmployeeEmploymentAssignment? @relation(fields: [assignmentId], references: [id])
  // CELL_PHONE | UNIFORM | VEHICLE | PROFESSIONAL_DUES | OTHER (or Club extension)
  allowanceType String
  description   String?
  amount        Decimal
  currency      String?
  // PER_PAY_PERIOD | MONTHLY | ANNUAL
  frequency     String
  taxable       Boolean   @default(true)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  notes         String?
  createdByUserId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Payroll-3A (2026-08-28) — snapshot at run prep records the
  // effective allowance rows applied to a specific PayrollBatch.
  payrollBatchAllowanceSnapshots PayrollBatchAllowanceSnapshot[]

  @@index([clubId, employeeId, effectiveFrom])
}

// HR-2C Home refinement (2026-08-24) — Employee-scoped dismissal of
// a Home notification bar. Dismissal identity is `notificationKey`
// which encodes the underlying obligation state (e.g. a hash of the
// outstanding required-training version ids). If the obligation set
// changes, the key changes, and a fresh bar renders — dismissal is
// tied to what was dismissed, not to a generic "training bar".
//
// This is NOT a general notification framework. There is no message
// text stored here; the Home page derives message content from the
// canonical resolver at render time and only asks this table
// "has this key been dismissed?". Dismissal must never affect
// eligibility, availability, or scheduling — it is purely a Home-
// page visibility toggle.
model EmployeeHomeNotificationDismissal {
  id               String   @id @default(cuid())
  clubId           String
  club             Club     @relation(fields: [clubId], references: [id])
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  notificationKey  String
  dismissedAt      DateTime @default(now())

  @@unique([employeeId, notificationKey])
  @@index([clubId, employeeId])
}

// HR-2C B4 (2026-08-23) — Employee weekly availability.
//
// Minimal persistence to give the training-compliance guard a real
// write path. One row per employee per week; the seven booleans
// express which weekdays the employee is generally available. Notes
// carry free-text nuance (e.g. "afternoons only Wed"). The write
// service (`src/lib/hr/availability.ts`) MUST call
// `assertSchedulingEligibility` before every mutation — training
// completeness is derived, not stored, so a stale UI cannot bypass
// the gate.
model EmployeeAvailabilityWeek {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  // Monday 00:00 (club-timezone-agnostic; the service normalises).
  weekStart   DateTime
  monday      Boolean  @default(false)
  tuesday     Boolean  @default(false)
  wednesday   Boolean  @default(false)
  thursday    Boolean  @default(false)
  friday      Boolean  @default(false)
  saturday    Boolean  @default(false)
  sunday      Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, weekStart])
  @@index([clubId, weekStart])
}

// status: DRAFT | OPEN | LOCKED | POSTED
model PayrollPeriod {
  id             String    @id @default(cuid())
  clubId         String
  club           Club      @relation(fields: [clubId], references: [id])
  label          String
  startDate      DateTime
  endDate        DateTime
  payDate        DateTime
  status         String    @default("OPEN")
  lockedAt       DateTime?
  lockedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  timesheets  Timesheet[]
  runs        PayrollRun[]
  remittances PayrollRemittance[]

  @@unique([clubId, label])
  @@index([clubId, status])
  @@index([clubId, startDate, endDate])
}

// status: DRAFT | SUBMITTED | APPROVED | LOCKED
model Timesheet {
  id                 String        @id @default(cuid())
  clubId             String
  club               Club          @relation(fields: [clubId], references: [id])
  employeeId         String
  employee           Employee      @relation(fields: [employeeId], references: [id])
  periodId           String
  period             PayrollPeriod @relation(fields: [periodId], references: [id])
  status             String        @default("DRAFT")
  submittedAt        DateTime?
  approvedAt         DateTime?
  approvedByUserId   String?
  totalHours         Decimal       @default(0)
  totalOvertimeHours Decimal       @default(0)
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  entries TimesheetEntry[]

  @@unique([clubId, employeeId, periodId])
  @@index([clubId, status])
}

// kind: REGULAR | OVERTIME | STAT | VACATION | SICK | UNPAID
model TimesheetEntry {
  id           String      @id @default(cuid())
  clubId       String
  club         Club        @relation(fields: [clubId], references: [id])
  timesheetId  String
  timesheet    Timesheet   @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  workDate     DateTime
  startTime    DateTime?
  endTime      DateTime?
  totalHours   Decimal
  kind         String      @default("REGULAR")
  departmentId String?
  department   Department? @relation("TimesheetEntryDepartment", fields: [departmentId], references: [id])
  sourceType   String      @default("MANUAL")
  notes        String?

  @@index([timesheetId])
}

// kind: IN | OUT | BREAK_START | BREAK_END
model TimeClockEvent {
  id         String   @id @default(cuid())
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  kind       String
  occurredAt DateTime
  source     String   @default("MANUAL")
  lat        Float?
  lng        Float?
  notes      String?

  @@index([clubId, employeeId, occurredAt])
}

// status: DRAFT | APPROVED | POSTED | VOIDED
model PayrollRun {
  id                   String        @id @default(cuid())
  clubId               String
  club                 Club          @relation(fields: [clubId], references: [id])
  periodId             String
  period               PayrollPeriod @relation(fields: [periodId], references: [id])
  runNumber            String
  description          String?
  status               String        @default("DRAFT")
  totalGross           Decimal       @default(0)
  totalNet             Decimal       @default(0)
  totalEmployerCost    Decimal       @default(0)
  totalTaxes           Decimal       @default(0)
  totalBenefits        Decimal       @default(0)
  postedAt             DateTime?
  postedByUserId       String?
  postedJournalEntryId String?
  postedJournalEntry   JournalEntry? @relation("PayrollRunJE", fields: [postedJournalEntryId], references: [id])
  approvalRequestId    String?
  createdByUserId      String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  lines PayrollLine[]

  @@unique([clubId, runNumber])
  @@index([clubId, status])
}

model PayrollLine {
  id             String      @id @default(cuid())
  clubId         String
  club           Club        @relation(fields: [clubId], references: [id])
  runId          String
  run            PayrollRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id])
  departmentId   String?
  department     Department? @relation("PayrollLineDepartment", fields: [departmentId], references: [id])
  regularHours   Decimal     @default(0)
  overtimeHours  Decimal     @default(0)
  grossPay       Decimal     @default(0)
  taxes          Decimal     @default(0)
  benefits       Decimal     @default(0)
  netPay         Decimal     @default(0)
  deductionsJson String?
  earningsJson   String?

  @@index([runId])
  @@index([employeeId])
}

// status: PENDING | PAID | OVERDUE
model PayrollRemittance {
  id              String        @id @default(cuid())
  clubId          String
  club            Club          @relation(fields: [clubId], references: [id])
  periodId        String
  period          PayrollPeriod @relation(fields: [periodId], references: [id])
  type            String // CRA_FED | CRA_PROV | BENEFITS | WCB | UNION | OTHER
  description     String?
  amount          Decimal
  dueDate         DateTime
  status          String        @default("PENDING")
  paidApInvoiceId String?
  paidApInvoice   APInvoice?    @relation("PayrollRemittanceAP", fields: [paidApInvoiceId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([clubId, status])
}

model LabourBudget {
  id            String      @id @default(cuid())
  clubId        String
  club          Club        @relation(fields: [clubId], references: [id])
  departmentId  String?
  department    Department? @relation("LabourBudgetDepartment", fields: [departmentId], references: [id])
  periodLabel   String
  budgetedHours Decimal
  budgetedCost  Decimal
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([clubId, departmentId, periodLabel])
}

// -------------------------------------------------------------------------
// 5E. Capital Assets
// -------------------------------------------------------------------------
model AssetCategory {
  id                               String   @id @default(cuid())
  clubId                           String
  club                             Club     @relation(fields: [clubId], references: [id])
  key                              String
  name                             String
  assetAccountId                   String?
  assetAccount                     Account? @relation("AssetCatAsset", fields: [assetAccountId], references: [id])
  accumulatedDepreciationAccountId String?
  accumulatedDepreciationAccount   Account? @relation("AssetCatAccumDepr", fields: [accumulatedDepreciationAccountId], references: [id])
  depreciationExpenseAccountId     String?
  depreciationExpenseAccount       Account? @relation("AssetCatDeprExpense", fields: [depreciationExpenseAccountId], references: [id])
  defaultUsefulLifeMonths          Int      @default(60)
  defaultMethod                    String   @default("STRAIGHT_LINE")
  defaultDecliningBalanceRate      Decimal?
  isActive                         Boolean  @default(true)
  createdAt                        DateTime @default(now())

  assets CapitalAsset[]

  @@unique([clubId, key])
}

model AssetLocation {
  id       String  @id @default(cuid())
  clubId   String
  club     Club    @relation(fields: [clubId], references: [id])
  code     String
  name     String
  isActive Boolean @default(true)

  assets CapitalAsset[]

  @@unique([clubId, code])
}

// status: ACTIVE | DISPOSED | FULLY_DEPRECIATED
model CapitalAsset {
  id                        String         @id @default(cuid())
  clubId                    String
  club                      Club           @relation(fields: [clubId], references: [id])
  assetNumber               String
  name                      String
  description               String?
  categoryId                String?
  category                  AssetCategory? @relation(fields: [categoryId], references: [id])
  locationId                String?
  location                  AssetLocation? @relation(fields: [locationId], references: [id])
  departmentId              String?
  department                Department?    @relation("CapitalAssetDepartment", fields: [departmentId], references: [id])
  acquisitionDate           DateTime
  acquisitionCost           Decimal
  residualValue             Decimal        @default(0)
  usefulLifeMonths          Int            @default(60)
  depreciationMethod        String         @default("STRAIGHT_LINE")
  decliningBalanceRate      Decimal?
  accumulatedDepreciation   Decimal        @default(0)
  netBookValue              Decimal        @default(0)
  status                    String         @default("ACTIVE")
  imageStorageKey           String?
  sourceApInvoiceId         String?
  sourceApInvoice           APInvoice?     @relation("AssetSourceAP", fields: [sourceApInvoiceId], references: [id])
  acquisitionJournalEntryId String?
  acquisitionJournalEntry   JournalEntry?  @relation("AssetAcquisitionJE", fields: [acquisitionJournalEntryId], references: [id])
  createdByUserId           String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  depreciationEntries AssetDepreciationEntry[]
  maintenance         AssetMaintenanceRecord[]
  disposal            AssetDisposal?

  @@unique([clubId, assetNumber])
  @@index([clubId, status])
}

model AssetDepreciationEntry {
  id                   String        @id @default(cuid())
  clubId               String
  club                 Club          @relation(fields: [clubId], references: [id])
  assetId              String
  asset                CapitalAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  periodLabel          String
  periodEnd            DateTime
  amount               Decimal
  accumulatedAfter     Decimal
  postedJournalEntryId String?
  postedJournalEntry   JournalEntry? @relation("AssetDeprJE", fields: [postedJournalEntryId], references: [id])
  postedAt             DateTime      @default(now())
  postedByUserId       String?

  @@unique([assetId, periodLabel])
  @@index([clubId, periodLabel])
}

model AssetMaintenanceRecord {
  id          String       @id @default(cuid())
  clubId      String
  club        Club         @relation(fields: [clubId], references: [id])
  assetId     String
  asset       CapitalAsset @relation(fields: [assetId], references: [id])
  kind        String
  description String
  amount      Decimal      @default(0)
  performedAt DateTime
  performedBy String?
  apInvoiceId String?
  apInvoice   APInvoice?   @relation("AssetMaintenanceAP", fields: [apInvoiceId], references: [id])
  notes       String?
  createdAt   DateTime     @default(now())

  @@index([assetId])
}

model AssetDisposal {
  id                   String        @id @default(cuid())
  clubId               String
  club                 Club          @relation(fields: [clubId], references: [id])
  assetId              String        @unique
  asset                CapitalAsset  @relation(fields: [assetId], references: [id])
  disposalDate         DateTime
  method               String        @default("SALE") // SALE | SCRAP | DONATION
  proceeds             Decimal       @default(0)
  bookValueAtDisposal  Decimal
  gainLoss             Decimal
  notes                String?
  postedJournalEntryId String?
  postedJournalEntry   JournalEntry? @relation("AssetDisposalJE", fields: [postedJournalEntryId], references: [id])
  postedAt             DateTime      @default(now())
  postedByUserId       String?

  @@index([clubId])
}

// -------------------------------------------------------------------------
// 5F. Budgeting + Forecasting
// -------------------------------------------------------------------------
// status: DRAFT | UNDER_REVIEW | APPROVED | ACTIVE | ARCHIVED
model Budget {
  id                String     @id @default(cuid())
  clubId            String
  club              Club       @relation(fields: [clubId], references: [id])
  fiscalYearId      String
  fiscalYear        FiscalYear @relation("BudgetFY", fields: [fiscalYearId], references: [id])
  name              String
  version           Int        @default(1)
  status            String     @default("DRAFT")
  description       String?
  approvalRequestId String?
  createdByUserId   String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  lines       BudgetLine[]
  assumptions BudgetAssumption[]
  forecasts   Forecast[]

  @@unique([clubId, fiscalYearId, name, version])
  @@index([clubId, status])
}

model BudgetLine {
  id             String      @id @default(cuid())
  clubId         String
  club           Club        @relation(fields: [clubId], references: [id])
  budgetId       String
  budget         Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account     @relation("BudgetLineAccount", fields: [accountId], references: [id])
  departmentId   String?
  department     Department? @relation("BudgetLineDepartment", fields: [departmentId], references: [id])
  monthlyAmounts String // JSON [number; 12]
  annualTotal    Decimal     @default(0)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([budgetId, accountId, departmentId])
  @@index([clubId, accountId])
}

model BudgetAssumption {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id])
  budgetId  String
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  key       String
  value     String
  notes     String?
  createdAt DateTime @default(now())

  @@index([budgetId])
}

// status: DRAFT | PUBLISHED | ARCHIVED
model Forecast {
  id              String     @id @default(cuid())
  clubId          String
  club            Club       @relation(fields: [clubId], references: [id])
  fiscalYearId    String
  fiscalYear      FiscalYear @relation("ForecastFY", fields: [fiscalYearId], references: [id])
  name            String
  asOfDate        DateTime
  status          String     @default("DRAFT")
  sourceBudgetId  String?
  sourceBudget    Budget?    @relation(fields: [sourceBudgetId], references: [id])
  createdByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  lines ForecastLine[]

  @@unique([clubId, fiscalYearId, name])
  @@index([clubId, status])
}

model ForecastLine {
  id             String      @id @default(cuid())
  clubId         String
  club           Club        @relation(fields: [clubId], references: [id])
  forecastId     String
  forecast       Forecast    @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account     @relation("ForecastLineAccount", fields: [accountId], references: [id])
  departmentId   String?
  department     Department? @relation("ForecastLineDepartment", fields: [departmentId], references: [id])
  monthlyAmounts String // JSON [number; 12]
  totalAmount    Decimal     @default(0)
  notes          String?

  @@unique([forecastId, accountId, departmentId])
  @@index([clubId, accountId])
}

// =========================================================================
// Phase 6 — Enterprise reporting, governance, communications, docs, KPIs
// =========================================================================

// -------------------------------------------------------------------------
// 6A. Reporting engine
// -------------------------------------------------------------------------
// kind: BUILTIN — a system-defined report (e.g. trial balance). Code resolves
//                 the renderer by `key`. Parameters schema is JSON.
//        CUSTOM  — placeholder for future user-defined SQL/DSL reports.
model ReportDefinition {
  id               String   @id @default(cuid())
  clubId           String? // null = global (system) report; else club-scoped
  club             Club?    @relation(fields: [clubId], references: [id])
  key              String
  name             String
  description      String?
  category         String   @default("OPERATING") // FINANCIAL | OPERATING | MEMBERSHIP | GOVERNANCE
  kind             String   @default("BUILTIN")
  parametersSchema String? // JSON shape for SavedReport.parametersJson
  permissionKey    String? // e.g. "reports:financial"; null = anyone with reports:read
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  savedReports SavedReport[]
  runs         ReportRun[]

  @@unique([clubId, key])
  @@index([clubId, category])
}

model SavedReport {
  id             String           @id @default(cuid())
  clubId         String
  club           Club             @relation(fields: [clubId], references: [id])
  definitionId   String
  definition     ReportDefinition @relation(fields: [definitionId], references: [id])
  name           String
  description    String?
  parametersJson String // serialized filters / date range / dept selection
  ownerUserId    String?
  isShared       Boolean          @default(false)
  scheduleCron   String? // placeholder for scheduled runs
  lastRunId      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  runs ReportRun[]

  @@index([clubId, definitionId])
}

// status: PENDING | RUNNING | SUCCEEDED | FAILED
// A ReportRun is an immutable, audit-safe execution snapshot. resultJson stores
// the canonical rows for re-rendering / export without re-querying live data.
model ReportRun {
  id               String           @id @default(cuid())
  clubId           String
  club             Club             @relation(fields: [clubId], references: [id])
  definitionId     String
  definition       ReportDefinition @relation(fields: [definitionId], references: [id])
  savedReportId    String?
  savedReport      SavedReport?     @relation(fields: [savedReportId], references: [id])
  parametersJson   String
  status           String           @default("PENDING")
  startedAt        DateTime         @default(now())
  finishedAt       DateTime?
  rowCount         Int              @default(0)
  resultJson       String? // serialized rows (capped); large results may use a Document
  resultDocumentId String?
  errorMessage     String?
  runByUserId      String?
  createdAt        DateTime         @default(now())

  exports         ReportExport[]
  packageSections ReportingPackageSection[]

  @@index([clubId, definitionId, startedAt])
}

// status: QUEUED | PROCESSING | COMPLETED | FAILED
model ReportExport {
  id               String    @id @default(cuid())
  clubId           String
  club             Club      @relation(fields: [clubId], references: [id])
  reportRunId      String
  reportRun        ReportRun @relation(fields: [reportRunId], references: [id])
  format           String // CSV | XLSX | PDF | PPTX
  documentId       String?
  storageKey       String?
  sizeBytes        Int       @default(0)
  status           String    @default("COMPLETED")
  errorMessage     String?
  startedAt        DateTime?
  finishedAt       DateTime?
  exportedByUserId String?
  exportedAt       DateTime  @default(now())

  @@index([clubId, reportRunId])
  @@index([clubId, status])
}

// -------------------------------------------------------------------------
// 6B. Reporting packages (board / finance committee)
// -------------------------------------------------------------------------
// status: DRAFT | IN_REVIEW | APPROVED | DISTRIBUTED | ARCHIVED
model ReportingPackage {
  id                String    @id @default(cuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id])
  name              String
  description       String?
  periodLabel       String // e.g. "2026-04" or "FY2026-Q2"
  asOfDate          DateTime
  status            String    @default("DRAFT")
  version           Int       @default(1)
  audience          String    @default("BOARD") // BOARD | FINANCE_COMMITTEE | INTERNAL
  executiveSummary  String?
  createdByUserId   String?
  finalizedAt       DateTime?
  finalizedByUserId String?
  approvalRequestId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sections      ReportingPackageSection[]
  commentaries  ReportingPackageCommentary[]
  distributions PackageDistribution[]
  approvals     PackageApproval[]

  @@unique([clubId, name, version])
  @@index([clubId, status])
}

model ReportingPackageSection {
  id          String           @id @default(cuid())
  clubId      String
  club        Club             @relation(fields: [clubId], references: [id])
  packageId   String
  package     ReportingPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  title       String
  sortOrder   Int              @default(0)
  reportRunId String?
  reportRun   ReportRun?       @relation(fields: [reportRunId], references: [id])
  body        String? // free-form markdown for non-report sections
  kind        String           @default("REPORT") // REPORT | NARRATIVE | KPI_GRID | COMMENTARY

  @@index([packageId, sortOrder])
}

// status: DRAFT | FINALIZED
model ReportingPackageCommentary {
  id                  String              @id @default(cuid())
  clubId              String
  club                Club                @relation(fields: [clubId], references: [id])
  packageId           String
  package             ReportingPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  subject             String // "Variance — F&B", "Department — Golf Ops", etc.
  scope               String              @default("GENERAL") // GENERAL | VARIANCE | DEPARTMENT | ACTION_PLAN | RISK
  body                String
  followUpDate        DateTime?
  followUpOwnerUserId String?
  status              String              @default("DRAFT")
  priorCommentaryId   String?
  authorUserId        String?
  finalizedAt         DateTime?
  aiDraftId           String?
