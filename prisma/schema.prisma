// -------------------------------------------------------------------------
// 18B. Hospitality feedback — POS receipt survey workflow.
//
// Every emailed Lounge POS receipt carries a short rating link. The
// member opens it, picks 1–5 ⭐, optionally leaves a comment, and
// submits without logging in. Anything < 5 routes a notification to
// the configured department head; <= 2 is flagged as urgent service
// recovery so a manager can close the loop.
//
// Tokens: the raw token lives only in the email body. The server only
// stores SHA-256(token) so a database leak doesn't permit replay of
// outstanding invitations.
// -------------------------------------------------------------------------

// status: SENT | OPENED | RESPONDED | EXPIRED | CANCELLED
model HospitalitySurveyInvitation {
  id                   String              @id @default(cuid())
  clubId               String
  club                 Club                @relation(fields: [clubId], references: [id])
  memberId             String?
  member               Member?             @relation("HospitalitySurveyInvitationMember", fields: [memberId], references: [id])
  // Linked POS artefacts — both nullable so the model can later support
  // surveys triggered from other touch-points (events, lessons, etc.)
  // without an awkward backfill.
  posCheckId           String?
  posCheck             POSCheck?           @relation("HospitalitySurveyInvitationCheck", fields: [posCheckId], references: [id])
  posSaleId            String?
  posSale              POSSale?            @relation("HospitalitySurveyInvitationSale", fields: [posSaleId], references: [id])
  // Split-bill anchor — set when the survey was triggered by a single
  // settlement group's receipt email. Whole-check / merge-all surveys
  // leave this null. Idempotency for both shapes is enforced at the
  // application layer in ensureSurveyInvitationForCheck (lookup by
  // clubId + posCheckId + posSettlementGroupId before creating).
  posSettlementGroupId String?
  posSettlementGroup   POSSettlementGroup? @relation("HospitalitySurveyInvitationGroup", fields: [posSettlementGroupId], references: [id])
  // Which department head gets the escalation when rating < threshold.
  // Free-text key (e.g. FOOD_BEVERAGE) so clubs can extend without a
  // schema change; resolved via DepartmentNotificationRule.
  departmentKey        String
  // SHA-256 hex of the raw token. Never stores the raw token itself.
  tokenHash            String              @unique
  expiresAt            DateTime
  sentAt               DateTime            @default(now())
  respondedAt          DateTime?
  status               String              @default("SENT")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  responses HospitalitySurveyResponse[]

  // One invitation per settlement group (split-bill). Whole-check
  // invitations have posSettlementGroupId=null and are deduped via
  // application-level findFirst (composite NULL is treated as distinct
  // by SQLite/Postgres, so the DB unique can't enforce that case).
  @@unique([clubId, posSettlementGroupId])
  @@index([clubId, posCheckId])
  @@index([clubId, status])
  @@index([clubId, memberId])
  @@index([clubId, departmentKey, status])
}

// serviceRecoveryStatus: NONE | NEEDS_REVIEW | IN_PROGRESS | RESOLVED
model HospitalitySurveyResponse {
  id                    String                      @id @default(cuid())
  clubId                String
  club                  Club                        @relation(fields: [clubId], references: [id])
  invitationId          String                      @unique
  invitation            HospitalitySurveyInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  memberId              String?
  member                Member?                     @relation("HospitalitySurveyResponseMember", fields: [memberId], references: [id])
  posCheckId            String?
  posCheck              POSCheck?                   @relation("HospitalitySurveyResponseCheck", fields: [posCheckId], references: [id])
  posSaleId             String?
  posSale               POSSale?                    @relation("HospitalitySurveyResponseSale", fields: [posSaleId], references: [id])
  // Split-bill anchor — populated when the survey was completed via a
  // settlement-group invitation. Whole-check responses leave this null.
  // Mirrors the invitation's posSettlementGroupId so dashboards can
  // aggregate by group without re-joining.
  posSettlementGroupId  String?
  posSettlementGroup    POSSettlementGroup?         @relation("HospitalitySurveyResponseGroup", fields: [posSettlementGroupId], references: [id])
  departmentKey         String
  rating                Int
  comment               String?
  submittedAt           DateTime                    @default(now())
  // Submission metadata for abuse review. ipHash is SHA-256; we don't
  // need the raw IP for the dashboard.
  ipHash                String?
  userAgent             String?
  // Service-recovery lifecycle. NONE is the post-submit state for 5/5
  // ratings; everything else starts in NEEDS_REVIEW.
  serviceRecoveryStatus String                      @default("NONE")
  urgent                Boolean                     @default(false)
  // Follow-up by an internal manager.
  assignedToUserId      String?
  reviewedAt            DateTime?
  reviewedByUserId      String?
  resolvedAt            DateTime?
  resolvedByUserId      String?
  internalNotes         String?
  // Whether a department-head notification was successfully routed.
  // false + serviceRecoveryStatus != NONE = "Unrouted service feedback"
  // on the admin dashboard.
  notificationRouted    Boolean                     @default(false)
  notificationFailure   String?
  createdAt             DateTime                    @default(now())

  @@index([clubId, submittedAt])
  @@index([clubId, serviceRecoveryStatus])
  @@index([clubId, rating, submittedAt])
}

// Routing table for service-recovery notifications. One active row per
// (clubId, departmentKey) is honored; multiple inactive rows are
// allowed so a club can keep historical configurations.
model DepartmentNotificationRule {
  id              String   @id @default(cuid())
  clubId          String
  club            Club     @relation(fields: [clubId], references: [id])
  departmentKey   String
  departmentName  String
  notifyUserId    String?
  notifyEmail     String?
  active          Boolean  @default(true)
  // Ratings strictly below this value trigger a notification.
  // Default 5 = notify on anything that isn't a perfect score, matching
  // the hospitality-recovery requirement.
  thresholdRating Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // One rule per (club, department). `active=false` disables routing
  // without losing the configured email/user.
  @@unique([clubId, departmentKey])
  @@index([clubId, active])
}

// -------------------------------------------------------------------------
// 18C. Lounge dining reservations.
//
// Private-club hospitality. Member books a table, host seats them, POS
// check links to the reservation, settlement rolls spend back, and
// missed reservations charge a no-show fee through the existing AR
// service. Analytics queries hit these tables directly — no snapshot
// table; the dataset is small per club and queries stay fast.
// -------------------------------------------------------------------------

model DiningArea {
  id                String   @id @default(cuid())
  clubId            String
  club              Club     @relation(fields: [clubId], references: [id])
  name              String
  description       String?
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  // Bar, dividers, etc. — decorative shapes drawn on the floor map under
  // the tables. JSON array of {kind, x, y, width, height, rotation, label}.
  floorElementsJson String?
  // Canvas dimensions for this area's floor map. Defaults give a 1000×700
  // virtual coordinate space that fits any modern hostess station.
  canvasWidth       Int      @default(1000)
  canvasHeight      Int      @default(700)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tables       DiningTable[]
  reservations DiningReservation[]
  // Step 32 — floor-plan editor.
  floorPlans   DiningFloorPlan[]

  @@unique([clubId, name])
  @@index([clubId, active, sortOrder])
}

// status: AVAILABLE | RESERVED | SEATED | DIRTY | OUT_OF_SERVICE
model DiningTable {
  id           String     @id @default(cuid())
  clubId       String
  club         Club       @relation(fields: [clubId], references: [id])
  diningAreaId String
  diningArea   DiningArea @relation(fields: [diningAreaId], references: [id])
  tableNumber  String
  displayName  String?
  capacity     Int        @default(4)
  minPartySize Int        @default(1)
  maxPartySize Int        @default(8)
  status       String     @default("AVAILABLE")
  // Visual floor-map coordinates. Live in a virtual 1000×700 canvas; the
  // renderer scales to the viewport. xPos/yPos are the table centre,
  // width/height its bounding box, shape drives the SVG primitive.
  xPos         Float?
  yPos         Float?
  width        Int        @default(80)
  height       Int        @default(80)
  rotation     Int        @default(0)
  shape        String     @default("ROUND")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  reservations    DiningReservation[]
  posChecks       POSCheck[]             @relation("POSCheckTable")
  // Step 32 — floor-plan editor back-relation. A plan row may point
  // at this live table (for moves / resizes / renames).
  floorPlanTables DiningFloorPlanTable[] @relation("DiningFloorPlanTableSource")

  @@unique([clubId, tableNumber])
  @@index([clubId, diningAreaId, status])
}

// Step 32 — Floor-plan editor.
//
// Architecture: DiningTable rows remain the live source of truth that
// the POS/floor-map reads. DiningFloorPlan + DiningFloorPlanTable are
// the EDITOR data — pure draft layout records. Publishing reconciles
// the draft into the live DiningTable rows in a single transaction:
//   - plan rows with `sourceDiningTableId` set → update that
//     DiningTable's layout fields
//   - plan rows without a source → create a new DiningTable
//   - plan rows with `archived: true` → DiningTable.active = false
//
// status: DRAFT | LIVE | ARCHIVED. At most one LIVE plan per
// (club, area) at any time. Drafts that became LIVE get demoted to
// ARCHIVED when the next draft publishes — keeps version history.
model DiningFloorPlan {
  id            String     @id @default(cuid())
  clubId        String
  club          Club       @relation(fields: [clubId], references: [id])
  diningAreaId  String
  diningArea    DiningArea @relation(fields: [diningAreaId], references: [id])
  name          String
  status        String     @default("DRAFT")
  versionNumber Int        @default(1)
  savedById     String?
  publishedById String?
  savedAt       DateTime   @default(now())
  publishedAt   DateTime?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tables DiningFloorPlanTable[]

  @@index([clubId, diningAreaId, status])
}

model DiningFloorPlanTable {
  id                  String          @id @default(cuid())
  clubId              String
  club                Club            @relation(fields: [clubId], references: [id])
  floorPlanId         String
  floorPlan           DiningFloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  // NULL for tables that are NEW in this draft (publish will create a
  // new DiningTable). Non-NULL means this plan row is editing an
  // existing live table.
  sourceDiningTableId String?
  sourceDiningTable   DiningTable?    @relation("DiningFloorPlanTableSource", fields: [sourceDiningTableId], references: [id])
  tableNumber         String
  displayName         String?
  shape               String          @default("ROUND")
  capacity            Int             @default(4)
  xPos                Float
  yPos                Float
  width               Int             @default(80)
  height              Int             @default(80)
  rotation            Int             @default(0)
  // Plan row marked for archive — on publish, the linked live
  // DiningTable's `active` flag is set to false (NOT deleted, so
  // historical POSCheck / DiningReservation rows stay queryable).
  archived            Boolean         @default(false)
  sortOrder           Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([clubId, floorPlanId])
}

// reservationType: MEMBER | WALK_IN | GUEST
// status: REQUESTED | CONFIRMED | SEATED | COMPLETED | CANCELLED | NO_SHOW
model DiningReservation {
  id                       String       @id @default(cuid())
  clubId                   String
  club                     Club         @relation(fields: [clubId], references: [id])
  memberId                 String?
  member                   Member?      @relation("DiningReservationMember", fields: [memberId], references: [id])
  // For walk-in / guest bookings the host captures contact info inline.
  guestName                String?
  guestEmail               String?
  guestPhone               String?
  reservationType          String       @default("MEMBER")
  status                   String       @default("CONFIRMED")
  reservationDate          DateTime
  startTime                DateTime
  expectedEndTime          DateTime
  actualSeatedAt           DateTime?
  actualDepartedAt         DateTime?
  partySize                Int
  diningAreaId             String
  diningArea               DiningArea   @relation(fields: [diningAreaId], references: [id])
  tableId                  String?
  table                    DiningTable? @relation(fields: [tableId], references: [id])
  specialRequests          String?
  occasion                 String?
  // Booking-flow acknowledgements. We persist them so a dispute over
  // a no-show fee can be answered with the member's own opt-in.
  dressCodeAcknowledged    Boolean      @default(false)
  noShowFeeAcknowledged    Boolean      @default(false)
  // Confirmation email lifecycle, mirrors the POS receipt fields.
  confirmationSentAt       DateTime?
  confirmationEmailStatus  String?
  confirmationEmailAddress String?
  confirmationEmailFailure String?
  cancelledAt              DateTime?
  cancelledByUserId        String?
  cancellationReason       String?
  noShowMarkedAt           DateTime?
  noShowMarkedByUserId     String?
  noShowReason             String?
  noShowFeeChargeId        String?      @unique
  noShowFeeChargedAt       DateTime?
  hostNotes                String?
  createdById              String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  checkLinks DiningReservationCheckLink[] @relation("DiningReservationCheckLinkReservation")
  posChecks  POSCheck[]                   @relation("POSCheckReservation")

  @@index([clubId, reservationDate])
  @@index([clubId, status, reservationDate])
  @@index([clubId, memberId, reservationDate])
  @@index([clubId, tableId, status])
}

// Bridge: one reservation, one or more checks (initial slice uses
// the primary check only, but the model supports follow-up rounds).
model DiningReservationCheckLink {
  id            String            @id @default(cuid())
  clubId        String
  club          Club              @relation(fields: [clubId], references: [id])
  reservationId String
  reservation   DiningReservation @relation("DiningReservationCheckLinkReservation", fields: [reservationId], references: [id])
  posCheckId    String
  posCheck      POSCheck          @relation("DiningReservationCheckLinkCheck", fields: [posCheckId], references: [id])
  posSaleId     String?
  posSale       POSSale?          @relation("DiningReservationCheckLinkSale", fields: [posSaleId], references: [id])
  linkedAt      DateTime          @default(now())

  @@unique([clubId, posCheckId])
  @@index([clubId, reservationId])
}

// One row per club. Created on demand by getReservationSettings().
model ReservationSettings {
  id                                String   @id @default(cuid())
  clubId                            String   @unique
  club                              Club     @relation(fields: [clubId], references: [id])
  reservationIntervalMinutes        Int      @default(15)
  defaultReservationDurationMinutes Int      @default(90)
  noShowFeeAmount                   Decimal  @default(25.00)
  noShowFeeEnabled                  Boolean  @default(true)
  confirmationEmailEnabled          Boolean  @default(true)
  // Auto-confirm member bookings? When false, the reservation lands
  // in REQUESTED and the host has to confirm before the email goes.
  autoConfirmMemberReservations     Boolean  @default(true)
  dressCodeText                     String   @default("Smart-casual attire is required in all Club dining areas. Denim, athletic apparel, and head coverings are not permitted. Collared shirts are required for gentlemen.")
  noShowPolicyText                  String   @default("Please cancel at least two hours in advance. Missed reservations may be subject to a no-show fee charged to the member account.")
  contactPhone                      String?
  contactEmail                      String?
  maxPartySizeOnline                Int      @default(8)
  advanceBookingDays                Int      @default(60)
  cancellationCutoffHours           Int      @default(2)
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt
}

// -------------------------------------------------------------------------
// 18E. POS seat-level bill splitting.
//
// One row per payment group a server creates when splitting a check
// (e.g. "Seat 1 + Seat 2" → one group, "Seat 3 + Seat 4" → another).
// Each group settles independently through the existing createSale +
// completeSale engine; the resulting POSSale id is recorded here so
// AR/GL / receipt / dining history pipelines see the right slice.
// -------------------------------------------------------------------------

// status:            OPEN | PAYMENT_PENDING | SETTLED | FAILED | VOIDED
// settlementMethod:  MEMBER_ACCOUNT | QR_PAY | OTHER
model POSSettlementGroup {
  id                  String    @id @default(cuid())
  clubId              String
  club                Club      @relation(fields: [clubId], references: [id])
  posCheckId          String
  posCheck            POSCheck  @relation(fields: [posCheckId], references: [id], onDelete: Cascade)
  label               String
  status              String    @default("OPEN")
  settlementMethod    String?
  memberId            String?
  member              Member?   @relation("POSSettlementGroupMember", fields: [memberId], references: [id])
  posSaleId           String?   @unique
  posSale             POSSale?  @relation("POSSettlementGroupSale", fields: [posSaleId], references: [id])
  subtotal            Decimal   @default(0)
  taxTotal            Decimal   @default(0)
  grandTotal          Decimal   @default(0)
  createdByUserId     String?
  createdAt           DateTime  @default(now())
  settledAt           DateTime?
  // Per-group receipt-email tracking — mirrors POSCheck.receiptEmail*
  // but lives on the group so split-bill settles can record each
  // paying member's email outcome independently. NULL on legacy
  // single-group / merge-all settles (the POSCheck row carries the
  // status for those — same source-of-truth, just on a different row).
  receiptEmailStatus  String?
  receiptEmailAddress String?
  receiptEmailedAt    DateTime?
  receiptEmailFailure String?

  lines             POSCheckLine[]
  // Hospitality survey invitations + responses anchored to THIS
  // settlement group (split-bill). Whole-check / merge-all surveys
  // live on POSCheck and leave these arrays empty.
  surveyInvitations HospitalitySurveyInvitation[] @relation("HospitalitySurveyInvitationGroup")
  surveyResponses   HospitalitySurveyResponse[]   @relation("HospitalitySurveyResponseGroup")

  @@unique([posCheckId, label])
  @@index([clubId, status])
}

// -------------------------------------------------------------------------
// 18F. POS check seat assignments.
//
// One row per seat at a SEATED table. The PRIMARY seat is the host the
// waiter recorded at seating time (required by club policy — there
// must be at least one member account on every seated check). Other
// seats are optional: a server can assign a member by number OR mark
// the seat as a non-member guest with an optional name. The split-bill
// flow uses these rows for clearer per-group attribution; the kitchen
// chits already render seatNumber so this doesn't change print output.
// -------------------------------------------------------------------------
model POSCheckSeat {
  id         String   @id @default(cuid())
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id])
  posCheckId String
  posCheck   POSCheck @relation("POSCheckSeats", fields: [posCheckId], references: [id], onDelete: Cascade)
  seatNumber Int
  memberId   String?
  member     Member?  @relation("POSCheckSeatMember", fields: [memberId], references: [id])
  guestName  String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([posCheckId, seatNumber])
  @@index([clubId, posCheckId])
}

// Step 19 — QR-code payment lifecycle.
//
// A pending QR payment lives between "server picked Pay by QR" and
// "external confirmation arrived". Until status flips to CONFIRMED no
// POSSale is created, no GL is posted, no AR is charged, no receipt
// emails. The lifecycle states match the spec verbatim so reports +
// audits can pivot on them. `paymentUrl` is the scannable target;
// today it's a dev-only stable URL — when a real processor is wired
// it becomes the gateway's hosted-checkout link.
//
// status:
//   CREATED     — row written, not yet shown to the customer
//   QR_ISSUED   — server has the QR up on screen
//   PENDING     — synonym kept for spec-completeness; UI may set
//                 either QR_ISSUED or PENDING — both block close
//   CONFIRMED   — external "paid" signal received; check has been
//                 settled and `saleId` points at the resulting sale
//   DECLINED    — external refused; check stays active so the server
//                 can retry or pick a different method
//   EXPIRED     — QR window elapsed without confirmation
//   CANCELLED   — server backed out before any external signal
model POSQRPayment {
  id            String    @id @default(cuid())
  clubId        String
  club          Club      @relation(fields: [clubId], references: [id])
  posCheckId    String
  posCheck      POSCheck  @relation("POSQRPaymentCheck", fields: [posCheckId], references: [id], onDelete: Cascade)
  // The member who would have been billed if the check were charged
  // to a member account. Carried through so the receipt email + the
  // member's dining history still resolve when the table was QR-paid.
  memberId      String?
  member        Member?   @relation("POSQRPaymentMember", fields: [memberId], references: [id])
  status        String    @default("QR_ISSUED")
  amount        Decimal
  paymentUrl    String
  expiresAt     DateTime?
  confirmedAt   DateTime?
  declinedAt    DateTime?
  expiredAt     DateTime?
  cancelledAt   DateTime?
  failureReason String?
  // Filled when status flips to CONFIRMED and the underlying sale is
  // posted. Lets the receipt path resolve to the POSSale without an
  // extra round-trip through POSCheck.
  posSaleId     String?   @unique
  posSale       POSSale?  @relation("POSQRPaymentSale", fields: [posSaleId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clubId, posCheckId])
  @@index([clubId, status])
}

// ===================================================================
// Reporting Ledger — Phase 2a persistence
// ===================================================================
//
// Backs `PrismaReportingLedger` (src/lib/reporting/ledger/prisma-ledger.ts).
// One row per snapshot of any of the 8 ledger entity kinds (trial-
// balance, balance-sheet, income-statement, budget, prior-year,
// ar-aging, payroll, capital-project). Hybrid storage:
//
//   • indexed columns — clubId, entityKind, period keys, batch state,
//     payload hash — drive every read API the ledger exposes.
//   • payloadJson    — the full entity-specific snapshot shape,
//     stored as JSON (TEXT on SQLite, jsonb-portable on Postgres).
//
// See docs/reporting-ledger-storage-decision.md for the rationale.
//
// IMMUTABILITY: rows are never updated in place. Replacements insert
// a new row with a new snapshotId; old rows stay for audit.

model ReportingLedgerBatch {
  batchId      String    @id
  clubId       String
  sourceSystem String
  // "pending" | "committed" | "rolled-back"
  state        String    @default("pending")
  // Optional human label and filename — preserved for the import
  // audit trail (admin UI "show me batch X" lists every snapshot
  // written under this batch with its source file).
  notes        String?
  sourceFile   String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?

  snapshots ReportingLedgerSnapshot[]

  @@index([clubId, state])
  @@index([clubId, openedAt])
}

model ReportingLedgerSnapshot {
  // Identity
  snapshotId String @id
  clubId     String
  // "trial-balance" | "balance-sheet" | "income-statement" |
  // "budget" | "prior-year" | "ar-aging" | "payroll" | "capital-project"
  entityKind String

  // Lifecycle
  batchState    String                @default("committed") // "pending" | "committed" | "rolled-back"
  importBatchId String?
  batch         ReportingLedgerBatch? @relation(fields: [importBatchId], references: [batchId])

  // Provenance + audit metadata
  // capturedAt — when the writer received this snapshot (drives
  // latest-wins ordering at read time).
  capturedAt   DateTime
  // createdAt — when this physical row was inserted into the DB.
  createdAt    DateTime @default(now())
  // importedAt — when the original import that produced this
  // snapshot was performed. Equal to capturedAt for fresh imports;
  // may differ when a snapshot is replayed from a prior batch.
  importedAt   DateTime @default(now())
  sourceSystem String
  // Optional source file name — populated for file-based imports
  // (e.g. Jonas CSV) so the admin import history can show which
  // file produced which snapshot.
  sourceFile   String?
  // "accounting" | "operational" | "demo" | "derived"
  dataSource   String
  notes        String?

  // Period keys — nullable because they're entity-dependent. Indexed
  // jointly with (clubId, entityKind) to make point-in-time and
  // period reads cheap.
  // - trial-balance / balance-sheet / ar-aging / capital-project
  //   use `asOf`.
  // - income-statement / payroll use periodStart + periodEnd.
  // - budget / prior-year use fiscalYearLabel (+ version on the
  //   snapshot payload).
  asOf            DateTime?
  periodStart     DateTime?
  periodEnd       DateTime?
  fiscalYearLabel String?
  // Human-readable period label — e.g. "May 2026" or "FY2026 P5".
  // Derived from period keys at write time; included for log /
  // admin-UI display without a Date.toLocaleString pass.
  reportingPeriod String?

  // Idempotency — SHA-256 of value-bearing payload (snapshotId,
  // capturedAt, importBatchId, notes are excluded so re-imports of
  // bit-identical data hash the same).
  payloadHash String

  // Snapshot payload (the entity-specific shape).
  payloadJson String

  // Indexes that match every read API path:
  @@index([clubId, entityKind, asOf])
  @@index([clubId, entityKind, periodEnd])
  @@index([clubId, entityKind, fiscalYearLabel])
  @@index([clubId, entityKind, batchState])
  @@index([clubId, payloadHash])
  @@index([importBatchId])
}

// ===================================================================
// SPRINT 2 — Outlook / Work Intake integration (2026-07-19)
// ===================================================================
// Every model below is ADDITIVE. No existing table or column is
// altered. See docs/adr/0001-work-intake-origin-architecture.md for
// the rationale behind the source-neutral WorkIntakeItem +
// per-source link-table pattern.
//
// Enum-style columns use TEXT + string constants per the top-of-file
// portability rule. Valid values are enumerated inline.
//
// Tenancy: every table below carries clubId. Reads must be tenant-
// scoped via src/lib/work-intake/tenant.ts.

// -------------------------------------------------------------------
// Work Intake — canonical orchestration layer
// -------------------------------------------------------------------
// A source-neutral row that Mission Control renders. Orchestration
// state (owner, status, classification, defer, resolve) lives here,
// NEVER on the origin table. The origin (email, invoice, weather
// alert, etc.) is reached via a per-source link table.
//
// Display fields are denormalised for cheap Mission Control reads.
// The source materialiser is the ONE authoritative writer of every
// display_ column and every classification_ column (until a user
// override lands, see classificationOverriddenByUserId). Ad-hoc
// writes from the source ingester are forbidden — see
// src/lib/work-intake/materializer.ts for the contract.
model WorkIntakeItem {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id])

  // Orchestration state. User-owned. NEVER overwritten by a resync.
  //   OPEN | IN_PROGRESS | DEFERRED | RESOLVED | INFORMATIONAL | SUPPRESSED
  status           String    @default("OPEN")
  ownerUserId      String?
  owner            User?     @relation("WorkIntakeOwner", fields: [ownerUserId], references: [id])
  judgmentRequired Boolean   @default(false)
  deferredUntil    DateTime?
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedBy       User?     @relation("WorkIntakeResolvedBy", fields: [resolvedByUserId], references: [id])

  // Classification. classificationConfidence describes the STRENGTH
  // of the inference, not whether a code branch executed. A rule
  // match may be high-confidence (sender domain + PDF invoice) or
  // low (keyword only) — never automatically 1.0.
  //   classificationMethod: RULE | AI | USER
  classification                   String?
  classificationReason             String?
  classificationMethod             String?
  classificationConfidence         Float?
  classificationRuleKey            String?
  classificationRuleVersion        Int?
  classificationOverriddenByUserId String?
  classificationOverriddenBy       User?     @relation("WorkIntakeClassOverride", fields: [classificationOverriddenByUserId], references: [id])
  classificationOverriddenAt       DateTime?

  // Denormalised display projection. Maintained by materialisers via
  // refreshDisplayProjection(). Mission Control MUST NOT reconstruct
  // these from origin data at read time.
  displaySourceLabel    String
  displaySender         String
  displaySubject        String
  displayPreview        String
  displayReceivedAt     DateTime
  displayHasAttachments Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sprint 3 Checkpoint 15B (2026-07-24) — see prisma-postgres schema
  // for the canonical doc block. Mirrored here so `prisma generate`
  // against the SQLite dev schema stays consistent.
  lastAnalysedAt DateTime?

  // Sprint 3 · Checkpoint 15S (2026-07-29) — composite analyser
  // version at time of the most-recent successful analysis. Combines
  // every analyser module's version (parse-invoice, supplier-extract,
  // line-items-extract, tax-reconcile, economic-purpose,
  // gl-recommend, analyse) into a single fingerprint. When the
  // projection reads a WorkIntakeItem and the current composite
  // does not match this value, controlled reanalysis is triggered
  // instead of silently mixing old + new logic.
  analysisVersion String?

  // Sprint 3 · Checkpoint 16G Stage B (2026-08-04) — work-domain
  // taxonomy. The renderer picks the correct card + fields + actions
  // by workDomain, NOT by the legacy `classification` string (which
  // remains for the ingestion classifier's own bookkeeping).
  //   workDomain    — which business function owns this item
  //   workIntent    — what the user needs to do
  //   workSubtype   — domain-specific narrower kind (nullable)
  //   workDomainConfidence — 0.0..1.0
  //   workDomainSupportingEvidenceJson — audit trail of why
  workDomain                       String? // ACCOUNTS_PAYABLE | ACCOUNTS_RECEIVABLE | PAYROLL | MEMBERSHIP | COMMUNICATIONS | GOVERNANCE | OPERATIONS | HOSPITALITY | INFORMATIONAL | GENERAL
  workIntent                       String? // REVIEW | APPROVE | RESPOND | COLLECT | RESOLVE | INFORM | SCHEDULE | CREATE_RECORD | POST | OTHER
  workSubtype                      String?
  workDomainConfidence             Float?
  workDomainSupportingEvidenceJson String? // JSON array
  workDomainAlternativesJson       String? // JSON array of {domain, confidence}
  workDomainRequiresReview         Boolean   @default(false)
  workDomainClassifiedAt           DateTime?
  workDomainClassifierVersion      String?

  emailOrigins      EmailWorkIntakeOrigin[]
  origins           WorkIntakeOrigin[]
  findings          WorkIntakeFinding[]
  activity          WorkIntakeActivity[]
  apReviewOverrides ApReviewOverride[]
  reads             WorkIntakeItemRead[]

  // Sprint 3 · Checkpoint 15S — persistent source-to-canonical-AP
  // relationship. Every email attachment that becomes part of an AP
  // workflow gets an ApIntakeSource row; the AP intake this record
  // resolves to is the ONE founder-visible workflow for that
  // document. Multiple emails carrying the same PDF share ONE
  // canonical AP intake. See ApIntakeSource model below.
  apIntakeSourcesForCanonical ApIntakeSource[] @relation("ApIntakeSourceCanonical")

  // Sprint 3 · Checkpoint 16G Stage B — user corrections to
  // workDomain / workSubtype. Corrections inform future generalized
  // classification; no subject-specific hardcoded rules.
  domainCorrections   WorkDomainCorrection[]
  proposedCommitments ProposedCommitment[]
  completionEvents    WorkCompletionEvent[]
  restorationEvents   WorkRestorationEvent[]

  @@index([clubId, status, displayReceivedAt])
  @@index([ownerUserId, status])
  @@index([clubId, updatedAt])
  @@index([clubId, workDomain])
}

// Sprint 3 · Checkpoint 16H completion (2026-08-05) — audit record
// for restoring a completed Work Intake back to Active. The
// operation is asymmetric: restoration returns the WI to the
// visible feed, but does NOT reverse accounting, does NOT resend
// replies, does NOT move archived Outlook mail back to Inbox.
model WorkRestorationEvent {
  id                     String         @id @default(cuid())
  clubId                 String
  workIntakeItemId       String
  workIntakeItem         WorkIntakeItem @relation(fields: [workIntakeItemId], references: [id], onDelete: Cascade)
  restoredByUserId       String
  restoredAt             DateTime       @default(now())
  priorCompletionEventId String?
  reason                 String?

  @@index([clubId, restoredAt])
  @@index([workIntakeItemId])
}

// Sprint 3 · Checkpoint 16H (2026-08-04) — canonical completion
// event. Every place that transitions a Work Intake item to a
// terminal state emits ONE of these. Downstream services (Outlook
// archive worker, audit log, analytics) consume them without each
// caller having to know about every downstream side-effect.
model WorkCompletionEvent {
  id                String         @id @default(cuid())
  clubId            String
  workIntakeItemId  String
  workIntakeItem    WorkIntakeItem @relation(fields: [workIntakeItemId], references: [id], onDelete: Cascade)
  completedByUserId String
  completedAt       DateTime       @default(now())
  completionType    String // RESOLVED | POSTED_AND_CLEARED | REPLIED_AND_CLOSED | APPROVED_AND_COMPLETED | OTHER
  metadataJson      String?

  archiveMutations OutlookArchiveMutation[]

  @@index([clubId, completedAt])
  @@index([workIntakeItemId])
}

// Sprint 3 · Checkpoint 16H (2026-08-04) — durable record of a
// reply sent through the connected user's Outlook mailbox from
// Spectre. Never duplicates the raw body — the actual email lives
// in Outlook Sent Items; this row records the send attempt +
// outcome for audit, idempotency, and delta-sync recognition.
model OutlookReplyMutation {
  id                   String    @id @default(cuid())
  clubId               String
  workIntakeId         String
  mailboxConnectionId  String
  sourceEmailMessageId String
  initiatedByUserId    String
  mode                 String // REPLY | REPLY_ALL
  status               String    @default("DRAFT") // DRAFT | PENDING | SENDING | SENT | FAILED_RETRYABLE | FAILED_TERMINAL | CANCELLED
  graphMessageId       String?
  graphConversationId  String?
  sentAt               DateTime?
  attemptCount         Int       @default(0)
  errorCode            String?
  idempotencyKey       String    @unique
  bodyCiphertext       String? // Optional encrypted draft body (KMS envelope)
  bodySecretRef        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([clubId, createdAt])
  @@index([workIntakeId])
  @@index([sourceEmailMessageId])
}

// Sprint 3 · Checkpoint 16H (2026-08-04) — durable record of an
// Outlook archive move triggered by a Spectre completion event.
