// -------------------------------------------------------------------
// Mailbox — connections, access, subscriptions, messages, attachments
// -------------------------------------------------------------------
// A user's connected Microsoft 365 mailbox. Tokens are KMS envelope
// values; plaintext exists only in memory during Graph calls.
// mailboxType: PERSONAL (Phase B) | SHARED (later phase).
// status: CONNECTED | REAUTH_REQUIRED | DISCONNECTED | DELETED
model MailboxConnection {
  id                String @id @default(cuid())
  userId            String
  user              User   @relation(fields: [userId], references: [id])
  clubId            String
  club              Club   @relation(fields: [clubId], references: [id])
  provider          String
  mailboxType       String @default("PERSONAL")
  externalUserId    String
  microsoftTenantId String
  connectedEmail    String

  // KMS envelope secret references. accessTokenSecretRef and
  // refreshTokenSecretRef point at KMS-encrypted blobs. See
  // src/lib/kms/index.ts.
  // Sprint 2 B3 hardening (2026-07-19) — nullable token refs.
  // A row EXISTS only when a Microsoft connection has been made; but
  // the credentials themselves may be retired without deleting the
  // row (disconnect preserves connection identity + audit history).
  // Non-null ciphertext means "usable credentials"; null means "no
  // usable credentials, do not attempt Graph calls". The disconnect
  // flow explicitly nulls these and deletes the KMS metadata rows —
  // there is no encrypted-empty-string convention any longer.
  accessTokenSecretRef  String?
  refreshTokenSecretRef String?
  accessTokenExpiresAt  DateTime
  grantedScopes         String

  // Sprint 2 B2 (2026-07-19) — token-rotation concurrency guard.
  // Every refresh reads the current tokenRevision, performs the MSAL
  // refresh, then writes updated token references via a CAS UPDATE
  // whose WHERE clause pins tokenRevision. If another worker won the
  // race, the CAS updates zero rows and the loser reloads and reuses
  // the winner's newer tokens. See src/lib/mailbox/token-cache.ts.
  tokenRevision Int @default(0)

  status               String    @default("CONNECTED")
  lastSuccessfulSyncAt DateTime?
  lastAttemptedSyncAt  DateTime?
  lastSyncError        String?
  deltaLink            String?

  disconnectedAt       DateTime?
  disconnectedByUserId String?
  disconnectedBy       User?     @relation("MailboxDisconnectedBy", fields: [disconnectedByUserId], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accesses      MailboxAccess[]
  subscriptions GraphSubscription[]
  messages      EmailMessage[]
  syncRuns      MailboxSyncRun[]

  // HR-2B.3 tail — back-relation for the Club's designated outbound mailbox.
  clubsUsingAsOutbound Club[] @relation("ClubOutboundMailbox")

  @@unique([userId, clubId, provider, externalUserId])
  @@index([clubId, status])
  @@index([microsoftTenantId, externalUserId])
}

model MailboxAccess {
  id                  String            @id @default(cuid())
  mailboxConnectionId String
  mailboxConnection   MailboxConnection @relation(fields: [mailboxConnectionId], references: [id], onDelete: Cascade)
  userId              String
  user                User              @relation("MailboxAccessUser", fields: [userId], references: [id])
  // OWNER | MANAGER | TRIAGE | VIEWER
  role                String
  grantedByUserId     String?
  grantedBy           User?             @relation("MailboxAccessGrantedBy", fields: [grantedByUserId], references: [id])
  grantedAt           DateTime          @default(now())
  revokedAt           DateTime?
  revokedByUserId     String?
  revokedBy           User?             @relation("MailboxAccessRevokedBy", fields: [revokedByUserId], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([mailboxConnectionId, userId, role])
  @@index([userId, revokedAt])
}

// A live Microsoft Graph change-notification subscription. Renewed
// by the MAILBOX_RENEW_SUBSCRIPTION job. clientState is stored as
// a KMS secret reference and validated on every webhook callback.
// lifecycleState: ACTIVE | REAUTH_REQUIRED | REMOVED
model GraphSubscription {
  id                      String            @id @default(cuid())
  mailboxConnectionId     String
  mailboxConnection       MailboxConnection @relation(fields: [mailboxConnectionId], references: [id], onDelete: Cascade)
  microsoftSubscriptionId String            @unique
  resource                String
  changeTypes             String
  clientStateSecretRef    String
  expirationDateTime      DateTime
  lifecycleState          String            @default("ACTIVE")
  lastRenewalAt           DateTime?
  lastNotificationAt      DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([expirationDateTime])
  @@index([mailboxConnectionId, lifecycleState])
}

// Canonical email evidence. Body HTML is sanitised BEFORE persistence.
// Ingest is idempotent on (mailboxConnectionId, graphMessageId).
// Soft-delete (softDeletedAt) is used when Graph reports the message
// gone; the row and any orchestration state on WorkIntakeItem survive.
model EmailMessage {
  id                  String            @id @default(cuid())
  clubId              String
  mailboxConnectionId String
  mailboxConnection   MailboxConnection @relation(fields: [mailboxConnectionId], references: [id], onDelete: Cascade)

  graphMessageId    String
  immutableId       String?
  internetMessageId String?
  conversationId    String?

  senderName        String
  senderAddress     String
  recipientsJson    String
  subject           String
  receivedAt        DateTime
  sentAt            DateTime?
  preview           String
  bodyHtmlSanitized String?
  bodyTextExtract   String?
  importance        String    @default("normal")
  isRead            Boolean   @default(false)
  hasAttachments    Boolean   @default(false)
  webLink           String?

  lastSyncedAt  DateTime
  softDeletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments       EmailAttachment[]
  workIntakeOrigins EmailWorkIntakeOrigin[]
  apIntakeSources   ApIntakeSource[]

  // Sprint 2 B4.1 (2026-07-19) — quarantine flag. A message that
  // failed to ingest N times in a row is marked here and skipped by
  // future sync passes so a single malformed message can never block
  // an entire mailbox. Set by the sync loop after `retryAttempts`
  // hits the cap; visible in the sync-run summary counts.
  ingestFailedAt   DateTime?
  ingestFailReason String?
  retryAttempts    Int       @default(0)

  @@unique([mailboxConnectionId, graphMessageId])
  @@index([clubId, receivedAt])
  @@index([conversationId])
}

// Sprint 2 B4.1 (2026-07-19) — Durable sync-run record.
//
// One row per Sync now (or auto-triggered) sync request. The row
// is created BEFORE any Graph call so a worker crash between
// enqueue and first Graph fetch is still observable ("sync queued").
// Counts are refreshed as the run progresses; final status is
// COMPLETED / PARTIAL / DELAYED / TERMINAL / SKIPPED.
//
// Deliberately NOT stored: message subjects, sender addresses,
// attachment filenames. Per §5 of B4.1 directive.
//
//   status: QUEUED | RUNNING | COMPLETED | PARTIAL | DELAYED | TERMINAL | SKIPPED
model MailboxSyncRun {
  id                  String            @id @default(cuid())
  clubId              String
  mailboxConnectionId String
  mailboxConnection   MailboxConnection @relation(fields: [mailboxConnectionId], references: [id], onDelete: Cascade)

  status      String    @default("QUEUED")
  triggerKind String // OAUTH_CALLBACK | SYNC_NOW | RECONCILIATION
  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  messagesExamined           Int @default(0)
  messagesImported           Int @default(0)
  messagesUpdated            Int @default(0)
  intakeCreatedActionable    Int @default(0)
  intakeCreatedInformational Int @default(0)
  messagesSuppressed         Int @default(0)
  messagesFailed             Int @default(0)
  retryCount                 Int @default(0)

  // Sanitised failure category — one of the MAILBOX_ERROR_CODE
  // strings. Never the raw Microsoft message. Nullable when the run
  // completed cleanly.
  failureCategory String?

  @@index([mailboxConnectionId, queuedAt])
  @@index([clubId, queuedAt])
}

// Sprint 2 B2 (2026-07-19) — durable OAuth transaction state.
// Cookie-based session state cannot safely hold all fields
// required by the founder's §3 threat model (initiating user,
// initiating club, PKCE verifier, nonce, expiration, single-use).
// One row per outbound connect attempt. Consumed on callback
// (consumedAt + outcome). Reaper job deletes expired unconsumed
// rows periodically.
//
// outcome (nullable while in-flight):
//   SUCCESS | STATE_MISMATCH | REPLAY | EXPIRED | DENIED |
//   PERSONAL_ACCOUNT | TENANT_MISMATCH | USER_MISMATCH |
//   CLUB_MISMATCH | CODE_EXCHANGE_FAILED | ME_FAILED |
//   IDENTITY_INVALID | DUPLICATE_MAILBOX | INTERNAL_ERROR
model MailboxOAuthTransaction {
  id           String    @id @default(cuid())
  // Random opaque state parameter Microsoft echoes back on callback.
  // Cryptographically random via crypto.randomBytes(32).base64url().
  state        String    @unique
  userId       String
  user         User      @relation("MailboxTransactionUser", fields: [userId], references: [id])
  clubId       String
  club         Club      @relation("MailboxTransactionClub", fields: [clubId], references: [id])
  // PKCE code verifier — SERVER-SIDE ONLY, never exposed to the
  // browser. Microsoft receives its SHA-256 hash as the code
  // challenge; the plaintext verifier is presented on token exchange.
  pkceVerifier String
  // OIDC nonce — asserted in the returned id_token.
  nonce        String
  // Post-callback internal redirect target, validated against an
  // allowlist. Never accept an absolute URL.
  returnPath   String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?
  outcome      String?

  // Sprint 3 · Checkpoint 16H remediation (2026-08-05) — expected
  // Microsoft identity for an "update permissions on existing
  // mailbox" reconnect. When populated at startConnect time, the
  // callback validates the returned id_token's oid + tid against
  // these values BEFORE any token write. login_hint on the
  // authorization URL is an identity-selection aid, NOT a security
  // control; the server-side comparison is authoritative.
  expectedMailboxConnectionId String?
  expectedExternalUserId      String?
  expectedExternalTenantId    String?

  @@index([userId, clubId, createdAt])
  @@index([expiresAt])
}

// Attachment metadata. Bytes are lazy-fetched via
// MAILBOX_ATTACHMENT_FETCH and stored via the S3 storage adapter
// under clubs/{clubId}/mailbox/{connectionId}/{attachmentId}.
// storageState: METADATA_ONLY | STORED | REFUSED_TOO_LARGE | REFUSED_UNSAFE_TYPE
// scanState:    NOT_SCANNED   | CLEAN  | INFECTED           | ERROR
model EmailAttachment {
  id                String       @id @default(cuid())
  emailMessageId    String
  emailMessage      EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  graphAttachmentId String
  filename          String
  contentType       String
  sizeBytes         Int
  isInline          Boolean      @default(false)
  storageState      String       @default("METADATA_ONLY")
  storageKey        String?
  scanState         String       @default("NOT_SCANNED")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  apIntakeSources ApIntakeSource[] @relation("ApIntakeSourceByAttachment")

  @@unique([emailMessageId, graphAttachmentId])
}

// Sprint 3 · Checkpoint 15S (2026-07-29) — persistent source-to-
// canonical-AP relationship.
//
// Founder rule (architectural reset, §Required architectural correction):
//   "Use SHA deduplication to reuse document bytes and document
//    analysis, but do not use SHA equality alone as the permanent
//    workflow relationship. When a new email attachment resolves to
//    an existing IngestedDocument, persist an explicit link from
//    the new source attachment/email intake to the canonical AP
//    intake or canonical AP analysis."
//
// Row semantics: one row per (EmailAttachment) that becomes part of
// an AP workflow. The `canonicalApIntakeId` names the ONE
// AP_INVOICE_REVIEW WorkIntakeItem the founder sees for this
// invoice. Multiple emails carrying the same PDF resolve to the
// SAME `canonicalApIntakeId`.
//
// Tenant safety: every row carries `clubId`; foreign keys guarantee
// same-tenant. Cross-tenant SHA equality never establishes a link.
//
// Relationship classification:
//   ORIGINAL_SUBMISSION — this attachment is the first submission of
//                         the invoice document to the AP workflow.
//   RETRANSMISSION      — the attachment restates a document already
//                         under an unresolved AP workflow (e.g.
//                         "Pt2" of the founder's forwarded chain).
//   FORWARDED_COPY      — a different party forwards the same
//                         invoice into the same mailbox.
//   POSSIBLE_DUPLICATE  — the document matches an AP workflow that
//                         is already resolved / posted / voided /
//                         rejected. The row does NOT reopen the
//                         workflow; it records the receipt for
//                         audit + surfaces via history.
model ApIntakeSource {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id])

  emailAttachmentId  String           @unique
  emailAttachment    EmailAttachment  @relation("ApIntakeSourceByAttachment", fields: [emailAttachmentId], references: [id], onDelete: Cascade)
  emailMessageId     String
  emailMessage       EmailMessage     @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  ingestedDocumentId String
  ingestedDocument   IngestedDocument @relation(fields: [ingestedDocumentId], references: [id], onDelete: Cascade)

  canonicalApIntakeId String
  canonicalApIntake   WorkIntakeItem @relation("ApIntakeSourceCanonical", fields: [canonicalApIntakeId], references: [id], onDelete: Cascade)

  relationship          String
  reason                String?
  analysisVersionAtLink String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId, canonicalApIntakeId])
  @@index([clubId, emailMessageId])
  @@index([clubId, ingestedDocumentId])
}

// Sprint 3 · Phase 4 Slice 5.7B (2026-08-09) — durable, GLOBAL product
// reference knowledge. §6 Option C: product FACTS (manufacturer, model,
// object type, component relationships) are reusable across tenants;
// tenant ACCOUNTING conclusions (department, capital, GL) are never
// stored here and always re-derive per-tenant via analyseIngestedInvoice.
//
// Privacy invariants (§7, §29): this table must NEVER contain
//   clubId · invoiceNumber · workIntakeItemId · emailMessageId
//   · member/customer/vendor identity · bank/tax/payment data
//   · full webpage bodies · full invoice text.
// The persistence audit in ap-intelligence/tests/product-reference-privacy.test.ts
// enforces this at CI.
model ProductReference {
  id String @id @default(cuid())

  // Canonical dedupe key: `${MANUFACTURER}|${MODEL}|${PART}` uppercased.
  // Empty segments allowed (e.g. no partNumber). Unique globally.
  normalizedKey String @unique

  normalizedManufacturer String
  normalizedModel        String
  normalizedPartNumber   String?

  // Derived facts (from provider evidence). Nullable when research is
  // pending / inconclusive.
  productFamily        String?
  objectType           String?
  // Bounded structured facts. Never a full webpage body.
  identityEvidenceJson String  @default("[]")
  sourceEvidenceJson   String  @default("[]")

  evidenceQuality String @default("UNKNOWN") // HIGH | MEDIUM | LOW | UNKNOWN
  confidence      Float  @default(0)

  // §9 research state model — explicit, never inferred from null fields.
  researchState String @default("PENDING")
  // NOT_REQUIRED | PENDING | RUNNING | COMPLETED
  // | FAILED_RETRYABLE | FAILED_TERMINAL | NO_RESULT | CONFLICTING_EVIDENCE

  // §12 versioning — factual evidence is re-usable across accounting
  // releases so long as the evidence schema version matches. Bump
  // researchVersion to force controlled re-research.
  provider              String?
  providerVersion       String?
  researchVersion       String  @default("1")
  evidenceSchemaVersion String  @default("1")

  // §8 TTL policy — identity is long-lived; price observations decay
  // faster. Nullable expiresAt = no expiry.
  identityVerifiedAt DateTime?
  identityExpiresAt  DateTime?
  priceExpiresAt     DateTime?

  // Operational counters (§17 retry policy).
  researchAttempts      Int       @default(0)
  lastResearchAttemptAt DateTime?
  lastResearchError     String?
  nextRetryAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([researchState])
  @@index([normalizedManufacturer, normalizedModel])
  @@index([nextRetryAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// HR-1 (2026-08-16) — Canonical people, employment & payroll infrastructure.
//
// Architectural invariants (enforced by service layer + source-contract
// pin tests under tests/hr/):
//
//   1. Tenant isolation — every table below carries `clubId` and is
//      indexed on it. EmployeeOnboardingQuestion is the sole exception:
//      `clubId String?` allows a global default catalogue; inserts of
//      global-scope questions require `system:super_admin` at the
//      service layer.
//   2. Effective-dating uses half-open intervals `[effectiveFrom,
//      effectiveTo)` — an ACTIVE record has `effectiveTo IS NULL` OR
//      `effectiveTo > now()`. Point-in-time reads select the row
//      where `effectiveFrom <= asOf < effectiveTo` (or `effectiveTo
//      IS NULL`). See src/lib/hr/employment-periods.ts and
//      src/lib/hr/compensation.ts in the next-wave slice.
//   3. All ciphertext columns end in `SecretRef` and hold a KMS
//      envelope-encryption blob under scope "HR" (src/lib/kms).
//      Plaintext columns are FORBIDDEN alongside them.
//   4. Reveal-of-plaintext actions (revealSin, revealBanking,
//      revealTax) use `assertSensitiveActionAllowed()` — NOT
//      `assertPostingAllowed()` — because reads do not gate on the
//      posting engine's training-mode / support-readonly rules.
//   5. Onboarding response `status` defaults to `"PENDING"` — never
//      `"COMPLETE"`. Only an approver flip via the state-transition
//      log may promote to `"COMPLETE"`.
// ═══════════════════════════════════════════════════════════════════════════

// Effective-dated employment history. Half-open interval semantics:
// `[effectiveFrom, effectiveTo)`. The currently-active period has
// `effectiveTo IS NULL` OR `effectiveTo > now()`. Only one active
// period per employee at a time — enforced in the service layer
// with a partial-unique idiom (Postgres partial index is optional;
// the invariant is authoritative in code + covered by regression
// test).
model EmploymentPeriod {
  id                String    @id @default(cuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id])
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  // FULL_TIME | PART_TIME | SEASONAL | CONTRACT
  employmentType    String
  // HIRE | REHIRE | TRANSFER | PROMOTION | DEMOTION | LEAVE_START |
  // LEAVE_END | TERMINATION_VOLUNTARY | TERMINATION_INVOLUNTARY
  reason            String
  positionId        String?
  departmentId      String?
  managerEmployeeId String?
  actorUserId       String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // A composite index on (employeeId, effectiveFrom, effectiveTo)
  // was considered. The point-in-time read planner in Postgres uses
  // the (employeeId, effectiveFrom) index and applies `effectiveTo
  // IS NULL OR effectiveTo > $asOf` as a filter — the additional
  // effectiveTo column contributes little to selectivity because
  // most rows for one employee have distinct effectiveFrom values.
  // Adding it is deferred until read patterns prove otherwise.
  @@index([clubId])
  @@index([employeeId, effectiveFrom])
}

// Effective-dated compensation history. Same half-open interval
// discipline as EmploymentPeriod. Every hire / raise / demotion
// creates a new row; nothing is UPDATE-ed after being written
// except `effectiveTo` when a newer row supersedes it.
model EmployeeCompensation {
  id            String    @id @default(cuid())
  clubId        String
  club          Club      @relation(fields: [clubId], references: [id])
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  // HOURLY | SALARY | COMMISSION | PIECE_RATE
  cadence       String
  // Precise money — never Float.
  rate          Decimal
  // ISO 4217 (CAD, USD, ...). Nullable falls back to
  // ClubProfile.defaultCurrency.
  currency      String?
  // Optional override — e.g. seasonal / probationary rate note.
  notes         String?
  actorUserId   String?
  actor         User?     @relation("EmployeeCompensationActor", fields: [actorUserId], references: [id])
  // HR-2C Employment (2026-08-24) — optional role-specific compensation.
  // When null, this row is employee-wide (legacy — backwards compatible
  // with existing rows). When set, the rate applies only to hours
  // worked / salary associated with the referenced assignment. Payroll
  // consumers must handle both branches.
  assignmentId  String?
  assignment    EmployeeEmploymentAssignment? @relation("AssignmentCompensations", fields: [assignmentId], references: [id])
  createdAt     DateTime  @default(now())

  @@index([clubId])
  @@index([employeeId, effectiveFrom])
  @@index([assignmentId, effectiveFrom])
}

// One-per-Employee payroll profile. Foundational configuration for
// future payroll runs. Does NOT hold calculated pay values — those
// remain on PayrollLine / PayrollRun.
model PayrollProfile {
  id                  String    @id @default(cuid())
  clubId              String
  club                Club      @relation(fields: [clubId], references: [id])
  employeeId          String    @unique
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // CA-FED | CA-ON | CA-BC | ... (jurisdiction where taxes remit).
  jurisdiction        String
  // Named pay group (WEEKLY_HOURLY, BIWEEKLY_SALARY, MONTHLY_SALARY).
  payGroup            String
  // BIWEEKLY | MONTHLY | SEMI_MONTHLY | WEEKLY
  payFrequency        String
  directDepositActive Boolean   @default(false)
  activatedAt         DateTime?
  suspendedAt         DateTime?
  suspensionReason    String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  benefits   PayrollBenefit[]
  deductions PayrollDeduction[]

  @@index([clubId])
}

// Benefit line-items attached to a payroll profile. Structure only —
// calculation / posting engines live downstream.
model PayrollBenefit {
  id                String         @id @default(cuid())
  clubId            String
  club              Club           @relation(fields: [clubId], references: [id])
  payrollProfileId  String
  payrollProfile    PayrollProfile @relation(fields: [payrollProfileId], references: [id], onDelete: Cascade)
  // e.g. HEALTH | DENTAL | RRSP_EMPLOYER | LTD | STD
  benefitCode       String
  displayName       String
  // FLAT_AMOUNT | PERCENT_OF_GROSS | TIERED (payload is
  // resolved by the payroll calculation engine downstream).
  computationKind   String
  amount            Decimal        @default(0)
  currency          String?
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  employerFundedPct Decimal?
  employeeFundedPct Decimal?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([clubId])
  @@index([payrollProfileId, effectiveFrom])
}

// Deduction line-items attached to a payroll profile. Structure only.
model PayrollDeduction {
  id               String         @id @default(cuid())
  clubId           String
  club             Club           @relation(fields: [clubId], references: [id])
  payrollProfileId String
  payrollProfile   PayrollProfile @relation(fields: [payrollProfileId], references: [id], onDelete: Cascade)
  // e.g. UNION_DUES | GARNISHMENT | PARKING | ADVANCE_REPAYMENT
  deductionCode    String
  displayName      String
  // FLAT_AMOUNT | PERCENT_OF_GROSS | REMAINDER_OF_NET
  computationKind  String
  amount           Decimal        @default(0)
  currency         String?
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  preTax           Boolean        @default(false)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([clubId])
  @@index([payrollProfileId, effectiveFrom])
}

// EmployeeSensitiveIdentity — holds encrypted SIN / SSN. Separate
// table so plaintext access can be walled off with its own
// permission (`hr:sin:reveal`) and audit stream.
//
// Reveal-of-plaintext goes through `assertSensitiveActionAllowed()`
// in the service layer — NOT `assertPostingAllowed()`. Every
// reveal writes an audit record with action `hr.sin.reveal` and
// entityType `EmployeeSensitiveIdentity`.
//
// The masked helper (last three digits) is safe to render in
// list / detail UIs guarded by `hr:sin:read`.
model EmployeeSensitiveIdentity {
  id             String    @id @default(cuid())
  clubId         String
  club           Club      @relation(fields: [clubId], references: [id])
  employeeId     String    @unique
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // KMS envelope-encryption blob (scope="HR").
  sinSecretRef   String
  // Masked helper — safe to render.
  sinLastThree   String?
  // HR mobile-hotfix (2026-08-30) — HMAC-SHA256 keyed fingerprint of
  // the normalised SIN. Used ONLY for deterministic equality lookup
  // to enforce (clubId, sinFingerprint) uniqueness. Never returned
  // to the browser, never logged in cleartext audit fields. See
  // src/lib/kms/keyed-fingerprint.ts for the key-management model.
  sinFingerprint String?
  // Optional country-of-issue hint (CA | US | ...).
  issuingCountry String?
  effectiveFrom  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([clubId, sinFingerprint])
  @@index([clubId])
}

// EmployeeBankAccount — encrypted direct-deposit banking. All three
// numeric fields (institution / transit / account) are KMS-wrapped
// under scope="HR". Only `accountLastFour` and `holderName` are
// safe to render without a reveal grant.
//
// status: PENDING_PENNY_TEST | VERIFIED | REJECTED | INACTIVE
// activation requires `hr:banking:approve` in the service layer.
model EmployeeBankAccount {
  id                   String    @id @default(cuid())
  clubId               String
  club                 Club      @relation(fields: [clubId], references: [id])
  employeeId           String
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  institutionSecretRef String
  transitSecretRef     String
  accountSecretRef     String
  accountLastFour      String?
  holderName           String
  // HR mobile-hotfix (2026-08-30) — HMAC-SHA256 keyed fingerprint of
  // the normalised (institution, transit, account) triple. Used to
  // detect two DIFFERENT employees pointing at the same payroll
  // destination. Historical rows for the SAME employee may share a
  // fingerprint; the partial uniqueness constraint applies to the
  // currently-active (non-terminal) row across employees within a
  // Club. See src/lib/kms/keyed-fingerprint.ts.
  bankFingerprint      String?
  status               String    @default("PENDING_PENNY_TEST")
  activatedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([clubId])
  @@index([employeeId, status])
  @@index([clubId, bankFingerprint, status])
}

// EmployeeTaxProfile — CRA / provincial withholding elections.
// TD1 claim amounts + additional-deduction requests are
// KMS-wrapped under scope="HR". Non-sensitive metadata (province,
// TD1 form version, effectiveFrom) is stored in plaintext for
// filtering / reporting.
model EmployeeTaxProfile {
  id                           String    @id @default(cuid())
  clubId                       String
  club                         Club      @relation(fields: [clubId], references: [id])
  employeeId                   String
  employee                     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Non-sensitive metadata.
  province                     String
  td1FormVersion               String
  effectiveFrom                DateTime
  effectiveTo                  DateTime?
  // KMS envelope-encryption blobs (scope="HR").
  federalClaimSecretRef        String
  provincialClaimSecretRef     String
  additionalDeductionSecretRef String?
  notes                        String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@index([clubId])
  @@index([employeeId, effectiveFrom])
}

// EmployeeDocument — canonical employee document store. Categories
// are validated in the service layer against the
// EMPLOYEE_DOCUMENT_CATEGORIES const (src/lib/hr/documents.ts, in
// the next-wave slice). RESTRICTED sensitivity documents (e.g.
// signed T4, disciplinary records) additionally require
// `hr:sensitive:read`.
//
// The Employee model back-references two specific documents
// (profilePhotoDocumentId, resumeDocumentId) via distinct named
// relations — those pointers are convenience shortcuts; the
// underlying rows remain the authoritative source.
model EmployeeDocument {
  id               String   @id @default(cuid())
  clubId           String
  club             Club     @relation(fields: [clubId], references: [id])
  employeeId       String
  employee         Employee @relation("EmployeeDocuments", fields: [employeeId], references: [id], onDelete: Cascade)
  storageKey       String
  contentSha256    String
  sizeBytes        Int
  mimeType         String
  // Validated against EMPLOYEE_DOCUMENT_CATEGORIES in the service.
  category         String
  // STANDARD | RESTRICTED (RESTRICTED requires hr:sensitive:read).
  sensitivity      String   @default("STANDARD")
  displayName      String?
  uploadedByUserId String?
  uploadedBy       User?    @relation("EmployeeDocUploadedBy", fields: [uploadedByUserId], references: [id])
  uploadedAt       DateTime @default(now())

  // Inverse relations for the two convenience pointers on Employee.
  profilePhotoOf Employee[] @relation("EmployeeProfilePhoto")
  resumeOf       Employee[] @relation("EmployeeResume")

  @@index([clubId])
  @@index([employeeId, category])
  @@index([contentSha256])
}

// EmployeeCredential — professional certifications, licenses.
// Optional documentId ties a credential to its scanned proof.
model EmployeeCredential {
  id             String    @id @default(cuid())
  clubId         String
  club           Club      @relation(fields: [clubId], references: [id])
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // e.g. FOOD_HANDLERS | SMART_SERVE | RED_SEAL | PGA_MEMBER
  credentialCode String
  displayName    String
  issuer         String?
  reference      String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  documentId     String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([clubId])
  @@index([employeeId, expiresAt])
}

// EmployeeEmergencyContact — plaintext acceptable in this
// jurisdiction (Canada) because emergency-contact phone / address
// is not classified as a KMS-tier secret; it is still guarded by
// `hr:emergency:read` / `hr:emergency:write`.
model EmployeeEmergencyContact {
  id           String   @id @default(cuid())
  clubId       String
  club         Club     @relation(fields: [clubId], references: [id])
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String
  relation     String
  phone        String
  email        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  province     String?
  postalCode   String?
  country      String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clubId])
  @@index([employeeId])
}

// HR-2B.4 (2026-08-19) — Club-configurable onboarding requirement.
// See prisma-postgres/schema.prisma for the full architectural note.
model OnboardingRequirement {
  id                   String   @id @default(cuid())
  clubId               String
  club                 Club     @relation(fields: [clubId], references: [id])
  code                 String
  displayName          String
  explanation          String?
  kind                 String
  documentCategory     String?
  appliesToAll         Boolean  @default(false)
  appliesToDeptIds     String?
  appliesToPositionIds String?
  required             Boolean  @default(true)
  requireExpiry        Boolean  @default(false)
  active               Boolean  @default(true)
  displayOrder         Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdByUserId      String?

  @@unique([clubId, code])
  @@index([clubId, active])
}

// EmployeeOnboardingInvitation — one-shot magic-link tokens issued
// to an employee for self-onboarding. Token PLAINTEXT is never
// stored; only SHA-256 hash is persisted (@unique). Revocation and
// redemption are recorded so the same token cannot be replayed.
model EmployeeOnboardingInvitation {
  id               String    @id @default(cuid())
  clubId           String
  club             Club      @relation(fields: [clubId], references: [id])
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  redeemedAt       DateTime?
  // SHA-256 hash of the redemption IP — never store raw IPs.
  redeemedByIpHash String?
  issuedByUserId   String
  issuedBy         User      @relation("InvitationIssuedBy", fields: [issuedByUserId], references: [id])
  createdAt        DateTime  @default(now())

  // HR-2B.3 tail (2026-08-20) — delivery attempt tracking. See
  // prisma-postgres/schema.prisma for full column semantics.
  deliveryStatus            String?
  deliveryProvider          String?
  deliveryProviderMessageId String?
  deliveryAttemptedAt       DateTime?
  deliveryFailureReason     String?

  @@index([clubId])
  @@index([employeeId])
  @@index([expiresAt])
}

// EmployeeOnboardingSession — an in-flight onboarding attempt.
// state: DRAFT | IN_PROGRESS | SUBMITTED | APPROVED | REJECTED |
//        REVOKED
model EmployeeOnboardingSession {
  id                String    @id @default(cuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id])
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  initiatedByUserId String
  initiatedBy       User      @relation("OnboardingInitiatedBy", fields: [initiatedByUserId], references: [id])
  approvedByUserId  String?
  approvedBy        User?     @relation("OnboardingApprovedBy", fields: [approvedByUserId], references: [id])
  state             String    @default("DRAFT")
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?

  responses        EmployeeOnboardingResponse[]
  corrections      EmployeeOnboardingCorrection[]
  acknowledgements EmployeeOnboardingAcknowledgement[]

  @@index([clubId])
  @@index([employeeId, state])
}

// EmployeeOnboardingStateTransition — append-only log of every
// state change for governance / dispute resolution. actorSource
// is one of EMPLOYEE | STAFF | SYSTEM. When actorSource=EMPLOYEE
// only `actorEmployeeId` is populated; when STAFF only
// `actorUserId`; when SYSTEM both are null.
model EmployeeOnboardingStateTransition {
  id              String   @id @default(cuid())
  clubId          String
  club            Club     @relation(fields: [clubId], references: [id])
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sessionId       String?
  fromState       String
  toState         String
  actorSource     String
  actorUserId     String?
  actor           User?    @relation("OnboardingTransitionActor", fields: [actorUserId], references: [id])
  actorEmployeeId String?
  reason          String?
  at              DateTime @default(now())

  @@index([clubId])
  @@index([employeeId, at])
}

// EmployeeOnboardingQuestion — the question catalogue.
//
// clubId semantics:
//   - clubId=null : global default question available to every club.
//                   INSERTS require `system:super_admin` at the
//                   service layer.
//   - clubId=<id> : club-specific question / override. When a
//                   club-specific row matches a global-default row
//                   by `key`, the club-specific version wins.
//
// READS must always go through the canonical helper
// `resolveEffectiveQuestions(clubId)` in
// src/lib/hr/onboarding-questions.ts (next-wave slice). Direct
// `prisma.employeeOnboardingQuestion.findMany` outside that helper
// is banned by the source-contract test
// tests/hr/onboarding-question-canonical-reader.test.ts.
model EmployeeOnboardingQuestion {
  id           String   @id @default(cuid())
  clubId       String?
  club         Club?    @relation(fields: [clubId], references: [id])
  // Stable machine key (e.g. `contact.mobile_phone`). Unique per
  // scope (clubId + key). A club-specific override reuses the
  // global key.
  key          String
  section      String
  prompt       String
  helpText     String?
  // TEXT | LONG_TEXT | EMAIL | PHONE | DATE | NUMBER | BOOLEAN |
  // SINGLE_CHOICE | MULTI_CHOICE | FILE_UPLOAD | SIGNATURE
  answerKind   String
  required     Boolean  @default(false)
  optionsJson  String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  responses EmployeeOnboardingResponse[]

  @@unique([clubId, key])
  @@index([clubId, section, displayOrder])
}

// EmployeeOnboardingResponse — one row per (session, question).
// `status` DEFAULT = "PENDING". Never "COMPLETE" on insert. Only
// the approver-flip service action may promote to "COMPLETE".
model EmployeeOnboardingResponse {
  id           String                     @id @default(cuid())
  clubId       String
  club         Club                       @relation(fields: [clubId], references: [id])
  sessionId    String
  session      EmployeeOnboardingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId   String
  question     EmployeeOnboardingQuestion @relation(fields: [questionId], references: [id])
  // PENDING | ANSWERED | COMPLETE | REJECTED
  status       String                     @default("PENDING")
  // Shape governed by the question's answerKind. Freeform JSON.
  responseJson String?
  answeredAt   DateTime?
  reviewedAt   DateTime?
  reviewerNote String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@unique([sessionId, questionId])
  @@index([clubId])
  @@index([sessionId])
}

// EmployeeOnboardingAcknowledgement — HR-2B.2 final (2026-08-19).
// See prisma-postgres/schema.prisma for full documentation.
model EmployeeOnboardingAcknowledgement {
  id              String                    @id @default(cuid())
  clubId          String
  club            Club                      @relation(fields: [clubId], references: [id])
  sessionId       String
  session         EmployeeOnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind            String
  actorEmployeeId String?
  acknowledgedAt  DateTime                  @default(now())

  @@unique([sessionId, kind])
  @@index([clubId, sessionId])
  @@index([clubId, employeeId])
}

// EmployeeOnboardingCorrection — HR-2B.2 (2026-08-18).
// See prisma-postgres/schema.prisma for full documentation.
model EmployeeOnboardingCorrection {
  id                  String                    @id @default(cuid())
  clubId              String
  club                Club                      @relation(fields: [clubId], references: [id])
  sessionId           String
  session             EmployeeOnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  field               String
  employeeStatedValue String
  note                String?
  resolvedAt          DateTime?
  resolvedByUserId    String?
  createdAt           DateTime                  @default(now())

  @@index([clubId, sessionId])
  @@index([clubId, employeeId])
}

// EmployeePortalCredential — HR-2B.5 (2026-08-19).
// See prisma-postgres/schema.prisma for full documentation.
model EmployeePortalCredential {
  id                 String    @id @default(cuid())
  clubId             String
  club               Club      @relation(fields: [clubId], references: [id])
  employeeId         String    @unique
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  passwordHash       String
  passwordUpdatedAt  DateTime  @default(now())
  lastLoginAt        DateTime?
  failedAttemptCount Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([clubId])
}

// EmployeePortalPasswordReset — HR-2B.5 (2026-08-19).
// See prisma-postgres/schema.prisma for full documentation.
model EmployeePortalPasswordReset {
  id         String    @id @default(cuid())
  clubId     String
  club       Club      @relation(fields: [clubId], references: [id])
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([clubId, employeeId])
}

// ClubMedia — HR-2C (2026-08-20).
// Canonical per-Club media store for tenant-owned assets like the
// Employee Portal hero photograph. One row per (clubId, category)
// — replacing the row rotates the asset. Bytes live in the canonical
// document-storage adapter (`resolveDocumentStorage({clubId})`) under
// key `clubs/{clubId}/media/{sha256}` and are streamed back through
// a same-origin proxy route (never a signed URL) so tenant isolation
// stays end-to-end.
//
// Categories (validated in-service, not enum-constrained here):
//   employee_portal_hero  — the Club-configurable photographic
//                            header rendered on Employee Portal Home.
//
// Additive-only model — no back-fill required. Absence of a row is
// treated as "no asset set" and the surface renders its own branded
// fallback.
model ClubMedia {
  id               String   @id @default(cuid())
  clubId           String
  club             Club     @relation(fields: [clubId], references: [id])
  category         String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  sha256           String
  displayName      String?
  uploadedByUserId String?
  uploadedAt       DateTime @default(now())

  // HR portal hero framing (2026-08-26) — normalized focal point +
  // zoom persisted per asset so tenant admins can position the hero
  // photograph without a code change. Null = fall back to the
  // Spectre default centered `object-position: 50% 50%` + zoom 1.0,
  // which preserves current visual behavior for every existing row.
  // Desktop and mobile are independent because the two surfaces
  // have different aspect ratios.
  desktopFocalX    Float?
  desktopFocalY    Float?
  desktopZoom      Float?
  mobileFocalX     Float?
  mobileFocalY     Float?
  mobileZoom       Float?
  framingUpdatedAt DateTime?
  framingUpdatedBy String?

  @@unique([clubId, category])
  @@index([clubId])
}

// ============================================================
// Employee Portal Quick Links (2026-08-27)
// ============================================================
//
// Tenant-configured Quick Links rendered in the Employee Portal
// right rail (desktop) and the mobile Quick Links strip. Each row
// points either to an external/relative URL OR to an uploaded
// document (PDF). Both destination fields nullable — service
// enforces "exactly one is set". `storageKey` lives under the
// canonical Spectre document storage prefix.
model EmployeePortalQuickLink {
  id                String   @id @default(cuid())
  clubId            String
  club              Club     @relation(fields: [clubId], references: [id])
  label             String
  destinationType   String   // "url" | "file"
  url               String?
  storageKey        String?
  fileMimeType      String?
  fileSizeBytes     Int?
  fileOriginalName  String?
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdByUserId   String?
  updatedByUserId   String?

  @@index([clubId, sortOrder])
  @@index([clubId, isActive])
}

// ============================================================
// HR-2C — Anonymous Employee Feedback (2026-08-27)
// ============================================================
//
// Employee-submitted feedback where the submitter is intentionally
// NOT persisted at the application level. The Club must still know
// which tenant the feedback belongs to, so `clubId` is derived
// server-side from the authenticated employee session — but no
// employeeId / userId / name / email / employee-number field
// exists on the row itself.
//
// Never add an author field to this model. Never add a column that
// could be joined to an employee row. Doing so violates the
// founder-mandated anonymity contract enforced end-to-end.
//
// Discipline mirrors ClubAnnouncement: every write goes through
// `src/lib/anonymous-feedback.ts`; audit rows are recorded WITHOUT
// author metadata.
model AnonymousFeedback {
  id         String   @id @default(cuid())
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id])
  // Optional soft category. Free-form string; the UI shows a
  // closed dropdown but the service accepts any string ≤ 40 chars
  // so a future admin categorisation flow can grow the list
  // without a schema change. Empty string / null = uncategorised.
  category   String?
  message    String
  // Lightweight review lifecycle: NEW → REVIEWED → ARCHIVED.
  // Admin-only; not exposed to employees.
  status     String   @default("NEW")
  createdAt  DateTime @default(now())
  reviewedAt DateTime?

  @@index([clubId, createdAt])
  @@index([clubId, status])
}

// ============================================================
// HR-2C — Safety & Training compliance (2026-08-20)
// ============================================================
//
// Nine models. Every write goes through canonical services in
// `src/lib/hr/training/**` — no direct Prisma writes from routes.
//
// Ownership: `clubId` on every table + tenantWhere / assertTenantOwned
// discipline. Applicability filters (Department / Position / explicit
// assignment) live on the version row so republishing a course can
// change who it applies to without mutating history.
//
// Versioning: TrainingCourse is the catalogue entry; every material
// change is a NEW TrainingCourseVersion row. A completion always
// carries `courseVersionId` so historical proof survives republishes.

// Top-level catalogue entry. `currentVersionId` points at the latest
// PUBLISHED version (nullable while the course only has DRAFT versions).
model TrainingCourse {
  id               String    @id @default(cuid())
  clubId           String
  club             Club      @relation(fields: [clubId], references: [id])
  code             String
  title            String
  category         String
  description      String?
  retiredAt        DateTime?
  createdByUserId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  currentVersionId String?
  versions         TrainingCourseVersion[]

  assignments      TrainingAssignment[]
  completions      TrainingCompletion[]

  @@unique([clubId, code])
  @@index([clubId])
  @@index([clubId, category])
}

// Immutable content snapshot. Every material edit publishes a new
// version rather than rewriting an existing one, so previously
// certified employees remain certified against the exact content
// they were tested on.
model TrainingCourseVersion {
  id                    String    @id @default(cuid())
  courseId              String
  course                TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  version               Int
  state                 String    @default("DRAFT")
  title                 String
  description           String?
  passingScore          Int       @default(80)
  retakesAllowed        Boolean   @default(true)
  requiresKnowledgeTest Boolean   @default(true)
  videoStorageKey       String?
  videoMimeType         String?
  videoSizeBytes        Int?
  videoSha256           String?
  videoDurationSec      Int?
  appliesToAll          Boolean   @default(false)
  appliesToDeptIds      String?
  appliesToPositionIds  String?
  required              Boolean   @default(true)
  publishedAt           DateTime?
  publishedByUserId     String?
  retiredAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  questions             TrainingQuestion[]
  progress              TrainingProgress[]
  attempts              TrainingAttempt[]
  completions           TrainingCompletion[]

  @@unique([courseId, version])
  @@index([state])
  @@index([courseId, state])
}

// Per-version multiple-choice question. Ordered by displayOrder;
// active flag lets an author remove a question from a DRAFT before
// publishing (published versions never mutate their question set).
model TrainingQuestion {
  id              String                 @id @default(cuid())
  courseVersionId String
  courseVersion   TrainingCourseVersion  @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  prompt          String
  displayOrder    Int                    @default(0)
  active          Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  options         TrainingAnswerOption[]
  responses       TrainingQuestionResponse[]

  @@index([courseVersionId, displayOrder])
}

// Per-question answer choice. Exactly ONE row per question must have
// `isCorrect = true` at publish time — enforced in the service layer
// via publish validation. `isCorrect` is NEVER included in the
// employee-facing course payload.
model TrainingAnswerOption {
  id              String            @id @default(cuid())
  questionId      String
  question        TrainingQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text            String
  isCorrect       Boolean           @default(false)
  displayOrder    Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  responses       TrainingQuestionResponse[]

  @@index([questionId, displayOrder])
}

// Explicit per-employee assignment layered on top of the version
// dept/position applicability. Presence of an assignment makes the
// course applicable regardless of dept/position match.
model TrainingAssignment {
  id                String   @id @default(cuid())
  clubId            String
  club              Club     @relation(fields: [clubId], references: [id])
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseId          String
  course            TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignedByUserId  String?
  assignedAt        DateTime @default(now())
  note              String?

  @@unique([clubId, employeeId, courseId])
  @@index([clubId, employeeId])
  @@index([clubId, courseId])
}

// Resumable video-progress record — one row per (employee, version).
// Persists `secondsWatched` (monotonic — advances only) and the
// derived `percentComplete`.
model TrainingProgress {
  id              String                @id @default(cuid())
  clubId          String
  club            Club                  @relation(fields: [clubId], references: [id])
  employeeId      String
  employee        Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseVersionId String
  courseVersion   TrainingCourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  secondsWatched  Int                   @default(0)
  farthestSecond  Int                   @default(0)
  percentComplete Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([employeeId, courseVersionId])
  @@index([clubId, employeeId])
}

// One row per quiz attempt (submission). Never overwritten — failed
// attempts remain historical and a retake produces a new row.
model TrainingAttempt {
  id              String                     @id @default(cuid())
  clubId          String
  club            Club                       @relation(fields: [clubId], references: [id])
  employeeId      String
  employee        Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseVersionId String
  courseVersion   TrainingCourseVersion      @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  attemptNumber   Int
  score           Int                        @default(0)
  passed          Boolean                    @default(false)
  startedAt       DateTime                   @default(now())
  submittedAt     DateTime?

  responses       TrainingQuestionResponse[]
  completion      TrainingCompletion?

  @@unique([employeeId, courseVersionId, attemptNumber])
  @@index([clubId, employeeId])
  @@index([courseVersionId, passed])
}

// Per-attempt per-question response. Server grades correctness by
// joining against the canonical `TrainingAnswerOption.isCorrect`.
// Browser only submits selectedOptionId.
model TrainingQuestionResponse {
  id                String                @id @default(cuid())
  attemptId         String
  attempt           TrainingAttempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          TrainingQuestion      @relation(fields: [questionId], references: [id])
  selectedOptionId  String
  selectedOption    TrainingAnswerOption  @relation(fields: [selectedOptionId], references: [id])
  wasCorrect        Boolean               @default(false)
  createdAt         DateTime              @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// Canonical proof of pass. Created by the server when an attempt
// grades pass. Immutable historical evidence.
model TrainingCompletion {
  id              String                @id @default(cuid())
  clubId          String
  club            Club                  @relation(fields: [clubId], references: [id])
  employeeId      String
  employee        Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseId        String
  course          TrainingCourse        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseVersionId String
  courseVersion   TrainingCourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  attemptId       String                @unique
  attempt         TrainingAttempt       @relation(fields: [attemptId], references: [id])
  score           Int
  completedAt     DateTime              @default(now())

  @@unique([employeeId, courseVersionId])
  @@index([clubId, employeeId])
  @@index([clubId, courseId])
  @@index([employeeId, courseId])
}

// ===========================================================================
// Payroll-3A (2026-08-28) — Canonical payroll foundation.
//
// STRUCTURAL ONLY. No gross-to-net calculation logic lives at this layer.
// No CRA tables, no CPP/EI, no vacation-pay math. Payroll-3A establishes:
//   * Club-level payroll configuration.
//   * PayGroup + pay-period lifecycle.
//   * PayrollBatch (canonical processing cycle) + lifecycle transitions.
//   * Per-employee inclusion rows with role context preserved.
//   * Typed earning/deduction/allowance input categories.
//   * Approved-time-entry seam for future timekeeping integration.
//
// Naming note (surfaced in the checkpoint): the founder brief named the
// canonical run PayrollRun. The Phase-5 Ops PayrollRun model already
// exists (legacy 22 percent withholding stub). To keep 3A.1 additive
// per section 38, canonical Payroll-3A uses the industry-standard
// name PayrollBatch for the processing cycle. A follow-up cleanup
// slice may rename the legacy Ops model to LegacyOpsPayrollRun and
// rename PayrollBatch to PayrollRun per the founder's original
// naming preference.
//
// Every model is:
//   * tenant-scoped by clubId;
//   * additive to prior HR migrations (does not modify accepted rows);
//   * effective-dated using the repo's half-open [from, to) convention
//     where lifecycle timelines apply;
//   * indexed on the (clubId, primary-lookup-key) pattern used
//     throughout HR-2C.
// ===========================================================================

// One-row-per-Club payroll configuration. Country + provinceOfEmployment
// establish the jurisdiction seam later calculation phases will consume;
// they are NOT calculation policy themselves. Province of employment
// derives from the Club/payroll establishment (section 3), never from
// employee home address.
model PayrollClubConfig {
  id                     String   @id @default(cuid())
  clubId                 String   @unique
  club                   Club     @relation(fields: [clubId], references: [id])
  enabled                Boolean  @default(false)
  country                String   @default("CA") // ISO 3166-1 alpha-2
  provinceOfEmployment   String?  // 2-char CA province (AB / BC / ON / etc.)
  defaultPayFrequency    String   @default("BIWEEKLY") // WEEKLY | BIWEEKLY | SEMI_MONTHLY | MONTHLY
  defaultPaymentMethod   String   @default("DIRECT_DEPOSIT") // DIRECT_DEPOSIT | CHEQUE | OTHER
  payrollAdminUserId     String?  // designated primary Payroll admin (optional)
  controllerUserId       String?  // designated Controller for approval routing (optional)
  glAccountingProfileId  String?  // future GL integration seam (not resolved in 3A)
  paystubNumberPrefix    String?  // optional prefix for future paystub numbering
  paystubNumberSequence  Int      @default(0) // reserved for future paystub numbering
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([clubId])
}

// A pay group is the scheduling + membership boundary for payroll
// processing. Multiple pay groups per Club are supported (e.g. Hourly-
// Biweekly + Salaried-Semi-Monthly).
model PayrollPayGroup {
  id            String   @id @default(cuid())
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id])
  code          String   // stable slug (e.g. HOURLY_BW)
  name          String   // human-readable (e.g. "Hourly Employees - Biweekly")
  payFrequency  String   // WEEKLY | BIWEEKLY | SEMI_MONTHLY | MONTHLY
  active        Boolean  @default(true)
  // Payment-timing metadata (days after period end that pay is issued).
  // Payroll-3B-2 canonical semantics: payDate = periodEnd + payDateOffsetDays
  // measured in CALENDAR DAYS. Not business days. Banking-holiday shifting
  // will arrive in a later Payroll slice; this offset is intentionally
  // calendar-day-only for the MVP.
  payDateOffsetDays Int  @default(5)
  // Payroll-3B-2 (2026-08-28) — canonical calendar anchor. A known
  // period-start date that establishes the recurring WEEKLY or
  // BIWEEKLY payroll cadence both backward and forward. Nullable so
  // pre-3B-2 Pay Groups migrate cleanly; generation refuses when the
  // frequency requires an anchor and none is set. SEMI_MONTHLY and
  // MONTHLY are anchor-agnostic (calendar-rule driven).
  calendarAnchorDate DateTime?
  notes         String?
  createdByUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       PayrollPayGroupMember[]
  periods       PayrollPayPeriod[]
  batches       PayrollBatch[]

  @@unique([clubId, code])
  @@index([clubId, active])
}

// Effective-dated employee membership in a pay group (section 7).
// Employees may move between pay groups without rewriting history.
// Half-open [effectiveFrom, effectiveTo).
model PayrollPayGroupMember {
  id            String   @id @default(cuid())
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id])
  payGroupId    String
  payGroup      PayrollPayGroup @relation(fields: [payGroupId], references: [id])
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime?
  notes         String?
  createdByUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clubId, payGroupId, effectiveFrom])
  @@index([clubId, employeeId, effectiveFrom])
}

// A pay period is a canonical time window belonging to a pay group.
// Uses half-open [periodStart, periodEnd) semantics - work performed
// on periodEnd falls in the NEXT period. status doc-string:
// FUTURE | OPEN | CLOSED (advisory; PayrollBatch owns the run
// lifecycle).
model PayrollPayPeriod {
  id            String   @id @default(cuid())
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id])
  payGroupId    String
  payGroup      PayrollPayGroup @relation(fields: [payGroupId], references: [id])
  sequenceInYear Int     // 1-based ordinal within the tax year
  taxYear       Int
  periodStart   DateTime // half-open interval start (inclusive)
  periodEnd     DateTime // half-open interval end (EXCLUSIVE)
  payDate       DateTime // scheduled pay date
  status        String   @default("FUTURE") // FUTURE | OPEN | CLOSED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batches       PayrollBatch[]
  departmentTimeApprovals PayrollDepartmentTimeApproval[]

  @@unique([clubId, payGroupId, taxYear, sequenceInYear])
  @@unique([clubId, payGroupId, periodStart])
  @@index([clubId, payGroupId, periodStart])
}

// PayrollBatch - the canonical "payroll run" processing cycle. Named
// Batch to avoid collision with the legacy Ops PayrollRun (see naming
// note above). Lifecycle transitions are audited.
model PayrollBatch {
  id            String   @id @default(cuid())
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id])
  payGroupId    String
  payGroup      PayrollPayGroup @relation(fields: [payGroupId], references: [id])
  payPeriodId   String
  payPeriod     PayrollPayPeriod @relation(fields: [payPeriodId], references: [id])
  // DRAFT | PREPARED | SUBMITTED_FOR_APPROVAL | APPROVED | POSTED | VOIDED
  status        String   @default("DRAFT")
  // Sequence within (payGroup, taxYear) - one authoritative batch per
  // period unless a future revision/versioning slice adds sequencing.
  sequence      Int      @default(1)
  preparedAt    DateTime?
  preparedByUserId String?
  submittedAt   DateTime?
  submittedByUserId String?
  approvedAt    DateTime?
  approvedByUserId String?
  postedAt      DateTime?
  postedByUserId String?
  voidedAt      DateTime?
  voidedByUserId String?
  voidReason    String?
  // Work Intake handoff (sections 29-30). Set at submit; single item
  // routed to the Controller's inbox with workDomain = "PAYROLL".
  workIntakeItemId String? @unique
  notes         String?
  createdByUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employees             PayrollBatchEmployee[]
  earnings              PayrollBatchEarning[]
  deductions            PayrollBatchDeduction[]
  allowanceSnapshots    PayrollBatchAllowanceSnapshot[]

  @@unique([clubId, payGroupId, payPeriodId, sequence])
  @@index([clubId, status])
  @@index([clubId, payPeriodId])
}

// Per-employee inclusion row in a specific batch (section 12).
// Snapshots the minimum HR context needed for audit / historical
// reproducibility. Sensitive HR details (SIN, banking) are NOT copied
// here - the batch resolves them via the canonical HR readers at
// preparation time; only readiness indicators are stored.
model PayrollBatchEmployee {
  id                String   @id @default(cuid())
  clubId            String
  club              Club     @relation(fields: [clubId], references: [id])
  batchId           String
  batch             PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id])
  payGroupMemberId  String?
  // Snapshot metadata for historical reproducibility.
  jurisdictionCountry     String // "CA"
  jurisdictionProvince    String? // 2-char province
  employeeLifecycleAtPrep String // PRE_HIRE | ACTIVE | LEAVE | TERMINATED | ARCHIVED
  // Readiness indicators (sections 23-24). No plaintext SIN / banking.
  bankingReady            Boolean @default(false)
  bankingStatus           String? // VERIFIED | PENDING_PENNY_TEST | REJECTED | INACTIVE | null
  sinReady                Boolean @default(false)
  federalTd1Ready         Boolean @default(false)
  provincialTd1Ready      Boolean @default(false)
  compensationReady       Boolean @default(false)
  // PENDING | INCLUDED | EXCLUDED | ERRORED. Structural only.
  status                  String  @default("PENDING")
  // Deferred fields reserved for the calculation phase - kept NULL
  // in 3A. Presence here is a seam declaration, not a computation
  // contract.
  grossPay                Decimal?
  netPay                  Decimal?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  earnings           PayrollBatchEarning[]
  deductions         PayrollBatchDeduction[]
  allowanceSnapshots PayrollBatchAllowanceSnapshot[]

  @@unique([batchId, employeeId])
  @@index([clubId, batchId])
  @@index([clubId, employeeId])
}

// Typed earning input line (sections 14-16). Each earning MUST
// reference the employment assignment it belongs to so role-specific
// compensation resolves correctly for multi-role employees. Rate is
// captured for historical reproducibility; calculation is a later
// phase.
model PayrollBatchEarning {
  id                     String   @id @default(cuid())
  clubId                 String
  club                   Club     @relation(fields: [clubId], references: [id])
  batchId                String
  batch                  PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchEmployeeId        String
  batchEmployee          PayrollBatchEmployee @relation(fields: [batchEmployeeId], references: [id], onDelete: Cascade)
  employeeId             String
  employee               Employee @relation(fields: [employeeId], references: [id])
  employmentAssignmentId String?  // NULL for salary-only or non-role earnings
  employmentAssignment   EmployeeEmploymentAssignment? @relation(fields: [employmentAssignmentId], references: [id])
  // REGULAR | OVERTIME | SALARY | BONUS | VACATION | STAT_HOLIDAY | COMMISSION | OTHER
  earningType            String
  // Free-form label for admin display (e.g. "Q3 sales bonus").
  description            String?
  // Quantity: hours for hourly earnings, count for units/pieces.
  quantity               Decimal  @default(0)
  // Rate captured at preparation time - historically reproducible.
  rate                   Decimal  @default(0)
  currency               String   @default("CAD")
  // Source metadata for audit:
  //   MANUAL | TIME_ENTRY | ALLOWANCE_SNAPSHOT | SALARY_PROJECTION | IMPORT
  rateSource             String   @default("MANUAL")
  // Optional link to the approved time entry that produced this line.
  approvedTimeEntryId    String?
  approvedTimeEntry      PayrollApprovedTimeEntry? @relation(fields: [approvedTimeEntryId], references: [id])
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([clubId, batchId])
  @@index([clubId, employeeId, earningType])
  @@index([batchEmployeeId, earningType])
}

// Typed deduction/adjustment input line (section 18). EXPLICITLY not
// for statutory deductions (CPP/EI/tax) - those are the later
// calculation phase's output. This models employer-side inputs like
// charge-account deductions, benefit contributions, garnishments,
// manual corrections.
model PayrollBatchDeduction {
  id                     String   @id @default(cuid())
  clubId                 String
  club                   Club     @relation(fields: [clubId], references: [id])
  batchId                String
  batch                  PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchEmployeeId        String
  batchEmployee          PayrollBatchEmployee @relation(fields: [batchEmployeeId], references: [id], onDelete: Cascade)
  employeeId             String
  employee               Employee @relation(fields: [employeeId], references: [id])
  // BENEFIT | CHARGE_ACCOUNT | GARNISHMENT | MANUAL | OTHER
  deductionType          String
  description            String?
  amount                 Decimal
  currency               String   @default("CAD")
  // MANUAL | RECURRING_TEMPLATE | IMPORT
  source                 String   @default("MANUAL")
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([clubId, batchId])
  @@index([clubId, employeeId, deductionType])
  @@index([batchEmployeeId, deductionType])
}

// Snapshot of a canonical EmployeeAllowance row applied to a batch
// (section 17). The source EmployeeAllowance remains authoritative;
// this row captures the effective values at prep time for
// reproducibility.
model PayrollBatchAllowanceSnapshot {
  id                     String   @id @default(cuid())
  clubId                 String
  club                   Club     @relation(fields: [clubId], references: [id])
  batchId                String
  batch                  PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchEmployeeId        String
  batchEmployee          PayrollBatchEmployee @relation(fields: [batchEmployeeId], references: [id], onDelete: Cascade)
  employeeId             String
  employee               Employee @relation(fields: [employeeId], references: [id])
  sourceAllowanceId      String
  sourceAllowance        EmployeeAllowance @relation(fields: [sourceAllowanceId], references: [id])
  allowanceType          String
  description            String?
  amount                 Decimal
  currency               String   @default("CAD")
  // PER_PAY_PERIOD | MONTHLY | ANNUAL - preserved from the source row.
  frequency              String
  taxable                Boolean
  // Effective window of the SOURCE allowance at snapshot time.
  sourceEffectiveFrom    DateTime
  sourceEffectiveTo      DateTime?
  createdAt              DateTime @default(now())

  @@unique([batchEmployeeId, sourceAllowanceId])
  @@index([clubId, batchId])
}

// Approved-time-entry seam (sections 19-20). This is the canonical
// interface future timekeeping data (Clock In/Out, manager-approved
// timecards) must satisfy before payroll consumes it. Payroll-3A
// does NOT fabricate rows; the model is written by the future
// timekeeping approval flow and read by run preparation.
// Payroll-3B-3 (2026-08-28) — canonical department-level approval
// record for a Pay Period. One row per (Club, PayPeriod, Department).
// Represents "Department X has approved its time for Pay Period Y";
// the underlying PayrollApprovedTimeEntry rows carry their own
// approval fields, but this row is the audit anchor + Work Intake
// linkage for the department-scoped approval workflow.
//
// Lifecycle: PENDING (implicit — no row) → APPROVED → REOPENED.
// If time changes after approval, the service transitions the row to
// REOPENED and reactivates the associated Work Intake card so the
// department head sees the correction is required.
model PayrollDepartmentTimeApproval {
  id                   String   @id @default(cuid())
  clubId               String
  club                 Club     @relation(fields: [clubId], references: [id])
  payPeriodId          String
  payPeriod            PayrollPayPeriod @relation(fields: [payPeriodId], references: [id])
  departmentId         String
  department           Department @relation("DepartmentPayrollTimeApprovals", fields: [departmentId], references: [id])
  // APPROVED | REOPENED — the row exists only after a manager first
  // approves the department for this period.
  state                String   @default("APPROVED")
  approvedAt           DateTime
  approvedByUserId     String
  reopenedAt           DateTime?
  reopenedByUserId     String?
  reopenReason         String?
  // Optional linkage to the source Work Intake card that resolved
  // into this approval. The Work Intake orchestrator writes this
  // pointer so audit + reopen can find and reactivate the same card.
  workIntakeItemId     String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([clubId, payPeriodId, departmentId])
  @@index([clubId, payPeriodId])
  @@index([clubId, departmentId])
  @@index([workIntakeItemId])
}

model PayrollApprovedTimeEntry {
  id                     String   @id @default(cuid())
  clubId                 String
  club                   Club     @relation(fields: [clubId], references: [id])
  employeeId             String
  employee               Employee @relation(fields: [employeeId], references: [id])
  employmentAssignmentId String?
  employmentAssignment   EmployeeEmploymentAssignment? @relation(fields: [employmentAssignmentId], references: [id])
  workDate               DateTime // UTC midnight aligning to the employee's local work day
  hours                  Decimal
  // REGULAR | OVERTIME | STAT_HOLIDAY | VACATION | OTHER - matches the
  // earning-type catalogue subset that time entries can produce.
  earningClassification  String   @default("REGULAR")
  // DRAFT | APPROVED | POSTED. Payroll consumes APPROVED only.
  approvalState          String   @default("DRAFT")
  approvedAt             DateTime?
  approvedByUserId       String?
  // Link once a batch consumes this entry - a single entry maps to
  // at most one earning line, guarding against double-counting.
  consumedByBatchId      String?
  consumedByBatchEmployeeId String?
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  batchEarnings PayrollBatchEarning[]

  @@index([clubId, employeeId, workDate])
  @@index([clubId, approvalState, workDate])
  @@index([employmentAssignmentId, workDate])
}
