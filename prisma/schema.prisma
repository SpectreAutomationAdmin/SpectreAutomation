//
// Founder §3-§5 rules:
//   §3 status durability: PENDING → PROCESSING → SUCCEEDED /
//      FAILED_RETRYABLE / FAILED_TERMINAL
//   §4 idempotency: unique (clubId, documentSha256, provider,
//      extractionVersion) — at most one paid extraction per identity
//   §5 controlled reprocessing: bumping extractionVersion creates
//      one new row per document; prior versions retained for audit
//
// The OCR worker is the ONLY code path allowed to invoke a paid
// provider. Every projection / analyser render reads persisted rows
// only. See src/lib/ap-intelligence/ocr/persistence.ts.
// ---------------------------------------------------------------------------
model DocumentOcrExtraction {
  id                       String           @id @default(cuid())
