// Spectre Automation – multi-tenant schema
// Local: SQLite. Production target: PostgreSQL (swap provider + DATABASE_URL).
//
// Tenancy rule: every club-scoped record carries clubId. Application code
// (see src/lib/tenant.ts) is the gatekeeper for tenant isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // To switch to PostgreSQL in production, change provider to "postgresql"
  // and update DATABASE_URL. Enum strings are already used as TEXT so the
  // schema is portable.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

