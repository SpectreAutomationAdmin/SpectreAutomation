// -------------------------------------------------------------------------
// 6B-bis. Monthly Reporting Package archive
// -------------------------------------------------------------------------
//
// Archive of generated / published / sent Monthly Reporting Packages.
// Distinct from the generic `ReportingPackage` model above — that one
// is the long-standing enterprise-reporting bundle (sections,
// commentaries, approvals, distributions). This one is dedicated to
// the founder's Monthly Reporting Package surface at
// /app/admin/reporting/monthly and the launcher's "View Archive"
// affordance, which lists everything a controller has previously
// generated for board / committee distribution.
//
// SNAPSHOT FIELDS (executiveOpeningSnapshotJson, atAGlanceKpisJson,
// packagePayloadJson) are frozen at publish/send time. The reporting
// service rebuilds the report from live ledger data every time the
// page renders the DRAFT version, so a draft's numbers track the
// ledger. Once a package is PUBLISHED or SENT to the board, the
// numbers it reported MUST NOT silently change if someone backdates
// a journal entry next month — the archive has to reflect what was
// communicated to directors at that point in time. The snapshot JSON
// holds the canonical numbers + KPI tones + chart series the
// recipients saw.
//
// status:
//   DRAFT     — generated, editable, regenerable, no snapshot yet
//   PUBLISHED — frozen for internal distribution; snapshot set
//   SENT      — emailed/distributed to recipients; recipient table
//                populated; snapshot set (carried forward from
//                PUBLISHED if previously published)
model MonthlyPackage {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id])

  // Period identification — the same triple the launcher passes via
  // `?period=YYYY-MM`. `periodEndDate` is the canonical date the
  // reporting service uses (last day of the month at 00:00 UTC) so
  // every consumer can derive the rest of the labels from it.
  reportingYear  Int
  reportingMonth Int // 1..12
  periodEndDate  DateTime

  // Lifecycle
  status String @default("DRAFT")
  title  String

  // Generation = the act of opening / building the package for this
  // period for the first time. Every MonthlyPackage row has these
  // populated.
  generatedAt       DateTime @default(now())
  generatedByUserId String?
  generatedBy       User?    @relation("MonthlyPackageGeneratedBy", fields: [generatedByUserId], references: [id])

  // Publishing = freezing the snapshot for internal use (e.g. the
  // finance committee reviews the published draft before send).
  publishedAt       DateTime?
  publishedByUserId String?
  publishedBy       User?     @relation("MonthlyPackagePublishedBy", fields: [publishedByUserId], references: [id])

  // Sending = distributing the package to the recipient list (board
  // members, committees, external auditors).
  sentAt       DateTime?
  sentByUserId String?
  sentBy       User?     @relation("MonthlyPackageSentBy", fields: [sentByUserId], references: [id])

  // Snapshots — set at publish/send time. JSON blobs because the
  // shapes evolve with the reporting service; the archive must accept
  // any shape the service returns. Never edit these in-place after
  // they're set; treat them as immutable.
  //
  // executiveOpeningSnapshotJson — cover page, executive summary,
  //   period eyebrow, identity line.
  // atAGlanceKpisJson — Chair's Dashboard KPI tiles + tones (the
  //   single most-referenced numbers in a board package; freezing
  //   them is the founder's explicit acceptance criterion).
  // packagePayloadJson — full structured payload returned by
  //   `getMonthlyReportingPackage` at publish/send time, so the
  //   archive can re-render the EXACT document the recipients saw,
  //   independent of any later ledger change.
  executiveOpeningSnapshotJson String?
  atAGlanceKpisJson            String?
  packagePayloadJson           String?

  /// SHA-256 of the at-a-glance KPI snapshot serialised JSON,
  /// captured at publish time. The report page recomputes the hash
  /// of the LIVE at-a-glance KPIs on every render and compares; a
  /// mismatch means the controller has unpublished edits and the
  /// header button switches from "Published" (informational) to
  /// "Update Publication" (clickable). Match → "Published".
  /// Null on DRAFT rows (no publish has happened yet).
  publishedPayloadHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients MonthlyPackageRecipient[]

  // Indexes
  //   - (clubId)                          → tenant-scoped listing
  //   - (clubId, reportingYear, reportingMonth) → UNIQUE per the
  //     founder's new publication model: exactly one MonthlyPackage
  //     row per reporting period per club. Re-publishing a period
  //     overwrites its row in place; the archive contains ONE row
  //     per period (never duplicates). See
  //     `src/lib/reporting/monthly-package-lifecycle.ts`
  //     `publishMonthlyPackage` for the overwrite-vs-advance-Live
  //     rule. Also doubles as the fast "is there already a package
  //     for this period?" lookup.
  //   - (clubId, status)                  → "show me everything
  //     SENT this year" archive filter
  @@unique([clubId, reportingYear, reportingMonth])
  @@index([clubId])
  @@index([clubId, status])
}

// status: PENDING | SENT | OPENED | FAILED | BOUNCED
//
// One row per recipient per package. The send action creates the rows
// in PENDING and the delivery adapter (email / portal) flips each row
// to SENT once dispatched. OPENED is updated by the open-tracking
// pixel on view. Cascade-deletes when its parent MonthlyPackage is
// removed.
model MonthlyPackageRecipient {
  id               String         @id @default(cuid())
  monthlyPackageId String
  monthlyPackage   MonthlyPackage @relation(fields: [monthlyPackageId], references: [id], onDelete: Cascade)

  // recipientUserId is OPTIONAL — committee chairs without Spectre
  // accounts get an email-only row. When the recipient does have a
  // Spectre user, we link both so portal views can join back.
  recipientUserId String?
  recipientUser   User?   @relation("MonthlyPackageRecipientUser", fields: [recipientUserId], references: [id])
  recipientEmail  String
  recipientRole   String? // "Finance Chair", "Board Member", "External Auditor", etc.

  sentAt         DateTime?
  viewedAt       DateTime?
  deliveryStatus String    @default("PENDING")

  createdAt DateTime @default(now())

  @@index([monthlyPackageId])
  @@index([recipientUserId])
  @@index([recipientEmail])
}

// -------------------------------------------------------------------------
// 6B-tris. Board & Committees roster
// -------------------------------------------------------------------------
//
// Governance-level record of a Member's tenure on the Board / a
// Committee. Person-specific and term-specific: one Member can
// accumulate multiple BoardRole rows over their career (e.g.
// Director 2024–2026, then President 2026–2028). Live access to
// Board-only surfaces (Monthly Reporting Package tile, board view,
// etc.) is derived from the row's date-aware "effective status" —
// see `effectiveBoardStatus` in
// `src/lib/governance/board-roles.ts`.
//
// status — stored intent. The runtime gate uses an effective
// status computed against today's date:
//   • status === EXPIRED                       → EXPIRED (manual revoke)
//   • termStartDate > today                    → UPCOMING
//   • termEndDate   < today                    → EXPIRED
//   • otherwise                                → ACTIVE
//
// source — provenance for the AGM module. MANUAL = controller
// keyed it in; AGM_ELECTION = future AGM/voting flow wrote it on
// successful election. Either way the row lives here.
model BoardRole {
  id       String @id @default(cuid())
  clubId   String
  club     Club   @relation(fields: [clubId], references: [id])
  memberId String
  member   Member @relation("BoardRoleMember", fields: [memberId], references: [id], onDelete: Cascade)

  /// Board title — President / VP / Treasurer / Secretary /
  /// Director / Past President / Finance Committee Chair / etc.
  /// Stored as free text rather than an enum so the founder can
  /// add titles without a migration; the admin UI offers a
  /// canonical pick-list for consistency.
  roleTitle     String
  /// Optional — populated when the role is a committee
  /// assignment (e.g. "Finance Committee", "Greens Committee")
  /// rather than a board-officer title.
  committeeName String?

  termStartDate DateTime
  termEndDate   DateTime

  /// Stored intent. Effective access uses a date-aware compute;
  /// `status` only overrides when the controller wants to end
  /// access early (set EXPIRED before termEndDate).
  status String @default("UPCOMING") // UPCOMING | ACTIVE | EXPIRED
  /// Provenance — MANUAL (controller entered) or AGM_ELECTION
  /// (future AGM module wrote it on successful election).
  source String @default("MANUAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
  @@index([clubId, memberId])
  // Date-window lookup — "who's on the board today?" hits this.
  @@index([clubId, termStartDate, termEndDate])
}

// -------------------------------------------------------------------------
// 6C. Auditor mode
// -------------------------------------------------------------------------
// status: PENDING | ACTIVE | EXPIRED | REVOKED
model AuditorAccessGrant {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  auditorName     String
  auditorEmail    String
  firmName        String?
  invitedByUserId String?
  status          String    @default("PENDING")
  scopeJson       String // JSON list of permission keys / report keys allowed
  fiscalYearId    String?
  startsAt        DateTime  @default(now())
  expiresAt       DateTime
  inviteToken     String    @unique
  acceptedAt      DateTime?
  revokedAt       DateTime?
  revokedByUserId String?
  notes           String?
  createdAt       DateTime  @default(now())

  sessions AuditorSession[]
  requests AuditRequest[]
  exports  AuditExport[]

  @@index([clubId, status])
  @@index([expiresAt])
}

model AuditorSession {
  id            String             @id @default(cuid())
  clubId        String
  club          Club               @relation(fields: [clubId], references: [id])
  grantId       String
  grant         AuditorAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  startedAt     DateTime           @default(now())
  endedAt       DateTime?
  ip            String?
  userAgent     String?
  activityCount Int                @default(0)

  @@index([clubId, grantId, startedAt])
}

// status: OPEN | RESPONDED | CLOSED
model AuditRequest {
  id                String              @id @default(cuid())
  clubId            String
  club              Club                @relation(fields: [clubId], references: [id])
  grantId           String?
  grant             AuditorAccessGrant? @relation(fields: [grantId], references: [id])
  title             String
  description       String?
  status            String              @default("OPEN")
  requestedByUserId String?
  assignedToUserId  String?
  dueDate           DateTime?
  closedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  items AuditRequestItem[]

  @@index([clubId, status])
}

// status: PENDING | PROVIDED | DECLINED
model AuditRequestItem {
  id               String       @id @default(cuid())
  clubId           String
  club             Club         @relation(fields: [clubId], references: [id])
  requestId        String
  request          AuditRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  label            String
  description      String?
  entityType       String?
  entityId         String?
  status           String       @default("PENDING")
  documentId       String?
  providedAt       DateTime?
  providedByUserId String?

  @@index([requestId])
}

model AuditExport {
  id               String             @id @default(cuid())
  clubId           String
  club             Club               @relation(fields: [clubId], references: [id])
  grantId          String
  grant            AuditorAccessGrant @relation(fields: [grantId], references: [id])
  label            String
  scope            String // e.g. "GL", "AR-AGING", "AP-INVOICES", "BUNDLE"
  documentId       String?
  storageKey       String?
  sizeBytes        Int                @default(0)
  exportedByUserId String?
  exportedAt       DateTime           @default(now())

  @@index([clubId, grantId])
}

// -------------------------------------------------------------------------
// 6D. Notifications & communications
// -------------------------------------------------------------------------
// channel: EMAIL | SMS | IN_APP | PUSH
// status:  QUEUED | SENT | FAILED | READ
model Notification {
  id                  String    @id @default(cuid())
  clubId              String
  club                Club      @relation(fields: [clubId], references: [id])
  toUserId            String?
  toMemberId          String?
  toEmail             String?
  channel             String    @default("IN_APP")
  templateKey         String?
  subject             String
  body                String
  metaJson            String?
  status              String    @default("QUEUED")
  readAt              DateTime?
  triggeredEntityType String?
  triggeredEntityId   String?
  priority            String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  createdAt           DateTime  @default(now())

  deliveries NotificationDelivery[]

  @@index([clubId, toUserId, status])
  @@index([clubId, toMemberId, status])
  @@index([clubId, status, createdAt])
}

model NotificationTemplate {
  id              String   @id @default(cuid())
  clubId          String
  club            Club     @relation(fields: [clubId], references: [id])
  key             String
  name            String
  description     String?
  channel         String   @default("EMAIL")
  subjectTemplate String
  bodyTemplate    String // handlebars-ish substitution: {{memberName}} etc.
  isSystem        Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clubId, key])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id])
  userId    String?
  memberId  String?
  topic     String // e.g. "payment_failed", "statement_available"
  channels  String // CSV: "EMAIL,IN_APP"
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([clubId, userId, memberId, topic])
  @@index([clubId, topic])
}

// status: QUEUED | SENT | FAILED | RETRIED
model NotificationDelivery {
  id                String       @id @default(cuid())
  clubId            String
  club              Club         @relation(fields: [clubId], references: [id])
  notificationId    String
  notification      Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel           String
  attemptNumber     Int          @default(1)
  status            String       @default("QUEUED")
  providerMessageId String?
  failureReason     String?
  attemptedAt       DateTime     @default(now())

  @@index([notificationId, status])
}

// Append-only durable log of every outbound communication for compliance/audit.
model CommunicationLog {
  id                  String   @id @default(cuid())
  clubId              String
  club                Club     @relation(fields: [clubId], references: [id])
  channel             String
  toAddress           String?
  toUserId            String?
  toMemberId          String?
  subject             String?
  bodySnippet         String?
  status              String // SENT | FAILED | OPENED | BOUNCED
  triggeredEntityType String?
  triggeredEntityId   String?
  notificationId      String?
  occurredAt          DateTime @default(now())

  @@index([clubId, occurredAt])
  @@index([clubId, toMemberId])
}

// status: DRAFT | SCHEDULED | RUNNING | COMPLETED | CANCELLED
model CommunicationCampaign {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  name            String
  description     String?
  templateKey     String?
  audienceJson    String? // JSON criteria (member status, category, etc.)
  status          String    @default("DRAFT")
  scheduledFor    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clubId, status])
}

// -------------------------------------------------------------------------
// 6E. Documents
// -------------------------------------------------------------------------
// status: ACTIVE | ARCHIVED | DELETED (soft)
model Document {
  id                   String                   @id @default(cuid())
  clubId               String
  club                 Club                     @relation(fields: [clubId], references: [id])
  folderId             String?
  folder               DocumentFolder?          @relation(fields: [folderId], references: [id])
  name                 String
  description          String?
  mimeType             String?
  sizeBytes            Int                      @default(0)
  storageKey           String? // pointer to object storage (S3 etc.)
  checksum             String?
  status               String                   @default("ACTIVE")
  retentionPolicyId    String?
  retentionPolicy      DocumentRetentionPolicy? @relation(fields: [retentionPolicyId], references: [id])
  retainedUntil        DateTime?
  // Cross-module linkage. Only one is typically set, but storing them on the
  // doc keeps queries cheap.
  memberId             String?
  vendorId             String?
  apInvoiceId          String?
  journalEntryId       String?
  assetId              String?
  privateEventId       String?
  payrollRunId         String?
  financingAgreementId String?
  reportingPackageId   String?
  auditRequestId       String?
  searchText           String? // OCR / extracted text placeholder
  uploadedByUserId     String?
  isSoftDeleted        Boolean                  @default(false)
  deletedAt            DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  versions  DocumentVersion[]
  access    DocumentAccess[]
  tags      DocumentTagJoin[]
  auditLogs DocumentAuditLog[]

  @@index([clubId, folderId])
  @@index([clubId, memberId])
  @@index([clubId, vendorId])
  @@index([clubId, status])
}

model DocumentFolder {
  id              String           @id @default(cuid())
  clubId          String
  club            Club             @relation(fields: [clubId], references: [id])
  parentId        String?
  parent          DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children        DocumentFolder[] @relation("FolderTree")
  name            String
  path            String // materialized "/A/B/C"
  isSystem        Boolean          @default(false)
  createdByUserId String?
  createdAt       DateTime         @default(now())

  documents Document[]

  @@unique([clubId, path])
  @@index([clubId, parentId])
}

model DocumentTag {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id])
  key       String
  label     String
  color     String?
  createdAt DateTime @default(now())

  documents DocumentTagJoin[]

  @@unique([clubId, key])
}

model DocumentTagJoin {
  documentId String
  tagId      String
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        DocumentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@index([tagId])
}

model DocumentVersion {
  id               String   @id @default(cuid())
  clubId           String
  club             Club     @relation(fields: [clubId], references: [id])
  documentId       String
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber    Int
  storageKey       String?
  sizeBytes        Int      @default(0)
  checksum         String?
  uploadedByUserId String?
  uploadedAt       DateTime @default(now())
  notes            String?

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

// kind: USER | ROLE | LINK
model DocumentAccess {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  documentId      String
  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind            String    @default("USER")
  userId          String?
  roleKey         String?
  signedUrlToken  String?   @unique
  expiresAt       DateTime?
  canDownload     Boolean   @default(true)
  grantedByUserId String?
  createdAt       DateTime  @default(now())

  @@index([documentId])
}

model DocumentRetentionPolicy {
  id            String   @id @default(cuid())
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id])
  key           String
  name          String
  retentionDays Int
  scope         String   @default("ALL") // ALL | FOLDER:<id> | TAG:<key>
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  documents Document[]

  @@unique([clubId, key])
}

model DocumentAuditLog {
  id                  String   @id @default(cuid())
  clubId              String
  club                Club     @relation(fields: [clubId], references: [id])
  documentId          String
  document            Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  action              String // VIEW | DOWNLOAD | UPLOAD | DELETE | SHARE | RESTORE
  actorUserId         String?
  actorAuditorGrantId String?
  ip                  String?
  userAgent           String?
  occurredAt          DateTime @default(now())

  @@index([documentId, occurredAt])
  @@index([clubId, occurredAt])
}

// -------------------------------------------------------------------------
// 6F. KPI engine + dashboards
// -------------------------------------------------------------------------
// kind: FINANCIAL | OPERATIONAL | MEMBERSHIP | PAYROLL | INVENTORY | EVENT | COLLECTIONS
// direction: HIGHER_BETTER | LOWER_BETTER | NEUTRAL
model KPI {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  key         String
  name        String
  description String?
  kind        String
  unit        String? // "$", "%", "count", "days"
  computeKey  String // dispatch key into compute registry
  direction   String   @default("HIGHER_BETTER")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  values     KPIValue[]
  widgets    KPIWidget[]
  thresholds KPIThreshold[]
  alerts     KPIAlert[]

  @@unique([clubId, key])
  @@index([clubId, kind])
}

model KPIValue {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  kpiId       String
  kpi         KPI      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  periodLabel String // monthly bucket, e.g. "2026-04"
  asOfDate    DateTime
  value       Decimal  @default(0)
  metaJson    String?
  computedAt  DateTime @default(now())

  @@unique([kpiId, periodLabel])
  @@index([clubId, kpiId, asOfDate])
}

model KPIDashboard {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  key         String
  name        String
  description String?
  audience    String   @default("INTERNAL") // GM | CONTROLLER | BOARD | DEPARTMENT | MEMBERSHIP | INTERNAL
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  widgets KPIWidget[]

  @@unique([clubId, key])
}

model KPIWidget {
  id          String       @id @default(cuid())
  clubId      String
  club        Club         @relation(fields: [clubId], references: [id])
  dashboardId String
  dashboard   KPIDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  kpiId       String?
  kpi         KPI?         @relation(fields: [kpiId], references: [id])
  kind        String       @default("STAT") // STAT | TREND | TABLE | NARRATIVE
  title       String
  configJson  String?
  sortOrder   Int          @default(0)
  width       String       @default("MD") // SM | MD | LG | XL

  @@index([dashboardId, sortOrder])
}

// kind: WARNING | CRITICAL
// op:   GT | LT | GTE | LTE | EQ
model KPIThreshold {
  id            String   @id @default(cuid())
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id])
  kpiId         String
  kpi           KPI      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  kind          String   @default("WARNING")
  op            String
  threshold     Decimal
  notifyRoleKey String?
  notifyUserId  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

