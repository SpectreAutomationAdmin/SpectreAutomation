// -------------------------------------------------------------------------
// White-label custom domain map. One row per externally-facing hostname.
// kind:    PRIMARY | ADMIN | MEMBER | PROSHOP | APP
//          (PRIMARY is the public-facing website; the rest are role-specific
//          subdomains the club can route separately.)
// status:  PENDING | VERIFIED | ACTIVE | FAILED
//          PENDING   — row created, DNS not yet configured
//          VERIFIED  — DNS TXT/CNAME check passed
//          ACTIVE    — receiving traffic (matched on every request)
//          FAILED    — verification failed, see failureReason
// hostname is stored lowercase and is globally unique. No two clubs may
// claim the same domain.
model ClubDomain {
  id                String    @id @default(cuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id])
  hostname          String    @unique
  kind              String    @default("PRIMARY")
  status            String    @default("PENDING")
  verificationToken String    @default("")
  verifiedAt        DateTime?
  activatedAt       DateTime?
  failureReason     String?
  isPrimary         Boolean   @default(false)
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([clubId, status])
  @@index([status])
}

// Global (no clubId) — published as a status page-ish list across all tenants.
// severity: INFO | WARNING | OUTAGE
// status:   INVESTIGATING | MITIGATED | RESOLVED
model KnownIssue {
  id          String    @id @default(cuid())
  title       String
  description String
  severity    String    @default("WARNING")
  status      String    @default("INVESTIGATING")
  workaround  String?
  publishedAt DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status, publishedAt])
}

