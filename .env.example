# Copy to .env and edit values to suit. All variables are validated at boot
# (see src/lib/env.ts) — a missing or malformed value will fail-fast.

DATABASE_URL="file:./dev.db"

# Generate a strong value with: openssl rand -hex 48
SPECTRE_SESSION_SECRET="replace-me-with-a-real-secret-of-at-least-32-characters"

SESSION_COOKIE_NAME="spectre_session"
TRUST_PROXY="false"

# ----- Email delivery -----
# Leave unset to use console mode (logs receipts to stdout, records
# DEV_LOGGED on the check). For real delivery to inboxes, set
# EMAIL_DELIVERY_MODE=smtp + the SMTP_* values for your provider.
#
# Sender-domain verification: ALL real providers (Postmark, SendGrid,
# SES, Gmail relay) require SMTP_FROM's domain to be verified with
# them before they'll deliver. Unverified sends fail or land in spam.
#
# See docs/email-testing.md for full provider walkthroughs.

# --- Local sink (Maildev / Mailhog) — for dev only, NEVER reaches real inboxes
# EMAIL_DELIVERY_MODE=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=receipts@yourclub.com
# SMTP_SECURE=false
# (SMTP_USER / SMTP_PASS left unset — Maildev accepts anonymous)

# --- Postmark SMTP
# EMAIL_DELIVERY_MODE=smtp
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=<server-token>    # same value for user AND pass
# SMTP_PASS=<server-token>
# SMTP_FROM="Silver Springs Receipts <receipts@yourverifieddomain.com>"
# SMTP_SECURE=false           # STARTTLS on 587

# --- SendGrid SMTP
# EMAIL_DELIVERY_MODE=smtp
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey            # literal string "apikey"
# SMTP_PASS=SG.xxxx           # the API key value
# SMTP_FROM="Silver Springs Receipts <receipts@yourverifieddomain.com>"
# SMTP_SECURE=false

# --- Amazon SES SMTP (per-region endpoint)
# EMAIL_DELIVERY_MODE=smtp
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=<SES-SMTP-username>     # NOT your IAM access key
# SMTP_PASS=<SES-SMTP-password>     # generated from "Create SMTP credentials"
# SMTP_FROM=receipts@yourverifieddomain.com
# SMTP_SECURE=false

# --- Gmail SMTP (development only — Google requires an app password,
#                 daily send limits make this unsuitable for prod)
# EMAIL_DELIVERY_MODE=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=<16-char app password>   # https://myaccount.google.com/apppasswords
# SMTP_FROM=you@gmail.com            # must match the Gmail account
# SMTP_SECURE=false

# --- Microsoft 365 / Outlook via Microsoft Graph (RECOMMENDED for production)
# Sends receipts from the club's own Microsoft 365 mailbox over OAuth
# (client credentials). The club's M365 admin creates an App Registration
# with the Microsoft Graph "Mail.Send" application permission, grants
# admin consent, and SHOULD scope it to one mailbox with an
# Application Access Policy. No Outlook user password is stored.
#
# See docs/email-microsoft365.md for the full walkthrough.
#
# EMAIL_DELIVERY_MODE=microsoft365
# MICROSOFT_TENANT_ID=<your-azure-ad-directory-tenant-id>
# MICROSOFT_CLIENT_ID=<app-registration-application-id>
# MICROSOFT_CLIENT_SECRET=<client-secret-value-from-azure>
# MICROSOFT_FROM_MAILBOX=receipts@silverspringsgolfclub.com
