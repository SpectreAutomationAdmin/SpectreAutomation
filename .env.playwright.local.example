# Sprint 3 · Post-16H Phase 3.2 (2026-08-05) — Playwright staging
# credentials template. COPY this file to `.env.playwright.local`
# (which is git-ignored) and fill in the founder's staging credentials.
#
# NEVER commit a populated version of this file. NEVER paste real
# credentials into any file under /src, /tests, or any committed
# configuration.
#
# Consumed by tests/e2e/_lib/staging-auth.ts.

# Founder's staging email address (login form → input[name="email"]).
SPECTRE_STAGING_EMAIL=founder@example.com

# Founder's staging password (login form → input[name="password"]).
# Rotate on staging + update here whenever it changes; never anywhere else.
SPECTRE_STAGING_PASSWORD=replace-me-with-the-real-staging-password

# Optional overrides — defaults are usually correct.
# SPECTRE_STAGING_BASE_URL=https://staging.spectreautomation.com
# SPECTRE_STAGING_LOGIN_PATH=/login
